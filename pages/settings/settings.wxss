/* 设置/登录页面样式 */

.container {
  padding-bottom: 40rpx;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 20rpx;
}

.avatar {
  font-size: 80rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: bold;
}

.user-id {
  font-size: 24rpx;
  color: var(--text-hint);
}

.user-semester {
  font-size: 22rpx;
  color: var(--primary);
  margin-top: 4rpx;
}

/* 操作列表 */
.action-list {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.action-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.action-item:last-child {
  border-bottom: none;
}

.action-item .arrow {
  color: var(--text-hint);
  font-size: 32rpx;
}

/* 校历设置卡片 */
.setting-card {
  margin: 20rpx;
  padding: 24rpx;
}

.setting-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.setting-value {
  font-size: 26rpx;
  color: var(--primary);
  padding: 16rpx 0;
}

.setting-hint {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

/* 退出登录 */
.logout-area {
  padding: 40rpx 20rpx;
}

.logout-area button {
  font-size: 28rpx;
}

/* 登录表单 */
.login-card {
  margin: 40rpx 20rpx 20rpx;
  padding: 40rpx 32rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 24rpx;
  color: var(--primary);
}

/* 登录模式切换 */
.mode-tabs {
  display: flex;
  background: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.mode-tab.active {
  background: var(--primary);
  color: #fff;
  font-weight: bold;
}

.mode-desc {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #FAFAFA;
}

.login-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 104rpx;          /* 加高: 长文案"登录(自动识别验证码)"显示完整 */
  font-size: 30rpx;
  line-height: 104rpx;     /* 行高与高度一致, 文字垂直居中不裁切 */
  border-radius: 14rpx;
  padding: 0;
}

.remember-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.remember-label {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 密码输入行: 输入框 + 明文切换按钮 */
.pwd-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pwd-input {
  flex: 1;
}

.pwd-toggle {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  border-radius: 12rpx;
  background: #F2F0FA;
}

.pwd-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A87A8;
  line-height: 1.5;
}

.login-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 24rpx;
}

/* ============================================================
   V2 视觉升级 — 设置页
   ============================================================ */
/* 用户卡渐变头部 */
.user-card {
  background: linear-gradient(135deg, #7C6BE8 0%, #8B79EC 100%);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(26, 82, 118, 0.30);
}
.user-card .user-name { color: #fff; }
.user-card .user-id { color: rgba(255, 255, 255, 0.85); }
.user-card .user-semester { color: rgba(255, 255, 255, 0.95); }

/* 操作项按压反馈 */
.action-item {
  border-radius: 12rpx;
  margin: 0 12rpx;
}
.action-item:active { background: #EFEBFC; }

/* 登录模式胶囊 */
.mode-tabs { border-radius: 36rpx; }
.mode-tab { border-radius: 28rpx; }
.mode-tab.active {
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(26, 82, 118, 0.25);
}

/* 校历设置卡装饰 */
.setting-card { border-left: 8rpx solid #8B79EC; }


/* ============================================================
   V3 视觉升级 — 设置页头像与细节
   ============================================================ */
.user-card .avatar {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.20);
  border-radius: 50%;
  font-size: 60rpx;
}
.setting-card .setting-value {
  background: #EFEBFC;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}
.login-card {
  border-radius: 24rpx;
  box-shadow: 0 10rpx 32rpx rgba(26, 82, 118, 0.12);
}

/* ============================================================
   V4 简约风格 — 设置页
   ============================================================ */
.user-card {
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(31, 25, 72, 0.05);
}
.user-card .user-name { color: var(--primary-dark); }
.user-card .user-id { color: var(--text-secondary); }
.user-card .user-semester { color: var(--primary); }
.user-card .avatar {
  background: #EFEBFC;
  color: var(--primary);
}
.mode-tabs { background: #eaf1f8; }
.mode-tab.active { box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.06); }
.setting-card { border-left: 6rpx solid #8B79EC; }


/* ============================================================
   V6 桌面端同款 — 设置页
   ============================================================ */
/* 用户卡 → 桌面信息卡: 白底 + 主色头像 */
.user-card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
.user-card .user-name { color: #33304F; }
.user-card .user-id { color: #8A87A8; }
.user-card .user-semester { color: #7C6BE8; }
.user-card .avatar {
  background: #EFEBFC;
  color: #7C6BE8;
}
/* 操作项 → 桌面卡片行 */
.action-item { border-radius: 12rpx; }
/* 登录模式 → 桌面 .gpa-mode-bar 同款 */
.mode-tabs {
  display: flex;
  background: none;
  padding: 0;
  gap: 12rpx;
}
.mode-tab {
  background: #fff;
  border: 2rpx solid #E3DFF5;
  color: #33304F;
  border-radius: 16rpx;
}
.mode-tab.active {
  background: #8B79EC;
  border-color: #8B79EC;
  color: #fff;
  box-shadow: none;
}

