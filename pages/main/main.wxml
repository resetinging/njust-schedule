<!-- 主页面: swiper 承载 5 个 Tab 视图(仅 tabBar 切页);
     横滑手势在课表页用于切换周次, 不再翻页 -->
<view class="main-page {{fontClass}}">

  <!-- 顶部公告条: 有新公告(updated 未读)时展示, 查看后隐藏 -->
  <view class="ann-bar" wx:if="{{ann.visible}}" bindtap="onAnnTap">
    <view class="ann-icon"><icon name="megaphone" size="30" color="#2563EB" /></view>
    <text class="ann-tag">公告</text>
    <text class="ann-text">{{ann.text}}</text>
    <text class="ann-more" wx:if="{{ann.long}}">查看 ›</text>
    <text class="ann-close" catchtap="onAnnClose">✕</text>
  </view>

  <!-- 内容区: 已无 swiper, 横滑不再翻页(翻页只走底部 tabBar);
       横滑手势在课表页用于切换周次; 已访问过的 Tab 保留挂载,
       用内置 view 包装后 hidden 隐藏(自定义组件直接 hidden 不生效),
       从而保留各自的滚动位置与周次状态 -->
  <view class="main-body"
        style="height: {{swiperHeight}}px"
        bindtouchstart="onSwipeTouchStart"
        bindtouchend="onSwipeTouchEnd">
    <!-- ① 功能页(一级): 考试/评教/成绩 + 空教室/校历 -->
    <view class="tab-wrap" hidden="{{!(current === 0 && !sub)}}">
      <view class="feat-page">
        <view class="feat-card">
          <view class="feat-row" data-sub="exams" bindtap="onOpenFeature">
            <view class="feat-ico"><icon name="doc" size="34" color="#2563EB" /></view>
            <view class="feat-main">
              <text class="feat-name">考试安排</text>
              <text class="feat-desc">考试时间、考场与倒计时</text>
            </view>
            <text class="feat-arrow">›</text>
          </view>
          <view class="feat-row" data-sub="eval" bindtap="onOpenFeature">
            <view class="feat-ico"><icon name="clipboard" size="34" color="#2563EB" /></view>
            <view class="feat-main">
              <text class="feat-name">教学评价</text>
              <text class="feat-desc">批量评教与进度跟踪</text>
            </view>
            <text class="feat-arrow">›</text>
          </view>
          <view class="feat-row" data-sub="grades" bindtap="onOpenFeature">
            <view class="feat-ico"><icon name="chart" size="34" color="#2563EB" /></view>
            <view class="feat-main">
              <text class="feat-name">成绩查询</text>
              <text class="feat-desc">绩点、分数与四六级</text>
            </view>
            <text class="feat-arrow">›</text>
          </view>
        </view>

        <view class="feat-card">
          <view class="feat-row" data-url="/pages/freeclass/freeclass" bindtap="onOpenNavPage">
            <view class="feat-ico"><icon name="building" size="34" color="#2563EB" /></view>
            <view class="feat-main">
              <text class="feat-name">空教室查询</text>
              <text class="feat-desc">按教学楼与时段找空闲教室</text>
            </view>
            <text class="feat-arrow">›</text>
          </view>
          <view class="feat-row" data-url="/pages/gallery/gallery" bindtap="onOpenNavPage">
            <view class="feat-ico"><icon name="image" size="34" color="#2563EB" /></view>
            <view class="feat-main">
              <text class="feat-name">校历 &amp; 照片墙</text>
              <text class="feat-desc">学期校历与校园照片</text>
            </view>
            <text class="feat-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ② 功能页(二级): 考试 / 评教 / 成绩, 顶部带返回 -->
    <view class="tab-wrap" hidden="{{!(current === 0 && sub === 'exams')}}">
      <view class="sub-back" bindtap="onBackFeature"><text class="sub-back-ico">‹</text>返回功能</view>
      <exams-view wx:if="{{visited[1]}}" id="tabview1" />
    </view>
    <view class="tab-wrap" hidden="{{!(current === 0 && sub === 'eval')}}">
      <view class="sub-back" bindtap="onBackFeature"><text class="sub-back-ico">‹</text>返回功能</view>
      <eval-view wx:if="{{visited[2]}}" id="tabview2" />
    </view>
    <view class="tab-wrap" hidden="{{!(current === 0 && sub === 'grades')}}">
      <view class="sub-back" bindtap="onBackFeature"><text class="sub-back-ico">‹</text>返回功能</view>
      <grades-view wx:if="{{visited[3]}}" id="tabview3" />
    </view>

    <!-- ③ 课表 -->
    <view class="tab-wrap" hidden="{{current !== 1}}">
      <schedule-view wx:if="{{visited[0]}}" id="tabview0" />
    </view>

    <!-- ④ 我的 -->
    <view class="tab-wrap" hidden="{{current !== 2}}">
      <settings-view wx:if="{{visited[4]}}" id="tabview4" />
    </view>
  </view>

  <!-- 自定义 tabBar(手动引用: main 不在 tabBar list 中, 需自渲染) -->
  <custom-tab-bar id="tabbar" />
</view>
