<!-- 主页面: swiper 承载 5 个 Tab 视图(仅 tabBar 切页);
     横滑手势在课表页用于切换周次, 不再翻页 -->
<view class="main-page {{fontClass}}">

  <!-- 顶部公告条: 有新公告(updated 未读)时展示, 查看后隐藏 -->
  <view class="ann-bar tap" wx:if="{{ann.visible}}" bindtap="onAnnTap">
    <view class="ann-icon"><icon name="megaphone" size="30" color="#2563EB" /></view>
    <text class="ann-tag">公告</text>
    <text class="ann-text">{{ann.text}}</text>
    <view class="ann-more" wx:if="{{ann.long}}"><text>查看</text><view class="ann-next"><icon name="next" size="22" color="#64748B" /></view></view>
    <text class="ann-close tap" catchtap="onAnnClose">×</text>
  </view>

  <!-- 内容区: 已无 swiper, 横滑不再翻页(翻页只走底部 tabBar);
       横滑手势在课表页用于切换周次; 已访问过的 Tab 保留挂载,
       用内置 view 包装后 hidden 隐藏(自定义组件直接 hidden 不生效),
       从而保留各自的滚动位置与周次状态 -->
  <view class="main-body"
        style="height: {{swiperHeight}}px"
        bindtouchstart="onSwipeTouchStart"
        bindtouchend="onSwipeTouchEnd">
    <!-- ① 功能页(一级): 考试/评教/成绩 + 空教室/校历 -->
    <view class="tab-wrap" hidden="{{current !== 0}}">
      <view class="feat-page">
        <view class="feat-section">
          <text>课业</text>
        </view>
        <view class="feat-grid">
          <view class="feat-tile tile-exam tap" data-sub="exams" bindtap="onOpenFeature">
            <view class="tile-top">
              <view class="tile-ico"><icon name="doc" size="36" color="#2563EB" /></view>
              <view class="tile-arrow"><icon name="next" size="24" color="#64748B" /></view>
            </view>
            <text class="tile-name">考试安排</text>
          </view>
          <view class="feat-tile tile-eval tap" data-sub="eval" bindtap="onOpenFeature">
            <view class="tile-top">
              <view class="tile-ico"><icon name="clipboard" size="36" color="#2563EB" /></view>
              <view class="tile-arrow"><icon name="next" size="24" color="#64748B" /></view>
            </view>
            <text class="tile-name">教学评价</text>
          </view>
          <view class="feat-tile tile-grade tap" data-sub="grades" bindtap="onOpenFeature">
            <view class="tile-top">
              <view class="tile-ico"><icon name="chart" size="36" color="#2563EB" /></view>
              <view class="tile-arrow"><icon name="next" size="24" color="#64748B" /></view>
            </view>
            <text class="tile-name">成绩查询</text>
          </view>
          <view class="feat-tile tile-credit tap" data-sub="credit" bindtap="onOpenFeature">
            <view class="tile-top">
              <view class="tile-ico"><icon name="award" size="36" color="#2563EB" /></view>
              <view class="tile-arrow"><icon name="next" size="24" color="#64748B" /></view>
            </view>
            <text class="tile-name">学分进度</text>
          </view>
        </view>

        <view class="feat-section">
          <text>校园工具</text>
        </view>
        <view class="feat-tools">
          <view class="feat-tool-tile tool-room tap" data-page="freeclass" bindtap="onOpenNavPage">
            <view class="tile-top">
              <view class="tile-ico"><icon name="building" size="36" color="#2563EB" /></view>
              <view class="tile-arrow"><icon name="next" size="24" color="#64748B" /></view>
            </view>
            <text class="tile-name">空教室查询</text>
          </view>
          <view class="feat-tool-tile tool-gallery tap" data-page="gallery" bindtap="onOpenNavPage">
            <view class="tile-top">
              <view class="tile-ico"><icon name="image" size="36" color="#2563EB" /></view>
              <view class="tile-arrow"><icon name="next" size="24" color="#64748B" /></view>
            </view>
            <text class="tile-name">校历与照片墙</text>
          </view>
          <view class="feat-tool-tile tool-audit tap" data-page="audit" bindtap="onOpenNavPage">
            <view class="tile-top">
              <view class="tile-ico"><icon name="search" size="36" color="#2563EB" /></view>
              <view class="tile-arrow"><icon name="next" size="24" color="#64748B" /></view>
            </view>
            <text class="tile-name">蹭课查询</text>
          </view>
        </view>

        <view id="slot-feature-bottom" class="analytics-slot-marker"></view>

      </view>
    </view>

    <!-- ③ 课表 -->
    <view class="tab-wrap" hidden="{{current !== 1}}">
      <schedule-view wx:if="{{visited[0]}}" id="tabview0"
                     bind:auditfavorites="onOpenAuditFavorites" />
    </view>

    <!-- ④ 我的 -->
    <view class="tab-wrap" hidden="{{current !== 2}}">
      <settings-view wx:if="{{visited[4]}}" id="tabview4" />
    </view>
  </view>

  <!-- 自定义 tabBar(手动引用: main 不在 tabBar list 中, 需自渲染) -->
  <custom-tab-bar id="tabbar" />

  <!-- 空教室 / 校园工具: 页面内底部上滑假页, 避免 navigateTo 原生左滑与自定义动画叠加 -->
  <page-container
    show="{{toolVisible}}"
    position="bottom"
    overlay="{{false}}"
    round="{{false}}"
    duration="{{320}}"
    z-index="{{1200}}"
    close-on-slide-down="{{false}}"
    custom-style="height: 100vh; background: transparent;"
    bind:beforeleave="onToolBeforeLeave"
    bind:afterleave="onToolAfterLeave">
    <freeclass-view wx:if="{{toolPage === 'freeclass'}}"
                    embedded="{{true}}"
                    bind:close="onToolClose"
                    bind:login="onToolLogin" />
    <gallery-view wx:elif="{{toolPage === 'gallery'}}"
                  embedded="{{true}}"
                  bind:close="onToolClose" />
    <view wx:elif="{{toolPage === 'exams' || toolPage === 'eval' || toolPage === 'grades' || toolPage === 'credit' || toolPage === 'audit'}}"
          class="subject-shell">
      <view class="sub-back tap" aria-label="返回功能" bindtap="onToolClose">
        <view class="icon-back"><icon name="back" size="28" color="#64748B" /></view>
        <text>返回</text>
      </view>
      <exams-view wx:if="{{toolPage === 'exams'}}" id="toolExams" />
      <eval-view wx:elif="{{toolPage === 'eval'}}" id="toolEval" />
      <grades-view wx:elif="{{toolPage === 'grades'}}" id="toolGrades" />
      <credit-view wx:elif="{{toolPage === 'credit'}}" id="toolCredit" />
      <audit-course-view wx:elif="{{toolPage === 'audit'}}" id="toolAudit"
                         bind:favoritechange="onAuditFavoriteChange" />
    </view>
  </page-container>
</view>
