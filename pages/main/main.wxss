/* 主页面 */
.main-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-page);
}
.main-body {
  width: 100%;
  overflow: hidden;
  /* 作为弹性列容器: 让每个 Tab 视图正好铺满"可用高度"，
     不再依赖 100%/100vh 这类百分比链, 避免被裁掉一半 */
  display: flex;
  flex-direction: column;
}

.tab-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* 组件/页面在包裹层里撑满剩余高度(二级视图顶部有返回条) */
.tab-wrap > .sub-back { flex-shrink: 0; }
.tab-wrap > .sub-shell {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
.tab-wrap > schedule-view,
.tab-wrap > exams-view,
.tab-wrap > eval-view,
.tab-wrap > grades-view,
.tab-wrap > settings-view,
.tab-wrap > .feat-page {
  flex: 1;
  min-height: 0;
}

.sub-shell {
  animation: subPanelIn var(--motion-slow) var(--ease-spring) both;
  transform-origin: 50% 100%;
}

.sub-shell.is-closing {
  pointer-events: none;
  animation: subPanelOut 300ms cubic-bezier(.4, 0, .2, 1) both;
}

.sub-shell > .sub-back { flex-shrink: 0; }

@keyframes subPanelIn {
  from { opacity: 0; transform: translateY(42rpx) scale(.975); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes subPanelOut {
  from { opacity: 1; transform: translateY(0) scale(1); }
  to   { opacity: 0; transform: translateY(46rpx) scale(.975); }
}

/* 课业假页: 返回条 + 组件填满剩余高度 */
.subject-shell {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-page);
  box-sizing: border-box;
}

.subject-shell > .sub-back { flex-shrink: 0; }

.subject-shell > exams-view,
.subject-shell > eval-view,
.subject-shell > grades-view,
.subject-shell > credit-view,
.subject-shell > audit-course-view {
  flex: 1;
  min-height: 0;
}

.subject-shell > exams-view .container,
.subject-shell > eval-view .container,
.subject-shell > grades-view .container,
.subject-shell > credit-view .container,
.subject-shell > audit-course-view .container {
  height: 100%;
  min-height: 0;
}

/* ============================================================
   功能页(底栏第 1 项): 二级入口列表
   ============================================================ */
.feat-page {
  height: 100%;
  padding: 12rpx 20rpx 44rpx;
  box-sizing: border-box;
  overflow-y: auto;
  background: var(--bg-page);
}

.feat-section {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 14rpx 4rpx 10rpx;
  color: var(--text-muted);
  font-size: 23rpx;
  font-weight: 700;
}

.feat-grid,
.feat-tools {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.feat-tile,
.feat-tool-tile {
  position: relative;
  min-height: 156rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, .86);
  border-radius: 22rpx;
  background: var(--bg-card);
  box-shadow: 0 8rpx 26rpx rgba(15, 23, 42, .055);
  box-sizing: border-box;
  animation: tileIn 440ms var(--ease-spring) backwards;
}

.feat-tile:nth-child(2) { animation-delay: 35ms; }
.feat-tile:nth-child(3) { animation-delay: 70ms; }
.feat-tile:nth-child(4) { animation-delay: 105ms; }
.feat-tool-tile:nth-child(2) { animation-delay: 35ms; }

.tile-exam { background: linear-gradient(145deg, #F4F8FF 0%, #FFFFFF 82%); }
.tile-eval { background: linear-gradient(145deg, #F0FAF6 0%, #FFFFFF 82%); }
.tile-grade { background: linear-gradient(145deg, #FFF8EC 0%, #FFFFFF 82%); }
.tile-credit { background: linear-gradient(145deg, #F7F3FF 0%, #FFFFFF 82%); }
.tool-room { background: linear-gradient(145deg, #F2F8FF 0%, #FFFFFF 82%); }
.tool-gallery { background: linear-gradient(145deg, #F1F8F5 0%, #FFFFFF 82%); }
.tool-audit { background: linear-gradient(145deg, #F6F3FF 0%, #FFFFFF 82%); }

.tile-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.tile-ico {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, .82);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, .9);
}

.tile-arrow {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tile-name {
  color: var(--text-primary);
  font-size: 29rpx;
  font-weight: 750;
}

@keyframes tileIn {
  from { opacity: 0; transform: translateY(22rpx) scale(.965); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

.feat-card {
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.feat-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 96rpx;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--line-soft);
  transition: background-color var(--motion-fast) var(--ease-standard),
              transform var(--motion-base) var(--ease-spring);
}

.feat-row:last-child { border-bottom: none; }
.feat-row:active {
  background: var(--bg-hover);
  transform: scale(.985);
}

.feat-ico {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: var(--primary-soft);
}

.feat-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.feat-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.feat-arrow {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-back {
  display: inline-flex;
}

/* 二级视图顶部返回条 */
.sub-back {
  display: flex;
  align-items: center;
  align-self: flex-start;
  gap: 8rpx;
  margin: 12rpx 20rpx 6rpx;
  padding: 10rpx 18rpx 10rpx 12rpx;
  font-size: 24rpx;
  font-weight: 650;
  color: var(--primary);
  background: rgba(255, 255, 255, .82);
  border: 1rpx solid rgba(255, 255, 255, .86);
  border-radius: 16rpx;
  -webkit-backdrop-filter: blur(22rpx) saturate(165%);
  backdrop-filter: blur(22rpx) saturate(165%);
  box-shadow: var(--shadow-card);
  transition: transform var(--motion-base) var(--ease-spring),
              background-color var(--motion-fast) var(--ease-standard);
}

.sub-back:active {
  background: var(--bg-hover);
  transform: scale(.985);
}

.sub-back-ico { font-size: 34rpx; }

/* ============================================================
顶部公告条 — 新公告横幅(查看后隐藏, 高度由 JS 计入 swiperHeight)
============================================================ */
.ann-bar {
  font-family: var(--font-ann);
  display: flex;
  align-items: center;
  min-height: 84rpx;
  padding: 0 28rpx;
  background: rgba(29, 78, 216, .90);
  -webkit-backdrop-filter: blur(24rpx) saturate(170%);
  backdrop-filter: blur(24rpx) saturate(170%);
  color: var(--bg-card);
  font-size: 26rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(255, 255, 255, .18);
}

.ann-bar .ann-icon {
  margin-right: 14rpx;
  font-size: 28rpx;
}

.ann-bar .ann-tag {
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.24);
  font-size: 22rpx;
  line-height: 1.6;
}

.ann-bar .ann-text {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 文本被截断时才出现的"可点击查看"提示 */
.ann-bar .ann-more {
  flex-shrink: 0;
  margin-left: 12rpx;
  display: inline-flex;
  align-items: center;
  gap: 2rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.ann-next {
  display: inline-flex;
}

.ann-bar .ann-close {
  flex-shrink: 0;
  margin-left: 12rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 34rpx;
  line-height: 1;
  text-align: center;
}
