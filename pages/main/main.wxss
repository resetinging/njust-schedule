/* ==========================================================================
   主页面外壳（Island）：三个一级视图（功能 / 课表 / 我的）+ 唯一的二级页运动管理者
   - 入场动画只由「一层」负责：主 Tab 切换 200ms Q 弹，子组件不再叠一次整页进场
   - 功能页保留 9 个入口（研究生隐藏教学评价时 8 个），课业 2 列 / 校园工具 2 列，
     全部等宽等高岛卡，末行单卡保持单列宽度、右侧自然留空（不跨列）
   ========================================================================== */

/* 稳定 flex 高度链：page → main-page(100vh, flex column) → main-body(flex:1) → tab-wrap(flex:1)
   → 子页面 scroll-view 填满。公告条显隐、窗口尺寸、底部安全区都由 flex 自动收敛，
   不再用 JS 计算的固定 px 高度（那会在公告切换/旋转/分屏时截断内容）。 */
.main-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  color: var(--text-primary);
  background: var(--bg-page);
}

/* TabBar 包裹层：不参与文档流，只负责按弹层状态隐藏/显示 */
.tabbar-slot {
  position: static;
  height: 0;
  overflow: visible;
}

.main-body {
  display: flex;
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
  overflow: hidden;
  flex-direction: column;
}

.tab-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* 组件宿主只负责「填满父级」：课表/我的各自内部 scroll-view 滚动，
   宿主不再加 overflow / padding / 固定高度（否则会二次滚动并压缩可视区域）。
   功能页不是组件，自己作为滚动容器承担滚动与底部留白。 */
.tab-wrap > schedule-view,
.tab-wrap > settings-view,
.tab-wrap > .feat-page {
  flex: 1;
  min-height: 0;
}

/* 主 Tab 切换：200ms 轻 Q 弹（中途轻微超调到 -2rpx / 1.002 再回落），
   只由本层负责，子组件不再播整页进场，避免双层动画 */
.tab-wrap.is-active > schedule-view,
.tab-wrap.is-active > settings-view {
  /* 不用 both/fill 残留 transform：宿主一旦带 transform 会形成 stacking context，
   弹层内部再高的 z-index 也会被浮动底栏(z-index:999)盖住 */
  animation: tabPageIn var(--motion-base) var(--ease-bounce) backwards;
}

@keyframes tabPageIn {
  0%   { opacity: 0; transform: translateY(8rpx) scale(1); }
  70%  { opacity: 1; transform: translateY(-2rpx) scale(1.002); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* ==========================================================================
   功能页
   ========================================================================== */

.feat-page {
  height: 100%;
  overflow-y: auto;
  /* 功能页自己滚动：底部留白落在可滚内容尾部，不缩小可视区域 */
  padding: 24rpx var(--space-page) calc(140rpx + env(safe-area-inset-bottom));
  background: var(--bg-page);
  box-sizing: border-box;
}

/* 单层入场：页头作为该页唯一的进场元素 */
.feat-page.is-active .feature-header {
  animation: featureHeaderIn var(--motion-base) var(--ease-out) both;
}

@keyframes featureHeaderIn {
  from { opacity: 0; transform: translateY(-6rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.feature-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  margin-bottom: var(--space-md);
}

.feature-title-wrap {
  min-width: 0;
}

.feature-title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.feature-title {
  color: var(--text-primary);
  font-size: var(--fs-page-title);
  font-weight: 700;
  line-height: 1.2;
}

.feature-partner-tag {
  padding: 3rpx 10rpx;
  border-radius: var(--radius-xs);
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: var(--fs-cap);
  font-weight: 700;
  line-height: 1.4;
}

/* 通知入口：88rpx 热区，方角轻量按钮，不再是装饰圆 */
.feature-notify {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border: none;
  border-radius: var(--radius-control);
  background: transparent;
}

.feature-notify:active {
  background: var(--bg-hover);
}

.feature-notify-dot {
  position: absolute;
  top: 20rpx;
  right: 22rpx;
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid var(--bg-page);
  border-radius: var(--radius-pill);
  background: var(--danger);
}

.feature-section-head {
  display: flex;
  align-items: baseline;
  min-height: 40rpx;
  margin: 0 0 var(--space-sm);
}

.feature-section-head-tools {
  margin-top: var(--space-xl);
}

.feature-section-title {
  color: var(--text-primary);
  font-size: var(--fs-section);
  font-weight: 700;
  line-height: 1.4;
}

/* 两列等宽网格：所有入口保持 2 列排布，末行单卡保持单列宽度、右侧自然留空（不跨列） */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-md);
}

.feature-ad-slot {
  width: 100%;
  margin-top: var(--space-md);
}

.feature-tile {
  position: relative;
  display: flex;
  min-height: 152rpx;
  flex-direction: column;
  justify-content: space-between;
  gap: var(--space-md);
  padding: 24rpx;
  overflow: hidden;
  border: none;
  border-radius: var(--radius-island);
  background: var(--bg-card);
  box-shadow: var(--shadow-island);
  /* 按压缩放由基座 .tap 提供(.98)，这里只把释放过程改成 Q 弹缓动：有轻微回弹但不改布局 */
  transition: transform var(--motion-base) var(--ease-bounce),
              background-color var(--motion-fast) var(--ease-standard),
              opacity var(--motion-fast) var(--ease-standard);
}

.feature-tile-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

/* 统一图标容器：64rpx 方形容器 + 12rpx 圆角，四种色调只改底色 */
.feature-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-control);
  background: var(--bg-sunken);
}

.feature-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  opacity: .7;
}

.feature-tile-name {
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.35;
}

.tone-brand { color: var(--primary); }
.tone-success { color: var(--success); }
.tone-signal { color: var(--signal); }
.tone-violet { color: var(--violet); }
.tone-brand .feature-icon { background: var(--primary-soft); }
.tone-success .feature-icon { background: var(--success-soft); }
.tone-signal .feature-icon { background: var(--signal-soft); }
.tone-violet .feature-icon { background: var(--violet-soft); }

/* 按压：缩放由基座 .tap 统一提供（.98），这里只加颜色反馈，不做旋转；
   回弹由上面的 Q 弹 transition 在释放时体现 */
.feature-tile:active {
  background: var(--bg-hover);
}

.feature-tile:active .feature-icon {
  background: var(--bg-sunken);
}

.feature-tile:active .feature-arrow {
  opacity: .4;
}

/* ==========================================================================
   顶部公告条（中性面 + 细边线；公告入口仍以图标呈现）
   ========================================================================== */

.ann-bar {
  display: flex;
  flex: none;
  align-items: center;
  min-height: 84rpx;
  margin: 12rpx var(--space-page) 0;
  padding: 0 20rpx;
  gap: var(--space-xs);
  box-sizing: border-box;
  color: var(--text-primary);
  background: var(--bg-card);
  border: none;
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-island);
  font-family: var(--font-body);
  font-size: var(--fs-sub);
}

.ann-icon,
.ann-next {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.ann-tag {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-pill);
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: var(--fs-cap);
  line-height: 1.5;
}

.ann-text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--text-secondary);
}

.ann-more {
  display: flex;
  align-items: center;
  flex: none;
  gap: 2rpx;
  margin-left: var(--space-xs);
  color: var(--primary);
  font-size: var(--fs-cap);
}

.ann-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 88rpx;
  flex: none;
  margin-left: 0;
  border-radius: var(--radius-control);
  color: var(--text-muted);
  font-size: 30rpx;
  line-height: 1;
}

.ann-close:active {
  background: var(--bg-hover);
}

/* ==========================================================================
   二级页：由 tool-layer 独占入场/退出，子页面不再叠加同方向整页动画
   ========================================================================== */

.subject-shell {
  display: flex;
  width: 100%;
  height: 100vh;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--bg-page);
}

.tool-layer {
  position: fixed;
  z-index: 1200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  background: var(--bg-page);
  opacity: 0;
  /* 回到原 Q 弹手感：自下而上 44rpx 起步，280ms 轻微回弹；仍由本层独占 */
  transform: translateY(44rpx);
  visibility: hidden;
  pointer-events: none;
  transition: opacity var(--motion-layer) var(--ease-bounce),
              transform var(--motion-layer) var(--ease-bounce),
              visibility 0s linear var(--motion-layer);
}

.tool-layer.is-visible {
  opacity: 1;
  transform: translateY(0);
  visibility: visible;
  pointer-events: auto;
  transition-delay: 0s;
}

/* 关闭方向与打开一致：同样的 44rpx 位移与透明度，只是反向 */
.tool-layer.is-closing {
  opacity: 0;
  transform: translateY(44rpx);
  visibility: visible;
  pointer-events: none;
}

.subject-shell > exams-view,
.subject-shell > eval-view,
.subject-shell > grades-view,
.subject-shell > credit-view,
.subject-shell > audit-course-view {
  min-height: 0;
  flex: 1;
}

.subject-shell > exams-view .container,
.subject-shell > eval-view .container,
.subject-shell > grades-view .container,
.subject-shell > credit-view .container,
.subject-shell > audit-course-view .container {
  height: 100%;
  min-height: 0;
}

.tool-layer > campus-services-view {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}

/* 返回：88rpx 热区，中性底 + 细边线，无投影 */
.sub-back {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  min-height: 88rpx;
  gap: var(--space-xs);
  margin: 0 var(--space-page);
  padding: 0 var(--space-md) 0 var(--space-xs);
  border: none;
  border-radius: var(--radius-pill);
  color: var(--text-secondary);
  background: var(--bg-card);
  box-shadow: var(--shadow-island);
  font-size: var(--fs-sub);
  font-weight: 600;
}

.sub-back:active {
  color: var(--primary);
  background: var(--bg-hover);
}

.icon-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
}

/* ==========================================================================
   窄屏适配：320/360 宽度只压缩间距，不缩放字体、不改布局结构
   ========================================================================== */

@media (max-width: 360px) {
  .feat-page {
    padding-left: var(--space-md);
    padding-right: var(--space-md);
  }

  .feature-tile {
    min-height: 136rpx;
    padding: var(--space-md);
  }
}

@media (prefers-reduced-motion: reduce) {
  .feat-page.is-active .feature-header,
  .tab-wrap.is-active > schedule-view,
  .tab-wrap.is-active > settings-view {
    animation: none;
  }

  .tool-layer,
  .tool-layer.is-visible,
  .tool-layer.is-closing,
  .feature-tile {
    transition-duration: .01ms;
  }
}
