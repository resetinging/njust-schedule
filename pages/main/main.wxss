/* 主页面 */
.main-page {
  height: 100vh;
  background: #F7F6FB;
}
.main-swiper {
  width: 100%;
}

/* 滑动切换淡入淡出: 当前页内容淡入 */
.fade-wrap {
  height: 100%;
}
.fade-wrap.fade-on {
  animation: tabFadeIn 0.32s ease;
}
@keyframes tabFadeIn {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
