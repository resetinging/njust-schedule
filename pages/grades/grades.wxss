/* 成绩查询页面样式 — 复刻目标 UI: 淡紫底 + 白卡 + 分数胶囊 */

.container {
  padding-bottom: 40rpx;
  background: #F2F0FA;
  min-height: 100vh;
}

/* ============ 已勾选课程统计卡 ============ */
.stats-card {
  margin: 20rpx 20rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(87, 74, 160, 0.08);
}

.sc-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sc-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #33304F;
}

.mode-seg {
  display: flex;
  background: #F2F0FA;
  border-radius: 24rpx;
  padding: 4rpx;
}

.seg {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #8A87A8;
  border-radius: 20rpx;
}

.seg.on {
  background: #8B79EC;
  color: #fff;
  font-weight: 600;
}

.sc-refresh {
  font-size: 32rpx;
  padding: 4rpx;
}

.sc-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.pill {
  background: #F2F0FA;
  border-radius: 20rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #5B5778;
}

.pill-num {
  font-weight: 700;
  color: #33304F;
}

.pill-num.gpa-high { color: #27ae60; }
.pill-num.gpa-mid { color: #f39c12; }
.pill-num.gpa-low { color: #e74c3c; }

/* 四六级行 */
.sc-cet {
  margin-top: 20rpx;
  background: #F7F6FB;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
}

.sc-cet-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sc-cet-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #33304F;
}

.sc-cet-date {
  margin-left: auto;
  font-size: 24rpx;
  color: #8A87A8;
}

.sc-cet-line {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5B5778;
  padding-left: 44rpx;
}

/* ============ 勾选框 ============ */
.chk {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 3rpx solid #C9C4E4;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.chk.on {
  background: #6C5CE0;
  border-color: #6C5CE0;
}

.chk.sm { width: 34rpx; height: 34rpx; font-size: 22rpx; }

/* ============ 分学期卡片 ============ */
.sem-card {
  margin: 0 20rpx 20rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 28rpx 8rpx;
  box-shadow: 0 6rpx 24rpx rgba(87, 74, 160, 0.08);
}

.sem-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0 16rpx;
}

.sem-ico { font-size: 30rpx; }

.sem-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #33304F;
}

.sem-count {
  font-size: 25rpx;
  color: #8A87A8;
}

.sem-fold {
  font-size: 24rpx;
  color: #8A87A8;
  padding: 0 6rpx;
}

.sem-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #F1EFF8;
  border-bottom: 1rpx solid #F1EFF8;
}

.ss-tag { font-size: 28rpx; }

.ss-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #33304F;
}

.ss-avg {
  font-size: 25rpx;
  color: #8A87A8;
}

/* ============ 课程行 ============ */
.grade-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F4FA;
}

.grade-row:last-child { border-bottom: none; }

.g-main {
  flex: 1;
  min-width: 0;
}

.g-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #33304F;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.g-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A87A8;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 分数胶囊(紫色渐变) */
.g-score {
  flex-shrink: 0;
  min-width: 76rpx;
  text-align: center;
  padding: 8rpx 18rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #6C5CE0, #8B79EC);
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(108, 92, 224, 0.30);
}

/* 空状态 */
.empty-state {
  padding: 160rpx 40rpx;
  text-align: center;
}

.empty-state .icon { font-size: 100rpx; }
.empty-state .text {
  font-size: 28rpx;
  color: #8A87A8;
  margin: 20rpx 0 32rpx;
}
