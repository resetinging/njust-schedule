/* 空教室查询页 · 清透课堂: 白卡 + 细描边 + 浅蓝软底 */

.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 60rpx;
}

/* ============================================================
顶部头卡: 浅蓝软底 + 细描边
============================================================ */
.hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 30rpx 28rpx;
  border-radius: var(--radius-card);
  background: var(--hero-bg);
  border: var(--bw-card) solid var(--hero-border);
  box-shadow: var(--shadow-card);
}

.hero-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  font-size: 48rpx;
}

.hero-text {
  flex: 1;
}

.hero-title {
  color: var(--hero-title);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-desc {
  margin-top: 6rpx;
  color: var(--hero-sub);
  font-size: 23rpx;
}

/* ============================================================
筛选卡片
============================================================ */
.filter-card {
  margin: 20rpx 24rpx 0;
  padding: 6rpx 26rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  border: var(--bw-card) solid var(--line);
  box-shadow: var(--shadow-card);
}

.filter-row {
  display: flex;
  align-items: center;
  padding: 27rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.filter-row:last-child {
  border-bottom: none;
}

.filter-row:active {
  background: var(--bg-hover);
}

.filter-icon {
  width: 44rpx;
  font-size: 26rpx;
}

.filter-label {
  width: 150rpx;
  font-size: 27rpx;
  color: var(--text-hint);
}

.filter-value {
  flex: 1;
  text-align: right;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.filter-row .arrow {
  margin-left: 14rpx;
  color: var(--icon-faint);
  font-size: 32rpx;
}

/* ============================================================
结果摘要: 浅蓝软底 + 细描边
============================================================ */
.result-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 26rpx;
  border-radius: var(--radius-card);
  background: var(--hero-bg);
  border: var(--bw-card) solid var(--hero-border);
  box-shadow: var(--shadow-card);
}

.result-summary {
  flex: 1;
  margin-right: 16rpx;
  color: var(--text-muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.result-count-box {
  display: flex;
  align-items: baseline;
}

.result-count-num {
  color: var(--hero-title);
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1;
}

.result-count-unit {
  margin-left: 6rpx;
  color: var(--text-muted);
  font-size: 22rpx;
}

/* 数据来源提示 */
.cache-note {
  margin: 10rpx 30rpx 0;
  text-align: right;
  font-size: 22rpx;
  color: var(--signal-deep);
}

/* ============================================================
教学楼分组
============================================================ */
.group-list {
  padding: 4rpx 24rpx;
}

.group-card {
  margin-top: 20rpx;
  padding: 24rpx 24rpx 8rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  border: var(--bw-card) solid var(--line);
  box-shadow: var(--shadow-card);
}

.group-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 8rpx;
}

.group-name-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.group-emoji {
  font-size: 30rpx;
}

.group-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.group-badge {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--primary-line);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 600;
}

.group-chips {
  overflow: hidden;          /* 折叠时裁剪多余行 */
}

/* 默认只展示两行教室 chip: 行盒 58rpx + 上下间距 20rpx → 2 行 = 156rpx
   (chip 行高固定, 保证不同机型下第二行不会被裁切; 是否溢出由 JS 实测) */
.group-chips.is-collapsed {
  max-height: 156rpx;
}

.chips-inner {
  display: flex;
  flex-wrap: wrap;
}

.room-chip {
  margin: 10rpx 12rpx 10rpx 0;
  padding: 12rpx 24rpx;
  background: var(--bg-sunken);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  line-height: 30rpx;
  color: var(--text-secondary);
}

.group-toggle {
  margin: 2rpx 0 14rpx;
  padding: 10rpx 0 4rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
}

.group-toggle:active {
  opacity: 0.6;
}

.group-toggle .toggle-arrow {
  margin-left: 8rpx;
}

/* ============================================================
加载 / 错误 / 未登录
============================================================ */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 110rpx 40rpx;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid var(--line-strong);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-hint);
}

.err-tip {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--danger-soft);
  color: var(--danger);
  border-radius: var(--radius-ctrl);
  font-size: 26rpx;
  text-align: center;
}

.login-wrap {
  padding-top: 120rpx;
}
