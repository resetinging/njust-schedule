/* 校园工具样式 — 复刻目标 UI: 淡紫底 + 白色大圆角卡片 */

.container {
  padding-bottom: 40rpx;
  background: #F7F6FB;
  min-height: 100vh;
}

.tool-list {
  padding: 20rpx 20rpx 40rpx;
}

.tool-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(87, 74, 160, 0.08);
}

.tool-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #33304F;
  margin-bottom: 16rpx;
}

.tool-img {
  width: 100%;
  display: block;
  border-radius: 16rpx;
  background: #F7F6FB;
}

.empty-state {
  padding: 160rpx 40rpx;
  text-align: center;
}

.empty-state .icon { font-size: 100rpx; }
.empty-state .text {
  font-size: 28rpx;
  color: #8A87A8;
  margin: 20rpx 0 32rpx;
}

/* 诊断信息 */
.diag-tip {
  margin: 16rpx 24rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  color: #B06A3C;
  background: #FDF3E9;
  border-radius: 16rpx;
  word-break: break-all;
}
