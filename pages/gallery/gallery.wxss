/* 校园工具样式 · 清透课堂: 白卡 + 细描边 */

.container {
  padding-bottom: 40rpx;
  background: var(--bg-page);
  min-height: 100vh;
}

.tool-list {
  padding: 20rpx 20rpx 40rpx;
}

.tool-card {
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.tool-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.tool-img {
  width: 100%;
  display: block;
  border-radius: var(--radius-ctrl);
  background: var(--bg-page);
}

.empty-state {
  padding: 160rpx 40rpx;
  text-align: center;
}

.empty-state .icon { font-size: 100rpx; }
.empty-state .text {
  font-size: 28rpx;
  color: var(--text-hint);
  margin: 20rpx 0 32rpx;
}

/* 诊断信息 */
.diag-tip {
  margin: 16rpx 24rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  color: var(--signal-deep);
  background: var(--signal-soft);
  border-radius: var(--radius-ctrl);
  word-break: break-all;
}
