<!-- 校园工具 — 校历 & 地图卡片墙(复刻目标 UI) -->
<view class="container">

  <loading-modal visible="{{loading}}" title="加载图片…"
                 message="{{downloadMsg}}"
                 showProgress="{{downloadPercent > 0}}"
                 percent="{{downloadPercent}}" />

  <!-- 诊断信息(仅出错时显示) -->
  <view class="diag-tip" wx:if="{{diag}}">{{diag}}</view>

  <!-- 空状态 / 错误 -->
  <empty-state wx:if="{{!loading && errorMsg}}"
               icon="🖼️"
               title="{{errorMsg}}"
               desc="网络异常，请稍后再试"
               action-text="重新加载"
               bind:action="loadImages" />

  <!-- 卡片列表 -->
  <view wx:if="{{!loading && !errorMsg}}" class="tool-list">
    <view class="tool-card" wx:for="{{images}}" wx:key="name"
          data-index="{{index}}" bindtap="onImageTap">
      <view class="tool-title">{{item.title}}</view>
      <image class="tool-img" src="{{item.src}}" mode="widthFix" lazy-load />
    </view>
  </view>

</view>
