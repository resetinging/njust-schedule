/* 考试页面样式 — 参考桌面端 exams 设计 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}

/* 顶部操作栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  background: #fff;
}

.refresh-btn {
  color: var(--primary);
  font-weight: bold;
}

/* ==============================
   倒计时卡片（横向滚动）
   ============================== */

.countdown-scroll {
  white-space: nowrap;
  padding: 0 16rpx 12rpx;
}

.countdown-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.countdown-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 180rpx;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  white-space: normal;
}

.countdown-card.urgent {
  background: linear-gradient(135deg, #FFF5F5, #FFEBEE);
  border: 2rpx solid #EF5350;
}

.countdown-card.warning {
  background: linear-gradient(135deg, #FFFDE7, #FFF9C4);
  border: 2rpx solid #FFA726;
}

.countdown-card.done {
  opacity: 0.5;
}

.cd-bignum {
  font-size: 56rpx;
  font-weight: bold;
  line-height: 1;
}

.countdown-card.urgent .cd-bignum { color: #D32F2F; }
.countdown-card.warning .cd-bignum { color: #E65100; }
.countdown-card.done .cd-bignum { color: #999; }

.cd-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.countdown-card.urgent .cd-label { color: #D32F2F; }
.countdown-card.warning .cd-label { color: #E65100; }

.cd-course {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
  margin-top: 12rpx;
  text-align: center;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cd-date {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

/* ==============================
   考试列表（按日期分组）
   ============================== */

.exam-scroll {
  flex: 1;
  padding: 0 20rpx 24rpx;
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 8rpx 12rpx;
}

.date-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.date-urgency {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
}

.date-urgency.urgent {
  background: #FFEBEE;
  color: #D32F2F;
}

.date-urgency.warning {
  background: #FFF8E1;
  color: #E65100;
}

.date-urgency.done {
  background: #F5F5F5;
  color: #999;
}

/* 考试卡片 */
.exam-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.05);
}

.exam-card.exam-urgent {
  border-left: 6rpx solid #EF5350;
}

.exam-card.exam-warning {
  border-left: 6rpx solid #FFA726;
}

.exam-course {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 12rpx;
}

.exam-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #666;
}

/* ==============================
   公共
   ============================== */

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-hint);
}

.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-state .text {
  font-size: 28rpx;
}

.btn-primary {
  display: block;
  width: 70%;
  margin: 0 auto;
  padding: 20rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
}

/* ==== 优化: 已结束分组折叠 ==== */
.date-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.collapse-arrow {
  font-size: 20rpx;
  color: var(--text-hint);
  padding: 4rpx 8rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
}
.exam-done {
  opacity: 0.55;
}
