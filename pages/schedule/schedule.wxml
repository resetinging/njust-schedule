<!-- 课表页面 -->
<view class="container">

  <!-- 顶部信息栏 -->
  <view class="header">
    <view class="semester-row">
      <picker mode="selector" range="{{semesters}}" bindchange="onSemesterChange">
        <view class="semester-picker">
          <text>{{semester || '选择学期'}}</text>
          <text class="arrow">▼</text>
        </view>
      </picker>
      <view class="week-info">
        <text>第 {{currentWeek}} 周<text wx:if="{{currentWeek === actualWeek}}" class="this-week-label">（本周）</text></text>
        <view class="week-nav">
          <text class="week-btn" bindtap="prevWeek">◀</text>
          <text class="week-btn" bindtap="nextWeek">▶</text>
        </view>
      </view>
    </view>

    <!-- 视图切换 -->
    <view class="view-toggle">
      <text
        class="toggle-btn {{viewMode === 'grid' ? 'active' : ''}}"
        data-mode="grid"
        bindtap="switchView"
      >📅 网格</text>
      <text
        class="toggle-btn {{viewMode === 'list' ? 'active' : ''}}"
        data-mode="list"
        bindtap="switchView"
      >📋 列表</text>
    </view>
  </view>

  <!-- 网格视图 -->
  <view class="grid-wrapper" wx:if="{{viewMode === 'grid' && !loading && filteredCourses.length > 0}}">
    <week-grid
      courses="{{filteredCourses}}"
      currentWeek="{{currentWeek}}"
      firstWeekDate="{{firstWeekDate}}"
      todayDay="{{todayDay}}"
      bind:coursetap="onCourseTap"
    />
  </view>

  <!-- 列表视图 -->
  <view class="list-wrapper" wx:if="{{viewMode === 'list' && !loading}}">
    <block wx:if="{{listDayGroups.length > 0}}">
      <view class="day-group" wx:for="{{listDayGroups}}" wx:key="day" wx:for-item="group">
        <view class="day-title">{{group.dayName}}</view>
        <view
          wx:for="{{group.courses}}"
          wx:key="index"
          wx:for-item="c"
          class="course-card {{c.week_type === 1 ? 'type-odd' : ''}} {{c.week_type === 2 ? 'type-even' : ''}}"
          bindtap="onCourseTap"
          data-course="{{c}}"
        >
            <view class="card-header">
              <text class="card-name">{{c.name}}</text>
              <text class="card-periods">{{c.start || c.start_period}}-{{c.end || c.end_period}}节</text>
            </view>
            <view class="card-body">
              <text wx:if="{{c.teacher}}">👨‍🏫 {{c.teacher}}</text>
              <text wx:if="{{c.classroom}}">📍 {{c.classroom}}</text>
            </view>
            <view class="card-footer">
              <text class="card-weeks">📅 {{c.weeks || '1-18周'}}</text>
              <text class="card-badge" wx:if="{{c.week_type === 1}}">单周</text>
              <text class="card-badge even" wx:if="{{c.week_type === 2}}">双周</text>
            </view>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:else>
      <text>本周暂无课程</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="empty-state" wx:if="{{loading}}">
    <view class="icon">⏳</view>
    <view class="text">加载中…</view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && courses.length === 0}}">
    <view class="icon">📅</view>
    <view class="text">暂无课表数据</view>
    <button class="btn-primary" style="margin-top:32rpx" bindtap="onRefresh">获取课表</button>
  </view>

  <!-- 课程详情弹窗 -->
  <view class="modal-mask" wx:if="{{showDetail}}" bindtap="closeDetail">
    <view class="modal-card" catchtap="">
      <view class="modal-title">
        {{detailCourse.name}}
        <text class="modal-badge" wx:if="{{detailCourse.week_type === 1}}">单周</text>
        <text class="modal-badge even" wx:if="{{detailCourse.week_type === 2}}">双周</text>
      </view>
      <view class="modal-row">
        <text class="label">教师</text>
        <text>{{detailCourse.teacher || '未指定'}}</text>
      </view>
      <view class="modal-row">
        <text class="label">教室</text>
        <text>{{detailCourse.classroom || '未指定'}}</text>
      </view>
      <view class="modal-row">
        <text class="label">时间</text>
        <text>周{{detailCourse.day_of_week || detailCourse.day}} 第{{detailCourse.start_period || detailCourse.start}}-{{detailCourse.end_period || detailCourse.end}}节</text>
      </view>
      <view class="modal-row">
        <text class="label">周次</text>
        <text class="weeks-text">{{detailCourse.weeks || '1-18周'}}</text>
      </view>
      <view class="modal-row" wx:if="{{detailCourse.credits}}">
        <text class="label">学分</text>
        <text>{{detailCourse.credits}}</text>
      </view>
      <view class="modal-row" wx:if="{{detailCourse.type}}">
        <text class="label">类型</text>
        <text>{{detailCourse.type}}</text>
      </view>
      <button class="btn-primary" style="margin-top:24rpx" bindtap="closeDetail">关闭</button>
    </view>
  </view>

</view>
