/* 问题反馈页 — 对齐全局紫色系: 白卡紫描边 + 胶囊选择 + 主按钮 */

.container {
  min-height: 100vh;
  background: #F7F6FB;
  box-sizing: border-box;
  padding: 24rpx;
}

.fb-card {
  background: #fff;
  border: 2rpx solid #EFEBFC;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(87, 74, 160, 0.06);
  padding: 32rpx 28rpx 28rpx;
}

.fb-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #3A3560;
  margin-bottom: 14rpx;
}

/* 类型选择: 胶囊分段 */
.type-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #8A87A8;
  background: #F3F1FA;
  border-radius: 999rpx;
}

.type-tab.on {
  background: #7C6BE8;
  color: #fff;
  font-weight: 600;
}

/* 反馈内容 */
.fb-textarea {
  width: 100%;
  height: 280rpx;
  background: #F7F6FB;
  border: 2rpx solid #EFEBFC;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #3A3560;
  box-sizing: border-box;
}

.fb-count {
  text-align: right;
  font-size: 22rpx;
  color: #9B96B8;
  margin-top: 8rpx;
}

/* 联系方式 */
.fb-input {
  height: 84rpx;
  background: #F7F6FB;
  border: 2rpx solid #EFEBFC;
  border-radius: 18rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 提交按钮 */
.fb-submit {
  margin-top: 36rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  font-size: 30rpx;
  border-radius: 999rpx !important;
}

.fb-tip {
  text-align: center;
  font-size: 22rpx;
  color: #9B96B8;
  margin-top: 20rpx;
}
