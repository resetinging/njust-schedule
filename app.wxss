/* ============================================================
   南理工课表 — 全局样式
   NJUST 主题色: 紫色 #7C6BE8
   ============================================================ */

page {
  --primary: #7C6BE8;
  --primary-light: #8B79EC;
  --primary-dark: #5A4AC8;
  --success: #27ae60;
  --danger: #e74c3c;
  --warning: #f39c12;
  --text-primary: #33304F;
  --text-secondary: #8A87A8;
  --text-hint: #8A87A8;
  --bg-page: #F2F0FA;
  --bg-card: #FFFFFF;
  --border: #E3DFF5;
  --overlay: rgba(0, 0, 0, 0.5);

  font-family: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  background: var(--bg-page);
  box-sizing: border-box;
}

/* ============================================================
   通用组件样式
   ============================================================ */

/* 卡片 */
.card {
  margin: 20rpx;
  padding: 24rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 按钮 */
.btn-primary {
  background: var(--primary) !important;
  color: #fff !important;
  border-radius: 12rpx !important;
  font-size: 30rpx !important;
}

.btn-outline {
  background: #fff !important;
  color: var(--primary) !important;
  border: 2rpx solid var(--primary) !important;
  border-radius: 12rpx !important;
}

.btn-danger {
  background: var(--danger) !important;
  color: #fff !important;
  border-radius: 12rpx !important;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-state .icon {
  font-size: 120rpx;
  color: var(--text-hint);
  margin-bottom: 24rpx;
}

.empty-state .text {
  font-size: 28rpx;
  color: var(--text-hint);
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 16rpx 0;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.tag-primary {
  background: #EFEBFC;
  color: var(--primary);
}

.tag-success {
  background: #E8F5E9;
  color: var(--success);
}

.tag-warning {
  background: #FFF3E0;
  color: var(--warning);
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 20rpx;
  color: var(--text-hint);
  font-size: 24rpx;
}

/* ============================================================
   弹窗通用样式
   ============================================================ */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.modal-card {
  width: 600rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.modal-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.modal-buttons button {
  flex: 1;
}

/* ==== 优化: 底部安全区 + 通用滚动提示 ==== */
.page-safe-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

/* ============================================================
   V2 视觉升级 — 全局主题质感
   ============================================================ */
page {
  background: linear-gradient(180deg, #F7F6FB 0%, #F5F5F5 55%, #f0f4f8 100%);
}

/* 卡片质感(未被页面重定义的 .card) */
.card {
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(26, 82, 118, 0.08);
  border: 1rpx solid rgba(26, 82, 118, 0.06);
}

/* 主按钮渐变 + 按压反馈 */
.btn-primary {
  background: linear-gradient(135deg, #7C6BE8 0%, #8B79EC 100%) !important;
  box-shadow: 0 8rpx 20rpx rgba(26, 82, 118, 0.30) !important;
  border-radius: 44rpx !important;
}
.btn-primary:active { opacity: 0.85; }
.btn-outline:active, .btn-danger:active { opacity: 0.85; }

/* 数字字体(tabular) */
.stat-num, .gpa-bignum, .cd-bignum, .grade-score {
  font-family: "DIN Alternate", "Avenir Next", "Helvetica Neue", sans-serif;
  font-weight: 800;
}

/* 统一分区标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #33304F;
  letter-spacing: 0.5rpx;
}

/* 空状态图标: 渐变圆底 */
.empty-state .icon {
  width: 160rpx;
  height: 160rpx;
  line-height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #EFEBFC 0%, #F3E8FF 100%);
  font-size: 72rpx;
  margin-bottom: 28rpx;
}


/* ============================================================
   V4 简约风格 — 白色为主, 克制的紫色点缀
   ============================================================ */
page {
  background: #F7F6FB;
}

/* 卡片: 白底 + 轻阴影 */
.card {
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(31, 25, 72, 0.05);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

/* 按钮: 纯色主紫, 去渐变去投影 */
.btn-primary {
  background: #7C6BE8 !important;
  box-shadow: none !important;
  border-radius: 16rpx !important;
}
.btn-primary:active { opacity: 0.88; }

/* 主色文字 */
.primary-text { color: var(--primary); }

/* 空状态: 大图标, 去掉渐变圆底 */
.empty-state .icon {
  width: auto;
  height: auto;
  line-height: normal;
  border-radius: 0;
  background: none;
  font-size: 100rpx;
  margin-bottom: 24rpx;
  filter: none;
}


/* ============================================================
   V6 桌面端同款布局 — 全局
   ============================================================ */
/* 卡片: 桌面 --radius 10px / --shadow 0 2px 8px rgba(0,0,0,0.08) */
.card {
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  border: none;
}

/* 按钮: 桌面 .btn padding 8px 16px / radius 8px; 主按钮 #8B79EC */
.btn-primary {
  background: #8B79EC !important;
  box-shadow: none !important;
  border-radius: 16rpx !important;
}
.btn-outline, .btn-secondary {
  background: #fff !important;
  color: #33304F !important;
  border: 2rpx solid #E3DFF5 !important;
  border-radius: 16rpx !important;
}

/* 分区标题: 桌面 .section-title 1.1rem 主色 */
.section-title {
  color: #7C6BE8;
  font-size: 36rpx;
  font-weight: 700;
}

/* 学期徽标(桌面 .semester-badge): 淡蓝底主色字胶囊 */
.semester-badge {
  background: #EFEBFC;
  color: #7C6BE8;
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
}

/* 空状态: 桌面 .empty-icon 4rem / h3 1.2rem */
.empty-state .icon { font-size: 112rpx; }
.empty-state .text { font-size: 28rpx; color: #8A87A8; }


/* ============================================================
   全站统一页面头部 — 紫渐变卡片(课表 top-card 同款)
   ============================================================ */
.page-hero {
  margin: 16rpx 20rpx 20rpx;
  padding: 30rpx 30rpx 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #8F7DF0 0%, #A99BF5 55%, #BBAFF8 100%);
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(120, 100, 220, 0.35);
}

.ph-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.ph-title {
  font-size: 36rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

.ph-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.ph-refresh {
  font-size: 28rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.ph-refresh:active { background: rgba(255, 255, 255, 0.35); }

/* ============================================================
   全站卡片统一浅色背景(课表风格 #F7F6FB) — 紫渐变卡不受影响
   ============================================================ */
.batch-card, .course-card, .indicator-card, .sem-card,
.sc-cet, .sem-gpa-card, .exam-card, .countdown-card,
.setting-card, .login-card, .tool-card, .modal-card {
  background: #F7F6FB !important;
}

/* 设置页操作列表项同样统一 */
.action-item {
  background: #F7F6FB !important;
}

/* ============================================================
   Tab 滑动切换动画
   ============================================================ */
.anim-slide-in-right {
  animation: slideInRight 0.28s ease-out;
}
.anim-slide-in-left {
  animation: slideInLeft 0.28s ease-out;
}
@keyframes slideInRight {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}
@keyframes slideInLeft {
  from { transform: translateX(-100%); }
  to { transform: translateX(0); }
}
