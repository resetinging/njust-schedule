@import "./styles/font-pixel.wxss";
@import "./styles/design-system.wxss";

/* 统计槽位标记: 仅用于可见性观测, 不参与视觉与点击。 */
.analytics-slot-marker {
  width: 100%;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}
/* 字体档位: 默认像素点阵(ZpixPixel/ZpixFull); 页面根节点挂 .font-system 即回到系统字体 */
.font-system {
  --font-body: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-num: "DIN Alternate", "Avenir Next", "Helvetica Neue", sans-serif;
  --font-display: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-ann: var(--font-body);
  /* 必须在这里重新声明一次: page 上的 font-family 已经解析成具体字体并向下继承,
     只覆盖变量对子元素不起作用(它们没有自己的 font-family 声明)。 */
  font-family: var(--font-body);
}

/* 颜色、圆角、投影、字体与 TDesign 映射统一维护在 design-system.wxss。 */

/* ============================================================
   通用: 卡片 / 分隔线 / 标题 / 徽标 / 空态
   ============================================================ */

.card {
  margin: var(--space-page);
  padding: 24rpx;
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

button::after { border: 0; }

button, .tap {
  transition: background-color var(--motion-fast) var(--ease-standard),
              opacity var(--motion-fast) var(--ease-standard),
              transform var(--motion-base) var(--ease-spring),
              box-shadow var(--motion-base) var(--ease-standard);
}

button:active, .tap:active {
  opacity: .88;
  transform: scale(.97);
}

.glass {
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-line);
  -webkit-backdrop-filter: blur(24rpx) saturate(165%);
  backdrop-filter: blur(24rpx) saturate(165%);
  box-shadow: var(--glass-shadow);
}

.tap {
  will-change: transform;
}

.divider {
  height: 1rpx;
  background: var(--line-soft);
  margin: 16rpx 0;
}

/* 分区标题: 墨色 + 左侧主色短线(代替整块底色) */
.section-title {
  position: relative;
  padding-left: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
  font-family: var(--font-display);
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  border-radius: var(--radius-chip);
  background: var(--primary);
}

/* 学期/状态徽标: 浅蓝底 + 主色字 */
.semester-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-pill);
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-size: 26rpx;
  font-weight: 600;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-chip);
  font-size: 22rpx;
}

.tag-warning {
  background: var(--signal-soft);
  color: var(--signal);
}

/* 空状态(无内容时的极简提示) */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-state .icon {
  width: auto;
  height: auto;
  line-height: normal;
  border-radius: 0;
  background: none;
  font-size: 100rpx;
  color: var(--text-hint);
  margin-bottom: 24rpx;
}

.empty-state .text {
  font-size: 28rpx;
  color: var(--text-hint);
}

/* 数字字体(成绩/绩点/倒计时) */
.stat-num, .gpa-bignum, .cd-bignum, .grade-score {
  font-family: var(--font-display);
  font-weight: 800;
}

/* ============================================================
   按钮: 纯色 + 小圆角, 无投影
   ============================================================ */

.btn-primary {
  background: var(--primary) !important;
  color: var(--bg-card) !important;
  border: none !important;
  border-radius: var(--radius-ctrl) !important;
  font-size: 30rpx !important;
  box-shadow: var(--shadow-btn) !important;
}

.btn-outline {
  background: var(--bg-card) !important;
  color: var(--primary) !important;
  border: 2rpx solid var(--primary-line) !important;
  border-radius: var(--radius-ctrl) !important;
}

.btn-danger {
  background: var(--danger) !important;
  color: var(--bg-card) !important;
  border: none !important;
  border-radius: var(--radius-ctrl) !important;
}

.btn-primary:active, .btn-outline:active, .btn-danger:active {
  opacity: 0.85;
}

/* ---- 胶囊按钮族 ---- */
.u-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: var(--radius-ctrl);
  font-size: 29rpx;
  font-weight: 600;
  border: none;
  background: none;
  box-shadow: var(--shadow-btn);
}

.u-btn::after { border: none; }

.u-btn-primary {
  background: var(--primary);
  color: var(--bg-card);
}

.u-btn-outline {
  background: var(--bg-card);
  color: var(--primary);
  border: 2rpx solid var(--primary-line);
}

.u-btn-danger {
  background: var(--danger-soft);
  color: var(--danger);
}

.u-btn-ghost {
  background: var(--line-soft);
  color: var(--text-muted);
}

.u-btn-sm {
  height: 64rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.u-btn-primary:active, .u-btn-outline:active,
.u-btn-danger:active, .u-btn-ghost:active {
  opacity: 0.82;
}

/* ---- 图标钮: 无底色, 按下才有反馈(热区 ≥ 88rpx) ---- */
.u-ico-btn {
  width: 88rpx;
  height: 88rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--primary);
  border-radius: 50%;
  line-height: 1;
  flex-shrink: 0;
}

.u-ico-btn:active {
  background: rgba(59, 130, 246, 0.10);
}

.u-ico-btn-soft {
  width: 64rpx;
  height: 64rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 32rpx;
}

/* ============================================================
   页面头部: 浅蓝软底 + 细描边(替代旧紫渐变卡)
   ============================================================ */

.page-hero {
  margin: 16rpx 24rpx 20rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--radius-card);
  background: var(--hero-bg);
  border: var(--bw-card) solid var(--hero-border);
  color: var(--text-primary);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ph-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.ph-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--hero-title);
  text-shadow: none;
}

.ph-sub {
  font-size: 24rpx;
  color: var(--hero-sub);
}

.ph-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  flex-shrink: 0;
}

.ph-refresh:active { background: var(--bg-card); }

/* ============================================================
   弹窗
   ============================================================ */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.modal-card {
  width: 600rpx;
  max-height: 80vh;
  background: rgba(255, 255, 255, .90);
  border: 1rpx solid rgba(255, 255, 255, .82);
  border-radius: var(--radius-card);
  padding: 40rpx;
  overflow-y: auto;
  -webkit-backdrop-filter: blur(32rpx) saturate(180%);
  backdrop-filter: blur(32rpx) saturate(180%);
  box-shadow: 0 28rpx 80rpx rgba(15, 23, 42, .22);
}

.modal-mask {
  -webkit-backdrop-filter: blur(12rpx);
  backdrop-filter: blur(12rpx);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.modal-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.modal-buttons button {
  flex: 1;
}

/* ============================================================
   卡片族统一: 白底 + 细描边(各页细节样式见各自 wxss)
   ============================================================ */

.batch-card, .course-card, .indicator-card, .sem-card,
.sc-cet, .sem-gpa-card, .exam-card, .countdown-card,
.setting-card, .login-card, .tool-card, .modal-card {
  background: var(--bg-card);
}

/* ============================================================
   加载动画
   ============================================================ */

.spin {
  animation: ico-spin 1s linear infinite;
}

@keyframes ico-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 底部安全区 */
.page-safe-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

@media (prefers-reduced-motion: reduce) {
  button, .tap, .tab-bar-item, .tab-emoji-wrap, .tab-wrap,
  .user-card, .course-block, .feat-tile, .feat-tool-tile, .today-card,
  .grid-wrapper, .course-card, .day-group, .week-body, .ctrl-icon,
  .announce-card,
  .login-card, .setting-card, .notice-card, .menu-card,
  .hero, .filter-card, .result-bar, .group-card, .tool-card,
  .countdown-card, .exam-card, .batch-card, .indicator-card,
  .gpa-hero, .sc-cet, .sem-gpa-card, .sem-card, .cr-hero,
  .metric-card, .mode-indicator, .grade-row, .chk,
  .sub-shell, .sub-back, .custom-nav, .custom-back, .container {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}
