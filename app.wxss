/* 字体引入与档位覆盖（唯一职责：字体档位切换）
   颜色、圆角、间距、字阶、动效与 TDesign 映射统一维护在 styles/design-system.wxss。 */
@import "./styles/font-pixel.wxss";
@import "./styles/design-system.wxss";

/* 统计槽位标记: 仅用于可见性观测, 不参与视觉与点击。 */
.analytics-slot-marker {
  width: 100%;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

/* 字体档位: 默认 = 像素点阵（design-system 的 --font-pixel）；根节点挂 .font-system 即回到系统字。
   保留用户选择（utils/font.js 的 storage 偏好），本文件只负责变量覆盖。

   为什么每个令牌都要在这里覆盖一次：
   - --font-body/--font-display：普通元素直接使用；
   - --font-plain/--font-ann：在 page 上已用 var(--font-body) 替换成像素字面量再继承，
     仅在页面根改 --font-body 不会回灌，必须重新赋值；
   - --td-font-family(-medium)：同理在 page 上已替换成像素字面量，
     TDesign 组件消费的是这个变量，不覆盖会让系统字档下的组件仍是像素字。 */
.font-system {
  --font-body: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-display: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-plain: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-ann: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-num: "DIN Alternate", "Avenir Next", "Helvetica Neue", sans-serif;
  --td-font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  --td-font-family-medium: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  /* 必须在这里重新声明一次: page 上的 font-family 已解析成具体字体并向下继承,
     只覆盖变量对没有 font-family 声明的子元素不起作用。 */
  font-family: var(--font-body);
}
