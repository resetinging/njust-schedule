@import "./styles/font-pixel.wxss";

/* 字体档位: 默认像素点阵(ZpixPixel/ZpixFull); 页面根节点挂 .font-system 即回到系统字体 */
.font-system {
  --font-body: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-num: "DIN Alternate", "Avenir Next", "Helvetica Neue", sans-serif;
  --font-display: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-ann: var(--font-body);
  /* 必须在这里重新声明一次: page 上的 font-family 已经解析成具体字体并向下继承,
     只覆盖变量对子元素不起作用(它们没有自己的 font-family 声明)。 */
  font-family: var(--font-body);
}


/* ============================================================
   课表助手 — 全局样式
   清透课堂: 白底 + 明快蓝(交互) + 信号橙(今天/待办) + 粉彩课程块。
   颜色/圆角/描边/投影/字体全部走下面的语义变量, 方便整体调色与换字体。
   ============================================================ */

page {
  /* --- 主色: 交互(按钮 / 链接 / 选中态) --- */
  --primary: #3B82F6;
  --primary-light: #60A5FA;
  --primary-dark: #2563EB;
  --primary-soft: #EFF6FF;
  --primary-line: #DBEAFE;

  /* --- 信号色: 今天 / 待办 --- */
  --signal: #F97316;
  --signal-soft: #FFF7ED;
  --signal-line: #FED7AA;
  --signal-deep: #B45309;

  /* --- 状态色 --- */
  --success: #16A34A;
  --success-soft: #ECFDF5;
  --success-deep: #15803D;
  --warning: #F59E0B;
  --warning-light: #FBBF24;
  --warning-soft: #FFFBEB;
  --warning-line: #FDE68A;
  --danger: #DC2626;
  --danger-soft: #FEF2F2;
  --danger-deep: #B91C1C;

  /* --- 文字: 墨 → 正文 → 次要 → 弱 --- */
  --text-primary: #0F172A;
  --text-strong: #1E293B;
  --text-secondary: #334155;
  --text-muted: #64748B;
  --text-hint: #94A3B8;
  --icon-faint: #CBD5E1;
  --ink: #0F172A;

  /* --- 背景与描边 --- */
  --bg-page: #F7F9FC;
  --bg-card: #FFFFFF;
  --bg-sunken: #F8FAFC;
  --bg-hover: #F8FAFF;
  --line: #EEF2F8;
  --line-soft: #F1F5F9;
  --line-strong: #E2E8F0;
  --border: #EEF2F8;
  --overlay: rgba(15, 23, 42, 0.45);

  /* --- 今天 --- */
  --today-chip-bg: #F97316;
  --today-chip-fg: #FFFFFF;
  --today-col-bg: #FFFDFA;
  --today-ring: #FFEDD9;

  /* --- 时间轴(浅→深表示一天的推进) --- */
  /* 左侧时间列: 统一的极浅蓝, 不做"上浅下深"的渐变 */
  --tcol-start: #F4F8FF;
  --tcol-mid: #F4F8FF;
  --tcol-end: #F4F8FF;
  --grid-line: rgba(15, 23, 42, 0.07);

  /* --- 页面头部 --- */
  --hero-bg: #EFF6FF;
  --hero-border: #DBEAFE;
  --hero-title: #2563EB;
  --hero-sub: #64748B;

  /* 绩点大数字: 浅底用语义色, 渐变底(初版)用白色 */
  --gpa-high: #15803D;
  --gpa-mid: #B45309;
  --gpa-low: #B91C1C;

  /* --- 形状 / 描边 / 投影 --- */
  --radius-chip: 10rpx;
  --radius-ctrl: 16rpx;
  --radius-card: 20rpx;
  --radius-pill: 999rpx;
  --bw-card: 1rpx;
  --bw-ctrl: 2rpx;
  --shadow-card: none;
  --shadow-btn: none;
  --shadow-pop: 0 16rpx 44rpx rgba(15, 23, 42, 0.18);
  --shadow-sheet: 0 -8rpx 32rpx rgba(15, 23, 42, 0.12);

  /* --- 课程块 --- */
  --co-radius: 10rpx;
  --co-bar-w: 6rpx;
  --co-border-w: 0rpx;

  /* --- 字体: 像素主题只把"标题/数字"换成点阵字 --- */
  /* 全站字体: 像素点阵字(ZpixPixel, 子集内联); 字体里没有的字自动回退系统字 */
  /* ZpixFull = 后端按需拉取的完整字库(冷僻字也能像素化); ZpixPixel = 内联子集兜底 */
  --font-body: "ZpixFull", "ZpixPixel", "PingFang SC", "Microsoft YaHei", monospace;
  --font-num: "ZpixFull", "ZpixPixel", "DIN Alternate", "PingFang SC", monospace;
  --font-display: "ZpixFull", "ZpixPixel", "PingFang SC", "Microsoft YaHei", monospace;
  /* 公告等长文本用系统字: 点阵字读长句较累 */
  --font-plain: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  /* 公告等文本也跟随当前档位(只有"我的"页字体列表本身用各自字体做预览) */
  --font-ann: var(--font-body);

  /* --- 课程色板(10 组: 粉彩底 / 深色字 / 明快左边条) --- */
  --c1-bg: #E8F1FF;  --c1-fg: #2563EB;  --c1-bar: #3B82F6;
  --c2-bg: #E6F7F1;  --c2-fg: #0F766E;  --c2-bar: #14B8A6;
  --c3-bg: #FFF4E5;  --c3-fg: #B45309;  --c3-bar: #F59E0B;
  --c4-bg: #FDE8F1;  --c4-fg: #BE185D;  --c4-bar: #EC4899;
  --c5-bg: #EFE9FF;  --c5-fg: #6D28D9;  --c5-bar: #8B5CF6;
  --c6-bg: #E7F6FB;  --c6-fg: #0E7490;  --c6-bar: #06B6D4;
  --c7-bg: #E8ECFF;  --c7-fg: #4338CA;  --c7-bar: #6366F1;
  --c8-bg: #F0F7DE;  --c8-fg: #4D7C0F;  --c8-bar: #84CC16;
  --c9-bg: #FFE9EC;  --c9-fg: #BE123C;  --c9-bar: #F43F5E;
  --c10-bg: #EEF2F7; --c10-fg: #475569; --c10-bar: #64748B;

  font-family: var(--font-body);
  font-size: 28rpx;
  color: var(--text-primary);
  background: var(--bg-page);
  box-sizing: border-box;
}

/* ============================================================
   通用: 卡片 / 分隔线 / 标题 / 徽标 / 空态
   ============================================================ */

.card {
  margin: 20rpx;
  padding: 24rpx;
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.divider {
  height: 1rpx;
  background: var(--line-soft);
  margin: 16rpx 0;
}

/* 分区标题: 墨色 + 左侧主色短线(代替整块底色) */
.section-title {
  position: relative;
  padding-left: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
  font-family: var(--font-display);
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  border-radius: var(--radius-chip);
  background: var(--primary);
}

/* 学期/状态徽标: 浅蓝底 + 主色字 */
.semester-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-pill);
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-size: 26rpx;
  font-weight: 600;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-chip);
  font-size: 22rpx;
}

.tag-warning {
  background: var(--signal-soft);
  color: var(--signal);
}

/* 空状态(无内容时的极简提示) */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-state .icon {
  width: auto;
  height: auto;
  line-height: normal;
  border-radius: 0;
  background: none;
  font-size: 100rpx;
  color: var(--text-hint);
  margin-bottom: 24rpx;
}

.empty-state .text {
  font-size: 28rpx;
  color: var(--text-hint);
}

/* 数字字体(成绩/绩点/倒计时) */
.stat-num, .gpa-bignum, .cd-bignum, .grade-score {
  font-family: var(--font-display);
  font-weight: 800;
}

/* ============================================================
   按钮: 纯色 + 小圆角, 无投影
   ============================================================ */

.btn-primary {
  background: var(--primary) !important;
  color: var(--bg-card) !important;
  border: none !important;
  border-radius: var(--radius-ctrl) !important;
  font-size: 30rpx !important;
  box-shadow: var(--shadow-btn) !important;
}

.btn-outline {
  background: var(--bg-card) !important;
  color: var(--primary) !important;
  border: 2rpx solid var(--primary-line) !important;
  border-radius: var(--radius-ctrl) !important;
}

.btn-danger {
  background: var(--danger) !important;
  color: var(--bg-card) !important;
  border: none !important;
  border-radius: var(--radius-ctrl) !important;
}

.btn-primary:active, .btn-outline:active, .btn-danger:active {
  opacity: 0.85;
}

/* ---- 胶囊按钮族 ---- */
.u-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: var(--radius-ctrl);
  font-size: 29rpx;
  font-weight: 600;
  border: none;
  background: none;
  box-shadow: var(--shadow-btn);
}

.u-btn::after { border: none; }

.u-btn-primary {
  background: var(--primary);
  color: var(--bg-card);
}

.u-btn-outline {
  background: var(--bg-card);
  color: var(--primary);
  border: 2rpx solid var(--primary-line);
}

.u-btn-danger {
  background: var(--danger-soft);
  color: var(--danger);
}

.u-btn-ghost {
  background: var(--line-soft);
  color: var(--text-muted);
}

.u-btn-sm {
  height: 64rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.u-btn-primary:active, .u-btn-outline:active,
.u-btn-danger:active, .u-btn-ghost:active {
  opacity: 0.82;
}

/* ---- 图标钮: 无底色, 按下才有反馈(热区 ≥ 88rpx) ---- */
.u-ico-btn {
  width: 88rpx;
  height: 88rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--primary);
  border-radius: 50%;
  line-height: 1;
  flex-shrink: 0;
}

.u-ico-btn:active {
  background: rgba(59, 130, 246, 0.10);
}

.u-ico-btn-soft {
  width: 64rpx;
  height: 64rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 32rpx;
}

/* ============================================================
   页面头部: 浅蓝软底 + 细描边(替代旧紫渐变卡)
   ============================================================ */

.page-hero {
  margin: 16rpx 24rpx 20rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--radius-card);
  background: var(--hero-bg);
  border: var(--bw-card) solid var(--hero-border);
  color: var(--text-primary);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ph-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.ph-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--hero-title);
  text-shadow: none;
}

.ph-sub {
  font-size: 24rpx;
  color: var(--hero-sub);
}

.ph-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  flex-shrink: 0;
}

.ph-refresh:active { background: var(--bg-card); }

/* ============================================================
   弹窗
   ============================================================ */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.modal-card {
  width: 600rpx;
  max-height: 80vh;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 40rpx;
  overflow-y: auto;
  box-shadow: var(--shadow-pop);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.modal-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.modal-buttons button {
  flex: 1;
}

/* ============================================================
   卡片族统一: 白底 + 细描边(各页细节样式见各自 wxss)
   ============================================================ */

.batch-card, .course-card, .indicator-card, .sem-card,
.sc-cet, .sem-gpa-card, .exam-card, .countdown-card,
.setting-card, .login-card, .tool-card, .modal-card {
  background: var(--bg-card);
}

/* ============================================================
   加载动画
   ============================================================ */

.spin {
  animation: ico-spin 1s linear infinite;
}

@keyframes ico-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 底部安全区 */
.page-safe-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
