{
    "containerPort": 80,
    "minNum": 1,
    "maxNum": 1,
    "cpu": 1,
    "mem": 2,
    "policyType": "cpu",
    "policyThreshold": 60,
    "policyDetails": [
        {"PolicyType": "cpu", "PolicyThreshold": 60},
        {"PolicyType": "mem", "PolicyThreshold": 60}
    ],
    "envParams": {
        "FREE_CLASSROOM_PREWARM": "1",
        "MIGRATIONS_AUTO": "1",
        "CAPTCHA_OCR_MODEL_PATH": "/app/common.onnx",
        "ONNXRUNTIME_SHARED_LIBRARY_PATH": "/app/libonnxruntime.so"
    },
    "customLogs": "stdout",
    "initialDelaySeconds": 10,
    "dataBaseName": "flask_demo",
    "executeSQLs": [
        "CREATE DATABASE IF NOT EXISTS flask_demo;"
    ]
}
