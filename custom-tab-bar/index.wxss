/* 自定义 tabBar — 图标 + 文字(主流校园/课程表 App 与微信原生 tabBar 的做法)
   选中项: 主色图标 + 主色文字; 未选中: 灰图标 + 灰文字 */

.tab-bar {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: calc(10rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  display: flex;
  overflow: hidden;
  background: rgba(255, 255, 255, .78);
  border: 1rpx solid rgba(255, 255, 255, .84);
  border-radius: 28rpx;
  -webkit-backdrop-filter: blur(28rpx) saturate(180%);
  backdrop-filter: blur(28rpx) saturate(180%);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, .14);
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 94rpx;
  padding: 8rpx 0 6rpx;
  transition: color var(--motion-fast) var(--ease-standard),
              transform var(--motion-fast) var(--ease-standard);
}

.tab-bar-item:active {
  opacity: .78;
  transform: translateY(1rpx);
}

/* 图标容器: 只负责对齐, 不再画圆形底 */
.tab-emoji-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 46rpx;
  border-radius: 14rpx;
  transition: background-color var(--motion-base) var(--ease-standard);
}

.tab-ico {
  width: 44rpx;
  height: 44rpx;
}

/* 文字标签: 选中变主色加粗 */
.tab-text {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.3;
  color: var(--text-hint);
  font-family: var(--font-display);
}

.tab-bar-item.on .tab-text {
  color: var(--primary);
  font-weight: 600;
}

.tab-bar-item.on .tab-emoji-wrap {
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 6rpx 18rpx rgba(37, 99, 235, .14);
  animation: tabPop var(--motion-slow) var(--ease-spring);
}

@keyframes tabPop {
  0% { transform: scale(.9) translateY(2rpx); }
  62% { transform: scale(1.08) translateY(-1rpx); }
  100% { transform: scale(1) translateY(0); }
}
