.tab-bar {
  position: absolute;
  right: 16rpx;
  bottom: calc(14rpx + env(safe-area-inset-bottom));
  left: 16rpx;
  z-index: 999;
  display: flex;
  height: 92rpx;
  overflow: hidden;
  border: 1rpx solid var(--glass-line);
  border-radius: 24rpx;
  background: var(--glass-bg-strong);
  box-shadow: var(--glass-shadow);
  -webkit-backdrop-filter: blur(24rpx) saturate(150%);
  backdrop-filter: blur(24rpx) saturate(150%);
}

.tab-bar-item {
  position: relative;
  display: flex;
  min-height: 92rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 6rpx;
  color: var(--text-hint);
  transition: color var(--motion-fast) var(--ease-standard),
              transform var(--motion-fast) var(--ease-spring);
}

.tab-bar-item:active {
  color: var(--primary);
  transform: scale(.96);
}

.tab-emoji-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 44rpx;
  border-radius: 14rpx;
  transition: background-color var(--motion-base) var(--ease-standard),
              transform var(--motion-base) var(--ease-spring);
}

.tab-ico {
  width: 40rpx;
  height: 40rpx;
}

.tab-text {
  margin-top: 5rpx;
  color: inherit;
  font-family: var(--font-body);
  font-size: 21rpx;
  line-height: 1.2;
}

.tab-bar-item.on {
  color: var(--primary);
  font-weight: 650;
}

.tab-bar-item.on .tab-emoji-wrap {
  background: var(--primary-soft);
  transform: translateY(-1rpx);
}

.tab-active-line {
  position: absolute;
  right: 50%;
  bottom: 4rpx;
  width: 24rpx;
  height: 5rpx;
  border-radius: var(--radius-pill);
  background: var(--primary);
  transform: translateX(50%);
  animation: tab-line-in var(--motion-base) var(--ease-spring) both;
}

@keyframes tab-line-in {
  from { opacity: 0; transform: translateX(50%) scaleX(.4); }
  to { opacity: 1; transform: translateX(50%) scaleX(1); }
}

@media (max-width: 360px) {
  .tab-bar { right: 12rpx; left: 12rpx; }
  .tab-text { font-size: 20rpx; }
}
