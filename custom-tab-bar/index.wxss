/* 自定义 tabBar — 图标 + 文字(主流校园/课程表 App 与微信原生 tabBar 的做法)
   选中项: 主色图标 + 主色文字; 未选中: 灰图标 + 灰文字 */

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: var(--bg-card);
  border-top: 1rpx solid var(--line);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 10rpx;
}

.tab-bar-item:active { opacity: 0.7; }

/* 图标容器: 只负责对齐, 不再画圆形底 */
.tab-emoji-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.tab-ico {
  width: 44rpx;
  height: 44rpx;
}

/* 文字标签: 选中变主色加粗 */
.tab-text {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.3;
  color: var(--text-hint);
  font-family: var(--font-display);
}

.tab-bar-item.on .tab-text {
  color: var(--primary);
  font-weight: 600;
}
