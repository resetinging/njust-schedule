<!-- 自定义 tabBar -->
<view class="tab-bar">
  <view class="tab-bar-item"
        wx:for="{{list}}" wx:key="pagePath"
        data-index="{{index}}" bindtap="onTap">
    <text wx:if="{{item.emoji}}" class="tab-emoji">{{item.emoji}}</text>
    <image wx:else class="tab-icon"
           src="{{selected === index ? item.selectedIconPath : item.iconPath}}" />
    <text class="tab-text {{selected === index ? 'active' : ''}}">{{item.text}}</text>
  </view>
</view>
