<!-- 成绩查询视图组件 — 网页版布局(绩点大卡 + 学期绩点明细 + 成绩明细), 保留小程序风格 -->
<view class="container view-root">

  <!-- 滚动内容区(scroll-view 内滚; 刷新走按钮) -->
  <scroll-view class="view-scroll" scroll-y>

    <!-- ============ 研究生成绩: 学分进度 + 明细(不算绩点) ============ -->
    <block wx:if="{{isGraduate && !loading}}">
      <!-- 学分进度大卡（与本科成绩页同款样式） -->
      <view class="gpa-hero">
        <view class="hero-top">
          <view class="hero-gpa-wrap">
            <text class="hero-gpa">{{yjsTotal.earned || 0}}</text>
            <text class="hero-label">已修学分 · 要求 {{yjsTotal.required || '-'}} · 培养计划 {{yjsTotal.planned || '-'}}</text>
          </view>
          <view class="hero-refresh tap {{refreshing ? 'spin' : ''}}" bindtap="onRefreshYjsGrades">
            <icon name="refresh" size="34" color="#2563EB" />
          </view>
        </view>
      </view>

      <!-- 学分进度胶囊（与本科成绩页同款） -->
      <view class="stat-pills">
        <view class="pill" wx:for="{{yjsStats}}" wx:key="name">
          <text class="pill-label">{{item.name}}</text>
          <text class="pill-value">{{item.earned}}</text>
        </view>
      </view>

      <!-- 成绩明细（列头由研究生系统在出成绩后一并返回） -->
      <view class="card">
        <view class="yjs-tr" wx:for="{{yjsRows}}" wx:key="i">
          <text class="yjs-td" wx:for="{{item.cells}}" wx:for-item="cell" wx:key="*this">{{cell}}</text>
        </view>
        <view class="yjs-hint" wx:if="{{!yjsRows.length}}">暂无成绩记录</view>
      </view>
      <view class="yjs-note">研究生成绩不含绩点计算；点右上角 🔄 从研究生系统获取</view>
    </block>

    <!-- 空状态（卡片式） -->
    <empty-state wx:if="{{!loading && empty && !isGraduate}}"
                 icon="📋"
                 title="{{errorMsg || '暂无成绩数据'}}"
                 desc="{{semester || '当前学期'}} 暂时没有成绩，可从教务系统获取"
                 action-text="{{refreshing ? '刷新中…' : '从教务获取成绩'}}"
                 bind:action="onRefreshGrades" />

    <block wx:if="{{!loading && !empty && !isGraduate}}">

      <!-- ============ 绩点大卡（浅蓝软底 + 细描边） ============ -->
      <view class="gpa-hero">
        <view class="hero-top">
          <view class="hero-gpa-wrap">
            <text class="hero-gpa {{stats.gpaClass}}">{{stats.gpa}}</text>
            <text class="hero-label">{{stats.mode === 'baoyan' ? '保研 GPA' : '综测 GPA'}}</text>
          </view>
          <view class="hero-refresh tap {{refreshing ? 'spin' : ''}}" bindtap="onRefreshGrades">
            <icon name="refresh" size="34" color="#2563EB" />
          </view>
        </view>

        <!-- 绩点算法切换 -->
        <view class="mode-seg hero-mode">
          <view class="mode-indicator {{stats.mode === 'baoyan' ? 'right' : ''}}"></view>
          <text class="seg tap {{stats.mode === '' ? 'on' : ''}}" data-mode="" bindtap="onModeChange">综测</text>
          <text class="seg tap {{stats.mode === 'baoyan' ? 'on' : ''}}" data-mode="baoyan" bindtap="onModeChange">保研</text>
        </view>
      </view>

      <!-- 关键指标 -->
      <view class="metric-grid">
        <view class="metric-card">
          <text class="metric-value">{{stats.count}}</text>
          <text class="metric-label">已计课程</text>
        </view>
        <view class="metric-card">
          <text class="metric-value">{{stats.credits}}</text>
          <text class="metric-label">已计学分</text>
        </view>
        <view class="metric-card">
          <text class="metric-value">{{stats.avg}}</text>
          <text class="metric-label">平均分</text>
        </view>
      </view>

      <!-- ============ 四六级成绩条(点击刷新) ============ -->
      <view class="sc-cet tap" wx:if="{{stats.cet}}" bindtap="onRefreshCet">
        <view class="sc-cet-top">
          <text class="sc-cet-title">四六级成绩</text>
          <text class="sc-cet-date">{{stats.cet.date}}</text>
          <text class="sc-cet-refresh">🔄</text>
        </view>
        <view class="sc-cet-line">{{stats.cet.line}}</view>
      </view>

      <!-- ============ 各学期绩点明细 ============ -->
      <view class="sem-gpa-section" wx:if="{{semGroups.length > 0}}">
        <text class="section-title">各学期绩点明细</text>
        <scroll-view scroll-x class="sem-gpa-scroll">
          <view class="sem-gpa-grid">
            <view class="sem-gpa-card tap" wx:for="{{semGroups}}" wx:key="sem"
                  data-sem="{{item.sem}}" bindtap="onFold">
              <text class="sg-sem">{{item.sem}}</text>
              <text class="sg-gpa {{item.gpaClass}}">{{item.gpa}}</text>
              <text class="sg-sub">{{item.count}} 门{{item.avg !== '-' ? ' · 均分 ' + item.avg : ''}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- ============ 成绩明细（分学期卡片, 保留折叠 + 勾选） ============ -->
      <view class="detail-head">
        <text class="section-title">成绩明细</text>
      </view>

      <view class="sem-card" wx:for="{{semGroups}}" wx:key="sem" wx:for-item="grp">
        <!-- 学期头 -->
        <view class="sem-head tap" data-sem="{{grp.sem}}" bindtap="onFold">
          <text class="sem-ico">🎓</text>
          <text class="sem-name">{{grp.sem}}</text>
          <text class="sem-gpa-tag {{grp.gpaClass}}">GPA {{grp.gpa}}</text>
          <text class="sem-count">{{grp.count}} 门</text>
          <view class="sem-fold"><icon name="{{grp.folded ? 'next' : 'prev'}}" size="22" color="#64748B" /></view>
        </view>

        <!-- 课程列表 -->
        <block wx:if="{{!grp.folded}}">
          <view class="grade-row" wx:for="{{grp.courses}}" wx:key="id" wx:for-item="c">
            <view class="chk tap {{c.checked ? 'on' : ''}}" data-id="{{c.id}}" bindtap="onToggle">
              <text wx:if="{{c.checked}}">✓</text>
            </view>
            <view class="g-main">
              <text class="g-name">{{c.name}}</text>
              <text class="g-meta">{{c.meta}}</text>
            </view>
            <view class="g-score">{{c.score}}</view>
          </view>
        </block>
      </view>

    </block>

  </scroll-view>

  <!-- 加载弹窗(fixed, 放 scroll-view 外避免随滚动) -->
  <loading-modal visible="{{loading}}" title="加载成绩数据…" />

</view>
