/* 成绩查询页面样式 · 清透课堂: 白卡 + 细描边 + 分数胶囊 */

/* ============ 研究生成绩: 学分进度 + 明细(不算绩点) ============ */
.yjs-tr {
  display: flex; gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--line-soft);
}
.yjs-tr:last-child { border-bottom: none; }
.yjs-td { font-size: 12px; color: var(--text-primary); flex: 1; word-break: break-all; }
.yjs-td:first-child { flex: 1.6; }
.yjs-hint { font-size: 12px; color: var(--text-hint); text-align: center; padding: 14px 0; }
.yjs-note { font-size: 11px; color: var(--text-hint); text-align: center; margin-top: 12px; }

.container {
  padding-bottom: 40rpx;
  background: var(--bg-page);
}

/* ============ 绩点大卡: 浅蓝软底 + 细描边, 数值用墨色/语义色 ============ */
.gpa-hero {
  margin: 20rpx 24rpx 24rpx;
  border-radius: var(--radius-card);
  padding: 32rpx 28rpx 24rpx;
  background: var(--hero-bg);
  border: var(--bw-card) solid var(--hero-border);
  box-shadow: var(--shadow-card);
}

.hero-top {
  display: flex;
  align-items: flex-start;
}

.hero-gpa-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hero-gpa {
  font-size: 96rpx;
  font-weight: 800;
  color: var(--hero-title);
  line-height: 1.1;
  text-shadow: none;
  font-variant-numeric: tabular-nums;
  font-family: var(--font-display);
}

.hero-gpa.gpa-high { color: var(--gpa-high); }
.hero-gpa.gpa-mid { color: var(--gpa-mid); }
.hero-gpa.gpa-low { color: var(--gpa-low); }

.hero-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 刷新按钮: 浅底上的白色圆形图标 */
.hero-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  font-size: 30rpx;
  border-radius: 50%;
  background: var(--bg-card);
  color: var(--primary);
  flex-shrink: 0;
}

/* 统计胶囊行: 浅蓝底主色字, 一行三胶囊 */
.stat-pills {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx 24rpx;
}

.pill {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  background: var(--primary-soft);
  border-radius: var(--radius-pill);
  padding: 18rpx 12rpx 16rpx;
}

.pill-label {
  font-size: 22rpx;
  color: var(--text-hint);
}

.pill-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}

/* 模式切换 */
.mode-seg {
  display: flex;
  background: var(--bg-card);
  border: 1rpx solid var(--primary-line);
  border-radius: var(--radius-card);
  padding: 6rpx;
}

.hero-mode {
  margin-top: 24rpx;
}

.seg {
  flex: 1;
  text-align: center;
  padding: 12rpx 20rpx;
  font-size: 25rpx;
  color: var(--text-muted);
  border-radius: var(--radius-card);
}

.seg.on {
  background: var(--primary);
  color: var(--bg-card);
  font-weight: 700;
}

/* GPA 颜色类（数值语义色） */
.gpa-high { color: var(--success); }
.gpa-mid { color: var(--warning); }
.gpa-low { color: var(--danger); }

/* ============ 四六级行（独立卡） ============ */
.sc-cet {
  margin: 0 24rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 22rpx 26rpx;
  box-shadow: var(--shadow-card);
}

.sc-cet-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sc-cet-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.sc-cet-date {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-hint);
}

.sc-cet-refresh {
  font-size: 26rpx;
  color: var(--text-hint);
}

.sc-cet-line {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  padding-left: 44rpx;
}

/* ============ 各学期绩点明细 ============ */
.sem-gpa-section {
  margin: 0 24rpx 24rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-strong);
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

.sem-gpa-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.sem-gpa-grid {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.sem-gpa-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 200rpx;
  padding: 24rpx 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.sg-sem {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-muted);
}

.sg-gpa {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.sg-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

/* ============ 成绩明细区 ============ */
.detail-head {
  margin: 0 24rpx 8rpx;
}

/* ============ 勾选框 ============ */
.chk {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-chip);
  border: 3rpx solid var(--icon-faint);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--bg-card);
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.chk.on {
  background: var(--primary-dark);
  border-color: var(--primary-dark);
}

.chk.sm { width: 34rpx; height: 34rpx; font-size: 22rpx; }

/* ============ 分学期卡片 ============ */
.sem-card {
  margin: 0 24rpx 20rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 24rpx 28rpx 8rpx;
  box-shadow: var(--shadow-card);
}

.sem-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0 16rpx;
}

.sem-ico { font-size: 30rpx; }

.sem-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.sem-count {
  font-size: 25rpx;
  color: var(--text-hint);
}

.sem-gpa-tag {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-ctrl);
  background: var(--primary-soft);
  color: var(--primary-dark);
}

.sem-fold {
  font-size: 24rpx;
  color: var(--text-hint);
  padding: 0 6rpx;
}

.sem-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--primary-soft);
  border-bottom: 1rpx solid var(--primary-soft);
}

.ss-tag { font-size: 28rpx; }

.ss-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.ss-avg {
  font-size: 25rpx;
  color: var(--text-hint);
}

/* ============ 课程行 ============ */
.grade-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.grade-row:last-child { border-bottom: none; }

.g-main {
  flex: 1;
  min-width: 0;
}

.g-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.g-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-hint);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 分数胶囊 */
.g-score {
  flex-shrink: 0;
  min-width: 76rpx;
  text-align: center;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-ctrl);
  background: var(--primary);
  color: var(--bg-card);
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: var(--shadow-card);
}

/* 空状态 */
.empty-state {
  padding: 160rpx 40rpx;
  text-align: center;
}

.empty-state .icon { font-size: 100rpx; }
.empty-state .text {
  font-size: 28rpx;
  color: var(--text-hint);
  margin: 20rpx 0 32rpx;
}

/* ============================================================
   风格统一 — 对齐课表: 白卡 + 细描边
   ============================================================ */
.sem-card, .sc-cet, .sem-gpa-card {
  border: var(--bw-card) solid var(--line);
}


/* 组件根/滚动区 */
.view-root {
  height: 100%;
  box-sizing: border-box;
}
.view-scroll {
  height: 100%;
}

/* 宿主节点高度(swiper-item 内撑满, 保证内部 100% 高度链有效) */
:host {
  display: block;
  height: 100%;
}
