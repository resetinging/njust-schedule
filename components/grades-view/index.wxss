/* ==========================================================================
   成绩查询视图（本科 GPA / 分学期折叠 + 研究生学分明细）
   --------------------------------------------------------------------------
   · 颜色 / 圆角 / 间距 / 阴影 / 动效全部取 styles/design-system.wxss 的令牌
   · 普通表面（gpa-hero / sem-card / sem-gpa-card / sc-cet / card）由基座定义，
     这里只补充本组件的布局与排版；无投影、无装饰圆、无整卡入场动画
   · 按压反馈交给基座 .tap，本地不重复声明按压态；动效仅保留切换器位移 180ms
   ========================================================================== */

/* ==========================================================================
   1. 结构与高度链（宿主 → scroll-view，保证 swiper-item 内可滚动）
   ========================================================================== */

:host {
  display: block;
  height: 100%;
}

.view-root {
  height: 100%;
  box-sizing: border-box;
}

.view-scroll {
  height: 100%;
  min-height: 0;
  -webkit-overflow-scrolling: touch;
}

.container {
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
}

/* ==========================================================================
   2. 成绩提醒条：单行可点，白底细边，低存在感
   ========================================================================== */

.grade-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  margin: var(--space-md) var(--space-page) var(--space-md);
  padding: var(--space-md) var(--space-lg);
  background: var(--bg-card);
  border: none;
  border-radius: var(--radius-island);
  box-shadow: var(--shadow-island);
}

.grade-sub-t {
  min-width: 0;
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.4;
}

/* 条内小操作：整条已绑定 .tap，这里只做视觉引导 */
.grade-sub-btn {
  flex: none;
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-pill);
  background: var(--primary);
  /* 品牌色反白字：基座暂无专用 on-brand 令牌，沿用既有 var(--bg-card) 写法 */
  color: var(--bg-card);
  font-size: var(--fs-sub);
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}

/* ==========================================================================
   3. GPA 概览：唯一的大数字焦点，其余信息退为次级
   ========================================================================== */

.gpa-hero {
  margin: var(--space-md) var(--space-page);
  padding: var(--space-lg);
  background: var(--bg-card);
  border: none;
  border-radius: var(--radius-island);
  box-shadow: var(--shadow-island);
}

.hero-top {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
}

.hero-gpa-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xxs);
}

.hero-gpa {
  color: var(--text-primary);
  font-family: var(--font-num);
  font-size: 80rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.05;
}

.hero-label {
  color: var(--text-muted);
  font-size: var(--fs-sub);
  line-height: 1.4;
}

/* 刷新：非圆形图标按钮，热区 88rpx（约 44 物理像素） */


/* 绩点算法切换：滑动的底板指示器，单次 180ms 位移，无投影 */
.mode-seg {
  position: relative;
  display: flex;
  overflow: hidden;
  padding: var(--space-xxs);
  background: var(--bg-sunken);
  border-radius: var(--radius-pill);
  border: none;
}

.hero-mode {
  margin-top: var(--space-md);
}

.mode-indicator {
  position: absolute;
  z-index: 0;
  top: var(--space-xxs);
  bottom: var(--space-xxs);
  left: var(--space-xxs);
  width: calc(50% - var(--space-xxs));
  border-radius: var(--radius-xs);
  background: var(--bg-card);
  transition: transform var(--motion-base) var(--ease-standard);
}

.mode-indicator.right {
  transform: translateX(100%);
}

.seg {
  position: relative;
  z-index: 1;
  flex: 1;
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-pill);
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.4;
  text-align: center;
}

.mode-seg .seg.on {
  color: var(--primary);
  font-weight: 700;
}

/* ==========================================================================
   4. 关键指标：一个分组表面，用分隔线区分三列（不逐格套卡片）
   ========================================================================== */

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 0 var(--space-page) var(--space-lg);
  background: var(--bg-card);
  border: none;
  border-radius: var(--radius-island);
  box-shadow: var(--shadow-island);
  overflow: hidden;
}

.metric-card {
  min-width: 0;
  padding: var(--space-md) var(--space-xs);
  text-align: center;
  border: none;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.metric-card + .metric-card {
  border-left: 1rpx solid var(--line-soft);
}

.metric-value {
  display: block;
  overflow: hidden;
  color: var(--text-primary);
  font-family: var(--font-num);
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-label {
  display: block;
  margin-top: var(--space-xxs);
  color: var(--text-muted);
  font-size: var(--fs-cap);
}

/* ==========================================================================
   5. 四六级成绩条：整条可点刷新，标题 / 日期 / 折算行同层级
   ========================================================================== */

.sc-cet {
  margin: 0 var(--space-page) var(--space-lg);
  padding: var(--space-md) var(--space-lg);
}

.sc-cet-top {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.sc-cet-title {
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
}

.sc-cet-date {
  margin-left: auto;
  color: var(--text-muted);
  font-size: var(--fs-sub);
}

/* 行内状态图标（整条可点，不单独计热区） */
.sc-cet-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.sc-cet-line {
  margin-top: var(--space-xs);
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.4;
}

/* ==========================================================================
   6. 各学期绩点：横向滚动的轻量卡，数值等宽对齐
   ========================================================================== */

.sem-gpa-section {
  margin: 0 var(--space-page) var(--space-lg);
}

/* 分区标题沿用基座 .section-title，这里只保证块级排布 */
.section-title {
  display: block;
}

.sem-gpa-scroll {
  margin-top: var(--space-md);
  white-space: nowrap;
}

.sem-gpa-grid {
  display: inline-flex;
  gap: var(--space-sm);
  padding-bottom: var(--space-xs);
}

.sem-gpa-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 184rpx;
  padding: var(--space-md) var(--space-lg);
}

.sg-sem {
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  font-weight: 600;
  line-height: 1.4;
}

.sg-gpa {
  margin-top: var(--space-xxs);
  color: var(--text-primary);
  font-family: var(--font-num);
  font-size: 44rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.sg-sub {
  margin-top: var(--space-xxs);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  line-height: 1.4;
}

/* ==========================================================================
   7. 成绩明细：分学期，保留折叠与勾选；行高稳定、长课程名最多两行
   ========================================================================== */

.detail-head {
  margin: 0 var(--space-page) var(--space-sm);
}

.sem-card {
  margin: 0 var(--space-page) var(--space-md);
  padding: var(--space-xs) var(--space-md);
  overflow: hidden;
}

/* 学期头：整行可点折叠，热区 ≥88rpx */
.sem-head {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-height: 88rpx;
  padding: var(--space-xs) 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.sem-ico {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.sem-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sem-count {
  flex: none;
  color: var(--text-muted);
  font-size: var(--fs-sub);
  font-variant-numeric: tabular-nums;
}

.sem-gpa-tag {
  flex: none;
  padding: var(--space-xxs) var(--space-sm);
  border-radius: var(--radius-chip);
  background: var(--bg-sunken);
  font-family: var(--font-num);
  font-size: var(--fs-cap);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* 展开/收起指示：随整行点击，不单独计热区 */
.sem-fold {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

/* 课程行：等宽分数列 + 最多两行课程名，行高稳定 */
.grade-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-height: 96rpx;
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.grade-row:last-child {
  border-bottom: 0;
}

.g-main {
  flex: 1;
  min-width: 0;
}

.g-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  overflow-wrap: anywhere;
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.4;
}

.g-meta {
  display: block;
  margin-top: var(--space-xxs);
  overflow: hidden;
  color: var(--text-muted);
  font-size: var(--fs-cap);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.g-score {
  flex: none;
  width: 96rpx;
  padding: var(--space-xs) 0;
  border-radius: var(--radius-chip);
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-family: var(--font-num);
  font-size: var(--fs-body);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-align: center;
}

/* 勾选框：视觉 48rpx，伪元素把有效热区扩到 88rpx；状态变化交给基座 .tap 过渡 */
.chk {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: var(--radius-chip);
  background: var(--bg-card);
  color: var(--bg-card);
  font-size: var(--fs-sub);
  font-weight: 700;
  line-height: 1;
}

.chk::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-chip);
  transform: translate(-50%, -50%);
}

.chk.on {
  border-color: var(--primary);
  background: var(--primary);
}

/* ==========================================================================
   8. 研究生成绩：学分进度复用分组表面；明细为行 + 分隔线，不套卡片
   ========================================================================== */

.stat-pills {
  display: flex;
  margin: 0 var(--space-page) var(--space-lg);
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  overflow: hidden;
}

.pill {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xxs);
  padding: var(--space-md) var(--space-xs);
}

.pill + .pill {
  border-left: 1rpx solid var(--line-soft);
}

.pill-label {
  max-width: 100%;
  overflow: hidden;
  color: var(--text-muted);
  font-size: var(--fs-cap);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pill-value {
  max-width: 100%;
  overflow: hidden;
  color: var(--text-primary);
  font-family: var(--font-num);
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 研究生明细卡：表面由基座 .card 提供，这里补边距 */
.card {
  margin: 0 var(--space-page) var(--space-sm);
  padding: var(--space-xs) var(--space-lg);
}

.yjs-tr {
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.yjs-tr:last-child {
  border-bottom: 0;
}

.yjs-td {
  flex: 1;
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--fs-sub);
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.yjs-td:first-child {
  flex: 1.6;
}

.yjs-hint {
  padding: var(--space-xl) 0;
  color: var(--text-muted);
  font-size: var(--fs-sub);
  text-align: center;
}

.yjs-note {
  margin-top: var(--space-sm);
  padding: 0 var(--space-page);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  line-height: 1.4;
  text-align: center;
}

/* ==========================================================================
   9. 绩点语义色（GPA / 学期 GPA / 学期标签共用）
   ========================================================================== */

.gpa-high {
  color: var(--success);
}

.gpa-mid {
  color: var(--warning);
}

.gpa-low {
  color: var(--danger);
}

/* ==========================================================================
   10. 减少动态效果：本地唯一的位移切换器直接跳转，加载旋转图标停止
   ========================================================================== */

@media (prefers-reduced-motion: reduce) {
  .mode-indicator {
    transition: none !important;
  }

  .spin {
    animation: none !important;
  }
}
