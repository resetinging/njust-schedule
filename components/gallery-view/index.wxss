/* 校园工具样式 · 清透课堂: 白卡 + 细描边 */

.container {
  height: 100vh;
  min-height: 0;
  overflow-y: auto;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 40rpx;
  background: var(--bg-page);
}

.custom-nav {
  position: sticky;
  top: 0;
  z-index: 80;
  background: rgba(243, 246, 244, .82);
  border-bottom: 1rpx solid rgba(228, 236, 232, .78);
  -webkit-backdrop-filter: blur(18rpx) saturate(160%);
  backdrop-filter: blur(18rpx) saturate(160%);
}

.custom-nav.is-embedded {
  padding-top: 0;
}

.custom-nav.is-embedded .custom-nav-title {
  display: none;
}

.custom-nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
  box-sizing: border-box;
}

.custom-back {
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  height: 58rpx;
  padding: 0 16rpx 0 12rpx;
  border: 1rpx solid rgba(255, 255, 255, .86);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .72);
  color: var(--text-secondary);
  font-size: 23rpx;
  font-weight: 650;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, .07);
}

.custom-back:active {
  transform: scale(.94);
}

.custom-nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 700;
  pointer-events: none;
}

.icon-back {
  display: inline-flex;
  transform: rotate(180deg);
}

.page-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx;
}

.page-loading .spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid var(--line-strong);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.page-loading .loading-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-hint);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.tool-list {
  padding: 20rpx 20rpx 40rpx;
}

.tool-card {
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.tool-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.tool-img {
  width: 100%;
  display: block;
  border-radius: var(--radius-ctrl);
  background: var(--bg-page);
}

.empty-state {
  padding: 160rpx 40rpx;
  text-align: center;
}

.empty-state .icon { font-size: 100rpx; }
.empty-state .text {
  font-size: 28rpx;
  color: var(--text-hint);
  margin: 20rpx 0 32rpx;
}

/* 诊断信息 */
.diag-tip {
  margin: 16rpx 24rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  color: var(--signal-deep);
  background: var(--signal-soft);
  border-radius: var(--radius-ctrl);
  word-break: break-all;
}
