/* ==========================================================================
   校园图鉴（校历 / 校区地图照片墙）
   --------------------------------------------------------------------------
   · 白卡 + 细边线 + 16rpx 圆角，无投影、无装饰圆、无渐变
   · 两列图文卡片：统一页面边距、卡片内边距、标题基线与图片圆角；
     图片按真实比例展示，点击仍走 wx.previewImage 预览，不裁剪、不替换真实资产
   · 返回按钮有效热区 88rpx；按压反馈由基座 .tap 提供，组件内不再自定义
   ========================================================================== */

.container {
  height: 100vh;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom));
  background: var(--bg-page);
}

/* 固定顶栏：使用实色面，不叠毛玻璃，滚动时与内容区分干净 */
.custom-nav {
  position: sticky;
  top: 0;
  z-index: 80;
  background: var(--bg-card);
  border-bottom: var(--bw-card) solid var(--line);
}

.custom-nav.is-embedded {
  padding-top: 0;
}

.custom-nav.is-embedded .custom-nav-title {
  display: none;
}

.custom-nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  padding-left: var(--space-xs);
}

/* 返回：图标 + 文字，热区 88rpx（约 44px），左右留白与页面边距同源 */
.custom-back {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xxs);
  min-height: 88rpx;
  padding: 0 var(--space-md) 0 var(--space-xs);
  border-radius: var(--radius-pill);
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  font-weight: 500;
}

.custom-back:active {
  background: var(--bg-hover);
}

.icon-back {
  display: inline-flex;
}

.custom-nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: var(--text-primary);
  font-size: var(--fs-page-title);
  font-weight: 700;
  pointer-events: none;
}

.page-loading {
  display: flex;
  min-height: 320rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl) var(--space-page);
}

.page-content {
  padding: 0 var(--space-page);
}

/* 两列图文索引：行间距与页面边距同源（8rpx 倍数），同排卡片等高对齐 */
.tool-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-md);
  margin-top: var(--space-md);
}

/* 表面（白底 / 细边线 / 16rpx 圆角 / 无投影）由基座 .tool-card 提供，
   这里只负责卡片内部排版，避免与 styles/design-system.wxss 重复声明。 */
.tool-card {
  display: flex;
  flex-direction: column;
  padding: var(--space-md);
}

/* 标题单行省略，保证两列卡片的图文起始位置一致 */
.tool-title {
  overflow: hidden;
  margin-bottom: var(--space-sm);
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-img {
  display: block;
  width: 100%;
  border-radius: var(--radius-group);
  background: var(--bg-sunken);
}

/* 诊断信息（仅出错时出现） */
.diag-tip {
  margin: var(--space-md) 0;
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-control);
  color: var(--warning);
  background: var(--warning-soft);
  font-size: var(--fs-cap);
  word-break: break-all;
}
