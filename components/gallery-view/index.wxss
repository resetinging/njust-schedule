/* 校园工具样式 · 清透课堂: 白卡 + 细描边 */

.container {
  height: 100vh;
  min-height: 0;
  overflow-y: auto;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 40rpx;
  background: var(--bg-page);
}

.custom-nav {
  position: sticky;
  top: 0;
  z-index: 80;
  background: var(--glass-bg);
  border-bottom: 1rpx solid var(--line);
  -webkit-backdrop-filter: blur(22rpx) saturate(150%);
  backdrop-filter: blur(22rpx) saturate(150%);
}

.custom-nav.is-embedded {
  padding-top: 0;
}

.custom-nav.is-embedded .custom-nav-title {
  display: none;
}

.custom-nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
  box-sizing: border-box;
}

.custom-back {
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  height: 54rpx;
  padding: 0 16rpx 0 12rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
  background: var(--glass-bg-strong);
  color: var(--text-secondary);
  font-size: 23rpx;
  font-weight: 650;
  box-shadow: var(--shadow-card);
}

.custom-back:active {
  transform: scale(.94);
}

.custom-nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 700;
  pointer-events: none;
}

.icon-back {
  display: inline-flex;
}

.page-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx;
}

.page-loading .loading-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-hint);
}

.tool-list {
  padding: 20rpx 20rpx 40rpx;
}

.tool-card {
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.tool-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.tool-img {
  width: 100%;
  display: block;
  border-radius: var(--radius-ctrl);
  background: var(--bg-page);
}

.empty-state {
  padding: 160rpx 40rpx;
  text-align: center;
}

.empty-state .icon { font-size: 100rpx; }
.empty-state .text {
  font-size: 28rpx;
  color: var(--text-hint);
  margin: 20rpx 0 32rpx;
}

/* 诊断信息 */
.diag-tip {
  margin: 16rpx 24rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  color: var(--signal-deep);
  background: var(--signal-soft);
  border-radius: var(--radius-ctrl);
  word-break: break-all;
}

/* Layout pass: a two-column image index keeps the tool page scannable. */
.page-content {
  padding-left: 20rpx;
  padding-right: 20rpx;
}

.tool-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin: 16rpx 0 0;
}

.tool-card {
  margin: 0;
  border-radius: 18rpx;
  box-shadow: var(--shadow-soft);
}

/* Gallery shares the same compact navigation and two-column scan rhythm. */
.custom-nav {
  background: rgba(245, 247, 249, .84);
  border-bottom-color: var(--line);
  -webkit-backdrop-filter: blur(24rpx) saturate(145%);
  backdrop-filter: blur(24rpx) saturate(145%);
}

.custom-back {
  min-height: 56rpx;
  height: 56rpx;
  border-color: var(--line);
  background: var(--surface-tint-strong);
  box-shadow: var(--shadow-soft);
}

.tool-card {
  padding: 16rpx;
  background: var(--surface-tint-strong);
  border-color: var(--line);
  transition: transform var(--motion-base) var(--ease-spring),
              box-shadow var(--motion-base) var(--ease-standard);
}

.tool-card:active {
  transform: scale(.975);
  box-shadow: 0 5rpx 16rpx rgba(15, 23, 42, .045);
}

.tool-title {
  margin-bottom: 12rpx;
  font-size: 27rpx;
}
