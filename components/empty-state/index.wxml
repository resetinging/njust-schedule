<view class="es-wrap">
  <view class="es-card">
    <t-empty icon="{{iconName}}">
      <view slot="description" class="es-copy">
        <view class="es-title">{{title}}</view>
        <text class="es-desc" wx:if="{{desc}}">{{desc}}</text>
      </view>
      <t-button wx:if="{{showAction && actionText}}" slot="action" theme="primary"
                variant="base" size="medium" bind:tap="onAction">{{actionText}}</t-button>
    </t-empty>
  </view>
</view>
