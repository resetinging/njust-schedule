/* 卡片式空状态: 白卡 + 细描边 + 淡蓝图标圆底 */

.es-wrap {
  display: flex;
  justify-content: center;
  padding: 40rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.es-card {
  width: 100%;
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  padding: 52rpx 36rpx 44rpx;
  box-shadow: none;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.es-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-soft);
  border: 1rpx solid var(--primary-line);
  border-radius: 28rpx;
}

.es-icon {
  font-size: 60rpx;
}

.es-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-strong);
}

.es-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  text-align: center;
  line-height: 1.5;
}

/* 操作按钮: 纯色主色 */
.es-btn {
  margin-top: 32rpx;
  width: auto;
  min-width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 48rpx;
  background: var(--primary);
  color: var(--bg-card);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-ctrl);
  border: none;
  box-sizing: border-box;
}

.es-btn::after { border: none; }

:host {
  display: block;
}
