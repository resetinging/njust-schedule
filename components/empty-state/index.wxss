/* 卡片式空状态: 白卡 + 细描边 + 淡蓝图标圆底 */

.es-wrap {
  display: flex;
  justify-content: center;
  padding: 40rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.es-card {
  width: 100%;
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  padding: 52rpx 36rpx 44rpx;
  box-shadow: none;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.es-card {
  --td-empty-icon-color: var(--primary);
  --td-empty-description-margin-top: 20rpx;
  --td-empty-action-margin-top: 28rpx;
}

.es-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.es-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-strong);
}

.es-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  text-align: center;
  line-height: 1.5;
}

/* 操作按钮: 纯色主色 */
:host {
  display: block;
}
