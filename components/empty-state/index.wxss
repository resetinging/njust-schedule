/* ==========================================================================
   卡片式空状态
   --------------------------------------------------------------------------
   · 轻量对齐：居中、正文字号 28rpx / 次级 24rpx、8rpx 倍数间距、16rpx 圆角
   · 白卡 + 细边线，无厚投影；图标与说明交给 TDesign t-empty
   · 图标颜色继承基座 --td-empty-icon-color（中性淡色），不再单独强调
   ========================================================================== */

:host {
  display: block;
}

.es-wrap {
  display: flex;
  justify-content: center;
  padding: var(--space-xl) var(--space-page);
  box-sizing: border-box;
}

.es-card {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: var(--space-xl) var(--space-lg) var(--space-lg);
  border: none;
  border-radius: var(--radius-island);
  background: var(--bg-card);
  box-sizing: border-box;
  --td-empty-description-margin-top: var(--space-md);
  --td-empty-action-margin-top: var(--space-lg);
  box-shadow: var(--shadow-island);
}

.es-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.es-title {
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}

.es-desc {
  margin-top: var(--space-xs);
  color: var(--text-hint);
  font-size: var(--fs-sub);
  line-height: 1.6;
  text-align: center;
}
