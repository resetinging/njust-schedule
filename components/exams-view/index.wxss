/* ==========================================================================
   考试安排（exams-view）
   --------------------------------------------------------------------------
   · 表面材质统一来自 styles/design-system.wxss：
     .card / .exam-card / .countdown-card（白底 + 细边线 + 16rpx 圆角 + 无投影）
   · 本文件只负责布局、层级、状态与间距；颜色 / 圆角 / 阴影 / 动效一律引用令牌
   · 状态用纯色语义表达：临近考试用 --warning，失败才用 --danger；无渐变、无装饰圆
   · 按压反馈由基座 .tap 提供，页面不再自定义 transform / opacity 按压
   ========================================================================== */

.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  background: var(--bg-page);
}

.view-root {
  height: 100%;
  box-sizing: border-box;
}

/* 保持 100% 高度链：宿主 swiper-item → container → scroll-view */
.view-scroll {
  height: 100%;
  min-height: 0;
  -webkit-overflow-scrolling: touch;
}

:host {
  display: block;
  height: 100%;
}

/* ==========================================================================
   考前提醒（订阅消息）：整条可点，热区 88rpx；点一次 +1 条额度
   ========================================================================== */

.exam-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  gap: var(--space-md);
  margin: var(--space-md) var(--space-page) 0;
  padding: 0 var(--space-lg);
  border: none;
  border-radius: var(--radius-island);
  background: var(--bg-card);
  box-shadow: var(--shadow-island);
}

.exam-sub-t {
  flex: 1;
  min-width: 0;
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.4;
}

.exam-sub-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  min-height: 56rpx;
  padding: 0 var(--space-lg);
  border-radius: var(--radius-pill);
  background: var(--primary);
  color: var(--bg-card);
  font-size: var(--fs-sub);
  font-weight: 600;
  line-height: 1;
}

/* ==========================================================================
   倒计时卡片（横向滚动）
   ========================================================================== */

.countdown-scroll {
  padding: 0 var(--space-page) var(--space-sm);
  white-space: nowrap;
}

.countdown-row {
  display: inline-flex;
  gap: var(--space-sm);
  padding: var(--space-xxs) 0;
}

/* 白底细边框卡片由基座 .countdown-card 提供，这里只补布局与状态色 */
.countdown-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 176rpx;
  padding: var(--space-md) var(--space-sm);
  white-space: normal;
  border: none;
  border-radius: var(--radius-island);
  background: var(--bg-card);
  box-shadow: var(--shadow-island);
}

.cd-bignum {
  font-size: 48rpx;
  line-height: 1.1;
  color: var(--text-primary);
}

.cd-label {
  margin-top: var(--space-xxs);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  line-height: 1.4;
}

.cd-course {
  max-width: 200rpx;
  margin-top: var(--space-sm);
  overflow: hidden;
  color: var(--text-primary);
  font-size: var(--fs-sub);
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  text-overflow: ellipsis;
}

.cd-date {
  margin-top: var(--space-xxs);
  color: var(--text-hint);
  font-size: var(--fs-cap);
  line-height: 1.4;
}

/* ≤3 天：提醒色淡底；≤7 天：白底提醒色数字。状态同时有文字标签，不只靠颜色 */
.countdown-card.urgent {
  border-color: var(--warning-line);
  background: var(--warning-soft);
}

.countdown-card.urgent .cd-bignum,
.countdown-card.urgent .cd-label {
  color: var(--warning);
}

.countdown-card.warning {
  border-color: var(--warning-line);
  background: var(--bg-card);
}

.countdown-card.warning .cd-bignum {
  color: var(--warning);
}

/* 已结束：中性下沉面 + 提示色文字，不用整体透明度压暗可读性 */
.countdown-card.done {
  border-color: var(--line);
  background: var(--bg-sunken);
}

.countdown-card.done .cd-bignum,
.countdown-card.done .cd-label,
.countdown-card.done .cd-course,
.countdown-card.done .cd-date {
  color: var(--text-hint);
}

/* 进行中：品牌淡底 + 品牌数字，与“已结束/未开始”形成区分 */
.countdown-card.ongoing {
  border-color: var(--primary-line);
  background: var(--primary-soft);
}

.countdown-card.ongoing .cd-bignum,
.countdown-card.ongoing .cd-label {
  color: var(--primary);
}

/* ==========================================================================
   考试列表：日期分组头 + 考试卡片
   课程名 28rpx/主文字色 → 时间/地点/状态 24rpx/次级文字色，层级统一
   ========================================================================== */

.exam-scroll {
  padding: 0 var(--space-page) var(--space-lg);
}

/* 已结束分组可点折叠：整行热区 ≥ 88rpx，按压反馈交给基座 .tap */
.date-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  gap: var(--space-sm);
  padding: var(--space-sm) 0 var(--space-xs);
}

.date-title {
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--fs-section);
  font-weight: 700;
  line-height: 1.4;
}

.date-right {
  display: flex;
  flex: none;
  align-items: center;
  gap: var(--space-sm);
}

.date-urgency {
  padding: var(--space-xxs) var(--space-sm);
  border-radius: var(--radius-chip);
  background: var(--bg-sunken);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  font-weight: 600;
  line-height: 1.5;
}

.date-urgency.urgent {
  background: var(--warning-soft);
  color: var(--warning);
}

.date-urgency.warning {
  color: var(--warning);
}

.date-urgency.done {
  background: var(--bg-sunken);
  color: var(--text-hint);
}

.date-urgency.ongoing {
  background: var(--primary-soft);
  color: var(--primary);
}

.date-urgency.unknown {
  background: var(--warning-soft);
  color: var(--warning);
}

.collapse-arrow {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xxs);
  padding: var(--space-xxs) var(--space-xs);
  border: var(--bw-ctrl) solid var(--line);
  border-radius: var(--radius-chip);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  line-height: 1.5;
}

.exam-card {
  padding: var(--space-md) var(--space-lg);
  margin-bottom: var(--space-sm);
}

.exam-card.exam-urgent {
  border-left: 4rpx solid var(--warning);
}

.exam-card.exam-warning {
  border-left: 4rpx solid var(--warning-light);
}

.exam-card.exam-done {
  background: var(--bg-sunken);
}

.exam-card.exam-done .exam-course {
  color: var(--text-secondary);
}

.exam-card.exam-done .meta-item {
  color: var(--text-hint);
}

/* 进行中：品牌色左边线 + 白底，提示“正在考试” */
.exam-card.exam-ongoing {
  border-left: 4rpx solid var(--primary);
}

/* 时间无法判断：警告色左边线，保守显示“时间待定” */
.exam-card.exam-unknown {
  border-left: 4rpx solid var(--warning-line);
}

/* 卡片头：课程名 + 自身状态徽章（不继承同日第一场的状态） */
.exam-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs);
}

.exam-state {
  flex: 0 0 auto;
  max-width: 52%;
  padding: 2rpx var(--space-sm);
  border-radius: var(--radius-pill);
  background: var(--bg-sunken);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  font-weight: 600;
  line-height: 1.4;
  text-align: right;
  white-space: normal;
  word-break: break-word;
}

.exam-state.is-upcoming {
  background: var(--success-soft);
  color: var(--success);
}

.exam-state.is-ongoing {
  background: var(--primary-soft);
  color: var(--primary);
}

.exam-state.is-done {
  background: var(--bg-sunken);
  color: var(--text-hint);
}

.exam-state.is-unknown {
  background: var(--warning-soft);
  color: var(--warning);
}

.exam-course {
  flex: 1 1 auto;
  min-width: 0;
  margin-bottom: 0;
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.4;
  word-break: break-word;
}

.exam-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs) var(--space-lg);
}

.meta-item {
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.4;
}

/* ==========================================================================
   研究生：考试信息表（只读，本地优先 + 手动刷新）
   ========================================================================== */

.card {
  margin: var(--space-md) var(--space-page) 0;
  padding: var(--space-xs) var(--space-lg);
}

.yjs-tr {
  display: flex;
  gap: var(--space-md);
  padding: var(--space-md) 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.yjs-tr:last-child {
  border-bottom: none;
}

.yjs-td {
  flex: 1;
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--fs-sub);
  line-height: 1.5;
  word-break: break-all;
}

.yjs-td:first-child {
  flex: 1.6;
}

.yjs-hint {
  padding: var(--space-xl) 0;
  color: var(--text-muted);
  font-size: var(--fs-sub);
  text-align: center;
}

.yjs-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  min-height: 88rpx;
  margin: var(--space-md) var(--space-page) 0;
  border-radius: var(--radius-control);
  background: var(--primary);
  color: var(--bg-card);
  font-size: 30rpx;
  font-weight: 600;
}

.yjs-note {
  margin: var(--space-sm) var(--space-page);
  color: var(--text-hint);
  font-size: var(--fs-cap);
  line-height: 1.5;
  text-align: center;
}

/* 页面内不定义独立动效（按压走 .tap、加载走基座 .spin）；
   保留减少动效兜底，避免将来新增过渡时漏配 */
@media (prefers-reduced-motion: reduce) {
  .exam-sub,
  .exam-sub-btn,
  .countdown-card,
  .exam-card,
  .date-header,
  .yjs-refresh {
    animation-duration: .01ms;
    transition-duration: .01ms;
  }
}
