/* ==========================================================================
   考试安排（exams-view）
   --------------------------------------------------------------------------
   · 表面材质统一来自 styles/design-system.wxss：
     .card / .exam-card / .countdown-card（白底 + 细边线 + 16rpx 圆角 + 无投影）
   · 本文件只负责布局、层级、状态与间距；颜色 / 圆角 / 阴影 / 动效一律引用令牌
   · 状态用纯色语义表达：临近考试用 --warning，失败才用 --danger；无渐变、无装饰圆
   · 按压反馈由基座 .tap 提供，页面不再自定义 transform / opacity 按压
   ========================================================================== */

.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  background: var(--bg-page);
}

.view-root {
  height: 100%;
  box-sizing: border-box;
}

/* 保持 100% 高度链：宿主 swiper-item → container → scroll-view */
.view-scroll {
  height: 100%;
  min-height: 0;
  -webkit-overflow-scrolling: touch;
}

:host {
  display: block;
  height: 100%;
}

/* ==========================================================================
   考前提醒（订阅消息）：整条可点，热区 88rpx；点一次 +1 条额度
   ========================================================================== */

.exam-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  gap: var(--space-md);
  margin: var(--space-md) var(--space-page) 0;
  padding: 0 var(--space-lg);
  border: none;
  border-radius: var(--radius-island);
  background: var(--bg-card);
  box-shadow: var(--shadow-island);
}

.exam-sub-t {
  flex: 1;
  min-width: 0;
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.4;
}

.exam-sub-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  min-height: 56rpx;
  padding: 0 var(--space-lg);
  border-radius: var(--radius-pill);
  background: var(--primary);
  color: var(--bg-card);
  font-size: var(--fs-sub);
  font-weight: 600;
  line-height: 1;
}

/* ==========================================================================
   顶部摘要 + 最近考试主卡
   ========================================================================== */

.exam-summary {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin: var(--space-md) var(--space-page) 0;
  padding: var(--space-md) 0;
}

.summary-main {
  flex: 1;
  min-width: 0;
}

.summary-title-line {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-width: 0;
}

.summary-title {
  color: var(--text-primary);
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.3;
}

.summary-count {
  flex: none;
  padding: 3rpx var(--space-sm);
  border-radius: var(--radius-pill);
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: var(--fs-cap);
  font-weight: 700;
  line-height: 1.5;
}

.summary-semester {
  display: block;
  margin-top: var(--space-xxs);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  line-height: 1.45;
}

.summary-refresh {
  flex: none;
}

.featured-exam {
  margin: 0 var(--space-page) var(--space-lg);
  padding: var(--space-lg);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-island);
  background: var(--bg-card);
  box-shadow: var(--shadow-island);
}

.featured-exam.urgent {
  border-color: var(--warning-line);
  background: var(--warning-soft);
}

.featured-exam.warning {
  border-color: var(--warning-line);
}

.featured-exam.ongoing {
  border-color: var(--primary-line);
  background: var(--primary-soft);
}

.featured-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: flex-start;
  gap: var(--space-sm);
}

.featured-state {
  max-width: 190rpx;
  color: var(--text-muted);
  font-size: var(--fs-cap);
  font-weight: 600;
  line-height: 1.4;
  text-align: right;
  word-break: break-word;
}

.featured-exam.urgent .featured-state {
  color: var(--warning);
}

.featured-exam.warning .featured-state {
  color: var(--warning);
}

.featured-exam.ongoing .featured-state {
  color: var(--primary);
}

.featured-course {
  display: block;
  min-width: 0;
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  word-break: break-word;
}

.featured-seat {
  display: inline-flex;
  align-items: flex-start;
  justify-content: flex-end;
  max-width: 190rpx;
  min-width: 0;
  gap: 6rpx;
  color: var(--primary);
}

.featured-seat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 40rpx;
  flex: none;
}

.featured-seat-value {
  min-width: 0;
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: right;
  word-break: break-word;
}

.featured-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs) var(--space-lg);
  margin-top: var(--space-md);
}

.featured-detail {
  display: inline-flex;
  align-items: flex-start;
  flex: 1 1 240rpx;
  min-width: 0;
  gap: 6rpx;
  color: var(--text-secondary);
}

.featured-detail-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 36rpx;
  flex: none;
}

.featured-detail-value {
  min-width: 0;
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.5;
  word-break: break-word;
}

/* ==========================================================================
   日期时间轴 + 考试卡片
   ========================================================================== */

.exam-timeline {
  padding: 0 var(--space-page) var(--space-lg);
}

.timeline-group {
  display: grid;
  grid-template-columns: 24rpx minmax(0, 1fr);
  gap: var(--space-sm);
}

.timeline-rail {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding-top: 31rpx;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  flex: none;
  border: 3rpx solid var(--bg-page);
  border-radius: 50%;
  background: var(--text-hint);
  box-sizing: content-box;
}

.timeline-dot.urgent,
.timeline-dot.warning,
.timeline-dot.unknown {
  background: var(--warning);
}

.timeline-dot.ongoing {
  background: var(--primary);
}

.timeline-dot.done {
  background: var(--line-strong);
}

.timeline-line {
  width: 2rpx;
  flex: 1;
  min-height: 24rpx;
  margin-top: var(--space-xs);
  background: var(--line);
}

.timeline-body {
  min-width: 0;
}

/* 已结束分组可点折叠：整行热区 ≥ 88rpx，按压反馈交给基座 .tap */
.date-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  gap: var(--space-sm);
  padding: var(--space-sm) 0 var(--space-xs);
}

.date-main {
  display: flex;
  align-items: baseline;
  min-width: 0;
  gap: var(--space-sm);
}

.date-title {
  flex: none;
  color: var(--text-primary);
  font-family: var(--font-num);
  font-size: var(--fs-section);
  font-weight: 700;
  line-height: 1.4;
}

.date-weekday {
  min-width: 0;
  overflow: hidden;
  color: var(--text-muted);
  font-size: var(--fs-cap);
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-right {
  display: flex;
  flex: none;
  align-items: center;
  gap: var(--space-sm);
}

.date-urgency {
  padding: var(--space-xxs) var(--space-sm);
  border-radius: var(--radius-chip);
  background: var(--bg-sunken);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  font-weight: 600;
  line-height: 1.5;
}

.date-urgency.urgent {
  background: var(--warning-soft);
  color: var(--warning);
}

.date-urgency.warning {
  color: var(--warning);
}

.date-urgency.done {
  background: var(--bg-sunken);
  color: var(--text-hint);
}

.date-urgency.ongoing {
  background: var(--primary-soft);
  color: var(--primary);
}

.date-urgency.unknown {
  background: var(--warning-soft);
  color: var(--warning);
}

.collapse-arrow {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xxs);
  padding: var(--space-xxs) var(--space-xs);
  border: var(--bw-ctrl) solid var(--line);
  border-radius: var(--radius-chip);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  line-height: 1.5;
}

.exam-card {
  padding: 18rpx var(--space-lg);
  margin-bottom: var(--space-sm);
}

.exam-card.exam-urgent {
  border-left: 4rpx solid var(--warning);
}

.exam-card.exam-warning {
  border-left: 4rpx solid var(--warning-light);
}

.exam-card.exam-done .exam-course {
  color: var(--text-secondary);
}

.exam-card.exam-done .exam-detail-value,
.exam-card.exam-done .exam-seat-value,
.exam-card.exam-done .exam-type {
  color: var(--text-hint);
}

/* 进行中：品牌色左边线 + 白底，提示“正在考试” */
.exam-card.exam-ongoing {
  border-left: 4rpx solid var(--primary);
}

/* 时间无法判断：警告色左边线，保守显示“时间待定” */
.exam-card.exam-unknown {
  border-left: 4rpx solid var(--warning-line);
}

/* 卡片头：课程名 + 自身状态徽章（不继承同日第一场的状态） */
.exam-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: flex-start;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.exam-state {
  max-width: 190rpx;
  color: var(--text-muted);
  font-size: var(--fs-cap);
  font-weight: 600;
  line-height: 1.4;
  text-align: right;
  white-space: normal;
  word-break: break-word;
}

.exam-state.is-upcoming {
  color: var(--success);
}

.exam-state.is-ongoing {
  color: var(--primary);
}

.exam-state.is-done {
  color: var(--text-hint);
}

.exam-state.is-unknown {
  color: var(--warning);
}

.exam-course {
  min-width: 0;
  margin-bottom: 0;
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.4;
  word-break: break-word;
}

.exam-seat {
  display: inline-flex;
  align-items: flex-start;
  justify-content: flex-end;
  max-width: 190rpx;
  min-width: 0;
  gap: 6rpx;
}

.exam-seat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 34rpx;
  flex: none;
}

.exam-seat-value {
  min-width: 0;
  color: var(--primary);
  font-size: var(--fs-sub);
  font-weight: 700;
  line-height: 1.4;
  text-align: right;
  word-break: break-word;
}

.exam-details {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-xs) var(--space-lg);
}

.exam-detail {
  display: flex;
  align-items: flex-start;
  min-width: 0;
  gap: 6rpx;
}

.exam-detail-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22rpx;
  height: 36rpx;
  flex: none;
}

.exam-detail-value {
  min-width: 0;
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.5;
  word-break: break-word;
}

.exam-type {
  display: block;
  margin-top: var(--space-xs);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  line-height: 1.45;
}

/* ==========================================================================
   研究生：考试信息表（只读，本地优先 + 手动刷新）
   ========================================================================== */

.card {
  margin: var(--space-md) var(--space-page) 0;
  padding: var(--space-xs) var(--space-lg);
}

.yjs-tr {
  display: flex;
  gap: var(--space-md);
  padding: var(--space-md) 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.yjs-tr:last-child {
  border-bottom: none;
}

.yjs-td {
  flex: 1;
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--fs-sub);
  line-height: 1.5;
  word-break: break-all;
}

.yjs-td:first-child {
  flex: 1.6;
}

.yjs-hint {
  padding: var(--space-xl) 0;
  color: var(--text-muted);
  font-size: var(--fs-sub);
  text-align: center;
}

.yjs-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  min-height: 88rpx;
  margin: var(--space-md) var(--space-page) 0;
  border-radius: var(--radius-control);
  background: var(--primary);
  color: var(--bg-card);
  font-size: 30rpx;
  font-weight: 600;
}

.yjs-note {
  margin: var(--space-sm) var(--space-page);
  color: var(--text-hint);
  font-size: var(--fs-cap);
  line-height: 1.5;
  text-align: center;
}

/* 页面内不定义独立动效（按压走 .tap、加载走基座 .spin）；
   保留减少动效兜底，避免将来新增过渡时漏配 */
@media (prefers-reduced-motion: reduce) {
  .exam-sub,
  .exam-sub-btn,
  .countdown-card,
  .exam-card,
  .date-header,
  .yjs-refresh {
    animation-duration: .01ms;
    transition-duration: .01ms;
  }
}
