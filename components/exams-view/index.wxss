/* 考试页面样式 — 参考桌面端 exams 设计 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}

/* 顶部操作栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  background: var(--bg-card);
}

.refresh-btn {
  color: var(--primary);
  font-weight: bold;
}

/* ==============================
   倒计时卡片（横向滚动）
   ============================== */

.countdown-scroll {
  white-space: nowrap;
  padding: 0 24rpx 12rpx;
}

.countdown-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.countdown-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 180rpx;
  padding: 20rpx 16rpx;
  border-radius: var(--radius-ctrl);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
  white-space: normal;
}

.countdown-card.urgent {
  background: linear-gradient(135deg, var(--danger-soft), var(--danger-soft));
  border: 2rpx solid var(--danger);
}

.countdown-card.warning {
  background: linear-gradient(135deg, var(--warning-soft), var(--warning-soft));
  border: 2rpx solid var(--warning);
}

.countdown-card.done {
  opacity: 0.5;
}

.cd-bignum {
  font-size: 56rpx;
  font-weight: bold;
  line-height: 1;
}

.countdown-card.urgent .cd-bignum { color: var(--danger); }
.countdown-card.warning .cd-bignum { color: var(--signal); }
.countdown-card.done .cd-bignum { color: var(--text-hint); }

.cd-label {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.countdown-card.urgent .cd-label { color: var(--danger); }
.countdown-card.warning .cd-label { color: var(--signal); }

.cd-course {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-top: 12rpx;
  text-align: center;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cd-date {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

/* ==============================
   考试列表（按日期分组）
   ============================== */

.exam-scroll {
  flex: 1;
  padding: 0 24rpx 24rpx;
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 8rpx 12rpx;
}

.date-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-secondary);
}

.date-urgency {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-card);
  font-weight: bold;
}

.date-urgency.urgent {
  background: var(--danger-soft);
  color: var(--danger);
}

.date-urgency.warning {
  background: var(--warning-soft);
  color: var(--signal);
}

.date-urgency.done {
  background: var(--bg-page);
  color: var(--text-hint);
}

/* 考试卡片 */
.exam-card {
  background: var(--bg-card);
  border-radius: var(--radius-ctrl);
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-card);
}

.exam-card.exam-urgent {
  border-top-width: 8rpx;
  border-top-color: var(--danger);
}

.exam-card.exam-warning {
  border-top-width: 8rpx;
  border-top-color: var(--warning);
}

.exam-course {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.exam-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ==============================
   公共
   ============================== */

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-hint);
}

.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-state .text {
  font-size: 28rpx;
}

.btn-primary {
  display: block;
  width: 70%;
  margin: 0 auto;
  padding: 20rpx;
  background: var(--primary);
  color: var(--bg-card);
  border-radius: var(--radius-ctrl);
  box-shadow: var(--shadow-card);
  font-size: 28rpx;
  text-align: center;
  border: none;
}

/* ==== 优化: 已结束分组折叠 ==== */
.date-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.collapse-arrow {
  font-size: 20rpx;
  color: var(--text-hint);
  padding: 4rpx 8rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-chip);
}
.exam-done {
  opacity: 0.55;
}

/* ============================================================
   V2 视觉升级 — 考试页
   ============================================================ */
.top-bar {
  background: var(--bg-card);
  border-radius: 0 0 var(--radius-card) var(--radius-card);
  box-shadow: var(--shadow-card);
  margin-bottom: 8rpx;
}
.refresh-btn {
  background: var(--primary-soft);
  border-radius: var(--radius-card);
  padding: 8rpx 24rpx;
}

/* 倒计时卡质感: 常态浅底细线, 紧急/临近用顶部色条 */
.countdown-card {
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  background: var(--bg-sunken);
  border: var(--bw-card) solid var(--line);
}
.countdown-card.urgent {
  background: linear-gradient(135deg, var(--danger) 0%, var(--signal) 100%);
  border: none;
  color: var(--bg-card);
}
.countdown-card.urgent .cd-bignum { color: var(--bg-card); }
.countdown-card.urgent .cd-label { color: rgba(255, 255, 255, 0.9); }
.countdown-card.urgent .cd-course { color: var(--bg-card); }
.countdown-card.warning {
  background: linear-gradient(135deg, var(--warning) 0%, var(--warning-light) 100%);
  border: none;
  color: var(--bg-card);
}
.countdown-card.warning .cd-bignum { color: var(--bg-card); }
.countdown-card.warning .cd-label { color: rgba(255, 255, 255, 0.9); }
.countdown-card.warning .cd-course { color: var(--bg-card); }

/* 日期头卡片化 */
.date-header {
  background: var(--bg-card);
  border-radius: var(--radius-ctrl);
  margin: 16rpx 20rpx 4rpx;
  padding: 16rpx 24rpx;
  box-shadow: var(--shadow-card);
}
.exam-scroll { padding-bottom: 20rpx; }
.exam-card {
  border-radius: var(--radius-ctrl);
  box-shadow: var(--shadow-card);
  margin: 8rpx 20rpx 0;
}


/* ============================================================
   V3 视觉升级 — 考试页头部 Hero
   ============================================================ */
.top-bar {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary) 60%, var(--primary) 100%);
  color: var(--bg-card);
  padding: 24rpx 28rpx;
}
.refresh-btn {
  background: var(--bg-card);
  color: var(--primary);
  box-shadow: var(--shadow-card);
}


/* ============================================================
   V4 简约风格 — 考试页
   ============================================================ */
.top-bar {
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
  border-bottom: 1rpx solid var(--line);
  color: var(--text-secondary);
}
.refresh-btn {
  background: var(--primary-soft);
  color: var(--primary);
  box-shadow: var(--shadow-card);
}

/* 倒计时卡: 白底 + 色条, 去渐变 */
.countdown-card {
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  box-shadow: var(--shadow-card);
}
.countdown-card.urgent {
  background: var(--signal-soft);
  border: 1rpx solid var(--signal-line);
}
.countdown-card.urgent .cd-bignum { color: var(--danger); }
.countdown-card.urgent .cd-label { color: var(--danger); }
.countdown-card.urgent .cd-course { color: var(--text-secondary); }
.countdown-card.warning {
  background: var(--warning-soft);
  border: 1rpx solid var(--warning-line);
}
.countdown-card.warning .cd-bignum { color: var(--signal); }
.countdown-card.warning .cd-label { color: var(--signal); }
.countdown-card.warning .cd-course { color: var(--text-secondary); }

.date-header {
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}
.exam-card {
  box-shadow: var(--shadow-card);
}


/* ============================================================
   V6 桌面端同款 — 考试页
   ============================================================ */
/* 倒计时卡: 桌面 白卡 + 顶边状态色 + 状态淡底 */
.countdown-card {
  background: var(--bg-card);
  border: none;
  border-top: 8rpx solid transparent;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  padding: 32rpx;
}
.countdown-card.urgent {
  background: var(--danger-soft);
  border-top-color: var(--danger);
}
.countdown-card.urgent .cd-bignum { color: var(--danger); }
.countdown-card.urgent .cd-label { color: var(--danger); }
.countdown-card.urgent .cd-course { color: var(--text-primary); }
.countdown-card.warning {
  background: var(--warning-soft);
  border-top-color: var(--warning);
}
.countdown-card.warning .cd-bignum { color: var(--warning); }
.countdown-card.warning .cd-label { color: var(--warning); }
.countdown-card.warning .cd-course { color: var(--text-primary); }
.countdown-card.done { opacity: 0.6; }
.cd-bignum { font-size: 80rpx; }
.cd-label { font-size: 26rpx; }
.cd-course { font-size: 28rpx; }

/* 日期头: 桌面 .exam-date-header 非卡片, 页面上直接排 */
.date-header {
  background: none;
  border-radius: 0;
  box-shadow: var(--shadow-card);
  margin: 20rpx 24rpx 10rpx;
  padding: 0;
  gap: 12rpx;
}
.date-title { font-weight: 700; color: var(--text-primary); }

/* 考试卡: 桌面 .exam-card radius 8px / padding 14px 18px / mb 8px */
.exam-card {
  background: var(--bg-card);
  border-radius: var(--radius-ctrl);
  padding: 28rpx 36rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: var(--shadow-card);
}
.exam-course { font-weight: 700; font-size: 32rpx; color: var(--text-primary); margin-bottom: 12rpx; }
.meta-item { color: var(--text-hint); }

/* 刷新按钮 → 桌面 btn-primary 亮蓝 */
.refresh-btn {
  background: var(--primary);
  color: var(--bg-card);
  border-radius: var(--radius-ctrl);
  padding: 10rpx 24rpx;
}


/* ============================================================
   风格统一 — 对齐课表(白底圆角小方框 + 细边框 + 统一字体色)
   ============================================================ */
.exam-card, .countdown-card {
  border-radius: var(--radius-card);
  border: var(--bw-card) solid var(--line);
  box-shadow: var(--shadow-card);
}
.exam-course { color: var(--text-primary); }
.meta-item { color: var(--text-hint); }
.date-title { color: var(--text-primary); }
.cd-label, .cd-date { color: var(--text-hint); }
.cd-course { color: var(--text-primary); }
.date-urgency.done { background: var(--primary-soft); color: var(--text-hint); }

/* 倒计时卡统一白底, 状态仅用顶部色条区分 */
.countdown-card.urgent {
  background: var(--bg-card);
  border-top-width: 8rpx;
  border-top-color: var(--danger);
}
.countdown-card.warning {
  background: var(--bg-card);
  border-top-width: 8rpx;
  border-top-color: var(--warning);
}
.countdown-card.done { opacity: 0.6; }


/* 组件根/滚动区 */
.view-root {
  height: 100%;
  box-sizing: border-box;
}
.view-scroll {
  height: 100%;
}

/* 考前提醒(订阅消息): 顶部条, 点一次 = +1 条额度 */
.exam-sub {
  margin: 16rpx 24rpx 0;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--hero-bg, #EEF4FF);
  border: 2rpx solid var(--hero-border, #DCE7FF);
  border-radius: var(--radius-card, 20rpx);
}

.exam-sub-t {
  font-size: 26rpx;
  color: var(--text-secondary, #334155);
}

.exam-sub-btn {
  flex: none;
  margin-left: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--brand, #2563EB);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

/* 宿主节点高度(swiper-item 内撑满, 保证内部 100% 高度链有效) */
:host {
  display: block;
  height: 100%;
}
/* ============ 研究生: 考试信息表 ============ */
.yjs-tr {
  display: flex; gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--line-soft);
}
.yjs-tr:last-child { border-bottom: none; }
.yjs-td { font-size: 12px; color: var(--text-primary); flex: 1; word-break: break-all; }
.yjs-td:first-child { flex: 1.6; }
.yjs-hint { font-size: 12px; color: var(--text-hint); text-align: center; padding: 18px 0; }
.yjs-refresh {
  margin-top: 12px; height: 40px; border-radius: 20px; background: var(--primary);
  color: var(--bg-card); font-size: 14px; display: flex; align-items: center;
  justify-content: center;
}
.yjs-note { font-size: 11px; color: var(--text-hint); text-align: center; margin-top: 10px; }
