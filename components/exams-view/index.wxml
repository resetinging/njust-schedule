<!-- 考试安排视图组件 -->
<view class="container view-root">

  <!-- 滚动内容区(scroll-view 内滚; 刷新走顶部按钮) -->
  <scroll-view class="view-scroll" scroll-y>

    <!-- 考前提醒(订阅消息): 点一次 +1 条额度; 未开启时显示引导 -->
    <view class="exam-sub tap" wx:if="{{!isGraduate && subExam}}" bindtap="onSubscribeExamTap">
      <text class="exam-sub-t">{{subExam.quota > 0 ? ('考前 1 天提醒已开启 · 剩余 ' + subExam.quota + ' 条') : '考前 1 天提醒我（点一下开启）'}}</text>
      <text class="exam-sub-btn">{{subExam.quota > 0 ? '＋1' : '开启'}}</text>
    </view>

    <!-- ============ 研究生: 考试信息(本地优先, 手动刷新) ============ -->
    <block wx:if="{{isGraduate}}">
      <view class="card">
        <view class="yjs-tr" wx:for="{{examRows}}" wx:key="i">
          <text class="yjs-td" wx:for="{{item.cells}}" wx:for-item="cell" wx:key="*this">{{cell}}</text>
        </view>
      <view class="yjs-hint" wx:if="{{!examRows.length}}">暂无考试安排，点击刷新获取最新安排</view>
      </view>
      <view class="yjs-refresh tap {{refreshing ? 'is-busy' : ''}}" bindtap="onRefreshYjsExams" aria-label="刷新研究生考试安排">
        <icon class="{{refreshing ? 'spin' : ''}}" name="refresh" size="28" color="#FFFFFF" />
        <text>{{refreshing ? '获取中…' : '刷新考试安排'}}</text>
      </view>
      <view class="yjs-note">数据来自研究生系统「学期考试信息查询」</view>
    </block>

    <!-- 加载中 -->
    <empty-state wx:if="{{loading && exams.length === 0 && !isGraduate}}"
                 icon="hourglass" title="加载中…" />

    <!-- 空状态 -->
    <empty-state wx:if="{{!loading && exams.length === 0 && !isGraduate}}"
                 icon="doc"
                 title="{{errorMsg || '暂无考试安排'}}"
                 desc="{{semester || '当前学期'}} 暂无考试安排，点击刷新获取最新安排"
                 action-text="刷新考试安排"
                 bind:action="onRefresh" />

    <!-- 有数据 -->
    <block wx:if="{{exams.length > 0 && !isGraduate}}">
      <!-- 顶部摘要 -->
      <view class="exam-summary">
        <view class="summary-main">
          <view class="summary-title-line">
            <text class="summary-title">考试安排</text>
            <text class="summary-count">{{pendingExamCount}} 场</text>
          </view>
          <text class="summary-semester">{{semester || '当前学期'}}</text>
        </view>
        <view class="summary-refresh refresh-action tap {{loading ? 'is-busy' : ''}}" bindtap="onRefresh" aria-label="刷新考试安排">
          <icon name="refresh" size="30" color="#6B7684" />
        </view>
      </view>

      <!-- 最近考试主卡 -->
      <view class="featured-exam {{featuredExam.cardClass}}" wx:if="{{featuredExam}}">
        <view class="featured-head">
          <text class="featured-course">{{featuredExam.course_name}}</text>
          <text class="featured-state">{{featuredExam.info.shortText}}</text>
          <view class="featured-seat" aria-label="座位 {{featuredExam.seat || '待定'}}">
            <view class="featured-seat-icon">
              <icon name="seat" size="28" color="#3157D5" />
            </view>
            <text class="featured-seat-value">{{featuredExam.seat || '待定'}}</text>
          </view>
        </view>
        <view class="featured-meta">
          <view class="featured-detail">
            <view class="featured-detail-icon">
              <icon name="clock" size="24" color="#6B7684" />
            </view>
            <text class="featured-detail-value">{{featuredExam.time || '时间待定'}}</text>
          </view>
          <view class="featured-detail">
            <view class="featured-detail-icon">
              <icon name="building" size="24" color="#6B7684" />
            </view>
            <text class="featured-detail-value">{{featuredExam.location || '地点待定'}}</text>
          </view>
        </view>
      </view>

      <!-- 日期时间轴 -->
      <view class="exam-timeline">
        <block wx:for="{{dayGroups}}" wx:key="date" wx:for-item="group">
          <view class="timeline-group {{group.urgency === 'done' ? 'is-done' : ''}}">
            <view class="timeline-rail">
              <view class="timeline-dot {{group.urgency}}"></view>
              <view class="timeline-line" wx:if="{{index < dayGroups.length - 1}}"></view>
            </view>
            <view class="timeline-body">
              <!-- 日期头部（已结束可折叠） -->
              <view class="date-header {{group.urgency === 'done' ? 'tap' : ''}}" data-date="{{group.date}}" data-done="{{group.urgency === 'done'}}" bindtap="onToggleGroup">
                <view class="date-main">
                  <text class="date-title">{{group.date}}</text>
                  <text class="date-weekday">{{group.weekday || '日期待定'}}</text>
                </view>
                <view class="date-right">
                  <text class="date-urgency {{group.urgency}}">{{group.urgencyText}}</text>
                  <view wx:if="{{group.urgency === 'done'}}" class="collapse-arrow">
                    <text>{{collapsedDates[group.date] ? '展开' : '收起'}}</text>
                    <icon name="{{collapsedDates[group.date] ? 'next' : 'prev'}}" size="18" color="#6B7684" />
                  </view>
                </view>
              </view>

              <!-- 考试卡片（已结束且折叠时隐藏） -->
              <block wx:if="{{!(group.urgency === 'done' && collapsedDates[group.date])}}">
                <view class="exam-card {{exam.cardClass}}"
                      wx:for="{{group.exams}}" wx:key="index" wx:for-item="exam">
                  <view class="exam-head">
                    <text class="exam-course">{{exam.course_name}}</text>
                    <text class="exam-state {{exam.statusClass}}">{{exam.shortStatusText}}</text>
                    <view class="exam-seat" aria-label="座位 {{exam.seat || '待定'}}">
                      <view class="exam-seat-icon">
                        <icon name="seat" size="24" color="{{exam.cardClass === 'exam-done' ? '#9AA4B0' : '#3157D5'}}" />
                      </view>
                      <text class="exam-seat-value">{{exam.seat || '待定'}}</text>
                    </view>
                  </view>
                  <view class="exam-details">
                    <view class="exam-detail">
                      <view class="exam-detail-icon">
                        <icon name="clock" size="22" color="{{exam.cardClass === 'exam-done' ? '#9AA4B0' : '#6B7684'}}" />
                      </view>
                      <text class="exam-detail-value">{{exam.time || '时间待定'}}</text>
                    </view>
                    <view class="exam-detail">
                      <view class="exam-detail-icon">
                        <icon name="building" size="22" color="{{exam.cardClass === 'exam-done' ? '#9AA4B0' : '#6B7684'}}" />
                      </view>
                      <text class="exam-detail-value">{{exam.location || '地点待定'}}</text>
                    </view>
                  </view>
                  <text class="exam-type" wx:if="{{exam.type && exam.type !== '期末考试'}}">{{exam.type}}</text>
                </view>
              </block>
            </view>
          </view>
        </block>
      </view>
    </block>

    <view id="slot-exams-bottom">
      <ad-slot unit-id="adunit-8f99eb551760e548"
               slot-id="slot-exams-bottom"
               page="exams"
               ad-type="native" />
    </view>

  </scroll-view>

</view>
