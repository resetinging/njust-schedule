<!-- 相对路径(组件内绝对路径不可靠); 路径直接拼, 不用 observer -->
<!-- 色调按传入色值就近取档: 图标是 PNG, 只有 4 档描边色 -->
<wxs module="ico">
module.exports.tone = function (c) {
  if (c === '#FFFFFF' || c === '#ffffff' || c === '#fff') return 'white'
  if (c === '#2563EB' || c === '#3157D5' || c === '#2544B5' ||
      c === '#5D79E0' || c === '#3B82F6' || c === '#60A5FA' ||
      c === '#2B4C7E' || c === '#3E6CB8' || c === '#6C63B8') return 'indigo'
  if (c === '#64748B' || c === '#475569') return 'slate'
  return 'grey'
}

module.exports.file = function (name, c) {
  var tone = module.exports.tone(c)
  // 部分线性图标当前只保留 slate 资源；这里做组件级兜底，
  // 避免旧页面或缓存继续请求不存在的 indigo/grey 文件。
  if (name === 'next' || name === 'prev' || name === 'back') return name + '-slate'
  if (name === 'hourglass' || name === 'clock') return name + '-slate'
  if (name === 'list') return 'list-slate'
  if (name === 'refresh' || name === 'sync') return tone === 'indigo' ? name + '-indigo' : name + '-slate'
  if (name === 'plus') return 'plus-indigo'
  if (name === 'more') return 'list-slate'
  if (name === 'edit' || name === 'trash') return 'doc-indigo'
  // 这两个图标没有 grey 资源；非主色档统一回退到已有的 slate 资源。
  if (name === 'search') return tone === 'white' ? 'search-white' : (tone === 'indigo' ? 'search-indigo' : 'search-slate')
  if (name === 'building') return tone === 'indigo' ? 'building-indigo' : 'building-slate'
  if (name === 'lock') return tone === 'indigo' ? 'user-indigo' : 'user-slate'
  if (name === 'link') return tone === 'indigo' ? 'grid-indigo' : 'grid-grey'
  if (name === 'close') return tone === 'indigo' ? 'close-indigo' : 'close-slate'
  if (name === 'clipboard' || name === 'chart' || name === 'award' ||
      name === 'doc' || name === 'image') return name + '-indigo'
  return name + '-' + tone
}
</wxs>
<image class="icon"
  src="../../static/icons/{{ico.file(name, color)}}.png"
  style="width: {{size}}rpx; height: {{size}}rpx;" mode="aspectFit" />
