<!-- 课表视图组件 -->
<view class="container view-root" wx:if="{{active}}">

  <!-- 滚动内容区(scroll-view 内滚; 刷新走右上角手动按钮) -->
  <scroll-view class="view-scroll" scroll-y>

    <!-- 顶栏第一行: 学期(可点切换) + 今天日期 -->
    <view class="topbar">
      <picker mode="selector" range="{{semesters}}" bindchange="onSemesterChange">
        <view class="tb-sem">{{semester || '选择学期'}}<text class="tb-caret">▾</text></view>
      </picker>
      <view class="tb-fav tap" aria-label="查询蹭课收藏" bindtap="onOpenAuditFavorites">
        <icon name="award" size="24" color="#B45309" />
        <text>收藏</text>
      </view>
      <text class="tb-today" wx:if="{{todayText}}">{{todayText}}</text>
    </view>

    <!-- 顶栏第二行: 周次导航 + 工具(切换/刷新/加号) -->
    <view class="weekbar">
      <view class="week-btn tap" bindtap="prevWeek">
        <icon class="ctrl-icon prev-icon" name="prev" size="26" color="#64748B" />
      </view>
      <!-- 点周次可快速跳周 -->
      <picker mode="selector" range="{{weekPickerRange}}" bindchange="onJumpWeek">
        <view class="week-label">
          <text class="week-main">{{currentWeek === actualWeek ? '第 ' + (currentWeek || 1) + ' 周 · 本周' : '第 ' + (currentWeek || 1) + ' 周'}}</text>
          <text class="week-range" wx:if="{{weekRange}}">{{weekRange}}</text>
        </view>
      </picker>
      <view class="week-btn tap" bindtap="nextWeek">
        <icon class="ctrl-icon next-icon" name="next" size="26" color="#64748B" />
      </view>

      <!-- 工具: 视图切换(图标显示"切过去的形态") / 刷新 / 加号 -->
      <view class="tb-acts">
        <view class="tb-toggle tap" data-mode="{{viewMode === 'grid' ? 'list' : 'grid'}}" bindtap="switchView">
          <icon class="ctrl-icon toggle-icon" name="{{viewMode === 'grid' ? 'list' : 'grid'}}" size="34" color="#64748B" />
        </view>
        <view class="refresh-btn tap {{loading ? 'spin' : ''}}" bindtap="onRefresh">
          <icon class="ctrl-icon refresh-icon" name="refresh" size="34" color="#64748B" />
        </view>
        <view class="u-ico-btn tap" bindtap="onAddCustom">
          <icon class="ctrl-icon plus-icon" name="plus" size="36" color="#2563EB" />
        </view>
      </view>
    </view>

    <!-- 周次相关内容: 切换周次时整体做滑入动画 -->
    <view class="week-body {{weekAnim}}">

    <!-- 今日课程卡片(仅本周显示): 下一节高亮 -->
    <view class="today-card" wx:if="{{today.show}}">
      <view class="today-head">
        <text class="today-title">今天 · {{today.weekday}}</text>
        <text class="today-count">{{today.count > 0 ? (today.count + ' 门课') : '没有课'}}</text>
      </view>
      <view class="today-empty" wx:if="{{today.count === 0}}">今天没有课，休息一下 🎉</view>
      <view class="today-row {{item.isNext ? 'on' : ''}}" wx:for="{{today.courses}}" wx:key="index">
        <view class="today-dot" style="background: {{item.bar}}"></view>
        <view class="today-main">
          <text class="today-name">{{item.name}}</text>
          <view class="today-sub">
            <text class="today-room" wx:if="{{item.room}}">{{item.room}}</text>
            <text class="today-time">{{item.period}}</text>
          </view>
        </view>
        <text class="today-next" wx:if="{{item.isNext}}">下一节</text>
      </view>
    </view>

    <!-- 网格视图(刷新时保留旧内容, 仅首次无数据才显示占位) -->
    <view class="grid-wrapper" wx:if="{{viewMode === 'grid' && filteredCourses.length > 0 && !(loading && courses.length === 0)}}">
      <week-grid
        courses="{{filteredCourses}}"
        currentWeek="{{currentWeek}}"
        actualWeek="{{actualWeek}}"
        firstWeekDate="{{firstWeekDate}}"
        todayDay="{{todayDay}}"
        bind:coursetap="onCourseTap"
      />
    </view>

    <!-- 列表视图(刷新时保留旧内容) -->
    <view class="list-wrapper" wx:if="{{viewMode === 'list' && !(loading && courses.length === 0)}}">
      <block wx:if="{{listDayGroups.length > 0}}">
        <view class="day-group" wx:for="{{listDayGroups}}" wx:key="day" wx:for-item="group">
          <view class="day-title">{{group.dayName}}</view>
          <view
            wx:for="{{group.courses}}"
            wx:key="index"
            wx:for-item="c"
            class="course-card tap {{c._audit ? 'audit' : ''}}"
            style="background: {{c._bg || '#E8F1FF'}}; border-left: 10rpx solid {{c._bar || '#2563EB'}};"
            bindtap="onCourseTap"
            data-course="{{c}}"
          >
              <view class="card-header">
                <text class="card-name" style="color: {{c._text}}">{{c.name}}</text>
                <text class="card-periods" style="color: {{c._text}}">{{c._periodLabel}}</text>
              </view>
              <view class="card-body">
                <text wx:if="{{c.teacher}}" class="card-teacher" style="color: {{c._text}}">{{c.teacher}}</text>
                <text wx:if="{{c.classroom}}" class="card-room" style="color: {{c._text}}">{{c.classroom}}</text>
              </view>
              <view class="card-footer">
                <text class="card-weeks" style="color: {{c._text}}">{{c.weeks || '1-18周'}}</text>
                <text class="card-badge" wx:if="{{c.week_type === 1}}">单周</text>
                <text class="card-badge even" wx:if="{{c.week_type === 2}}">双周</text>
                <text class="card-badge audit" wx:if="{{c._audit}}">蹭课</text>
              </view>
          </view>
        </view>
      </block>
      <empty-state wx:else
                   icon="🔍"
                   title="本周暂无课程"
                   desc="第 {{currentWeek || 1}} 周暂时没有课程安排" />
    </view>

    <!-- 网格视图空结果 -->
    <empty-state wx:if="{{viewMode === 'grid' && filteredCourses.length === 0 && courses.length > 0 && !loading}}"
                 icon="🔍"
                 title="本周暂无课程"
                 desc="第 {{currentWeek || 1}} 周暂时没有课程安排" />

    <!-- 加载中(仅无数据时显示) -->
    <empty-state wx:if="{{loading && courses.length === 0}}"
                 icon="⏳" title="加载中…" />

    <!-- 空状态 -->
    <empty-state wx:if="{{!loading && courses.length === 0}}"
                 icon="📅"
                 title="暂无课表数据"
                 desc="{{semester || '当前学期'}} 暂时没有课程，可从教务系统获取"
                 action-text="获取课表"
                 bind:action="onRefresh" />

    <view id="slot-schedule-bottom" class="analytics-slot-marker"></view>

    </view>
  </scroll-view>

  <!-- 课程详情弹窗(fixed, 放 scroll-view 外避免随滚动) -->
  <view class="modal-mask" wx:if="{{showDetail}}" bindtap="closeDetail">
    <view class="modal-card" catchtap="">
      <view class="modal-title">
        {{detailCourse.name}}
        <text class="modal-badge" wx:if="{{detailCourse.week_type === 1}}">单周</text>
        <text class="modal-badge even" wx:if="{{detailCourse.week_type === 2}}">双周</text>
      </view>
      <view class="modal-row">
        <text class="label">教师</text>
        <text class="m-value">{{detailCourse.teacher || '未指定'}}</text>
      </view>
      <view class="modal-row">
        <text class="label">教室</text>
        <text class="m-value">{{detailCourse.classroom || '未指定'}}</text>
      </view>
      <view class="modal-row">
        <text class="label">时间</text>
        <text class="m-value">{{detailCourse._dayName}} {{detailCourse._timeText}}</text>
      </view>
      <view class="modal-row">
        <text class="label">周次</text>
        <text class="m-value weeks-text">{{detailCourse._weeksText}}</text>
      </view>
      <view class="modal-row">
        <text class="label">学分</text>
        <text class="m-value">{{detailCourse.credits}}</text>
      </view>
      <view class="modal-row" wx:if="{{detailCourse.course_type || detailCourse.type}}">
        <text class="label">类型</text>
        <text class="m-value">{{detailCourse.course_type || detailCourse.type}}</text>
      </view>
      <!-- 自定义课程: 编辑 / 删除 -->
      <view class="modal-actions" wx:if="{{detailCourse._custom}}">
        <button class="u-btn u-btn-outline" bindtap="onEditCustom">编辑</button>
        <button class="u-btn u-btn-danger" data-cid="{{detailCourse._cid}}" bindtap="onDeleteCustom">删除</button>
      </view>
      <button class="u-btn u-btn-primary" style="margin-top:24rpx;width:100%;" bindtap="closeDetail">关闭</button>
    </view>
  </view>

  <!-- ============================================================ -->
  <!-- 自定义课程 添加/编辑弹窗(遮罩点击不关闭, 防误触丢失输入) -->
  <!-- ============================================================ -->
  <view class="modal-mask" wx:if="{{showCustomForm}}">
    <view class="modal-card cu-card" catchtap="">
      <view class="modal-title">{{formTitle}}</view>

      <view class="cu-field">
        <text class="cu-label">课程名 *</text>
        <input class="cu-input" value="{{formName}}" bindinput="onFormName" maxlength="30"
               placeholder="如：健身 / 日语自习" placeholder-class="cu-ph" />
      </view>
      <view class="cu-field">
        <text class="cu-label">教师</text>
        <input class="cu-input" value="{{formTeacher}}" bindinput="onFormTeacher" maxlength="20"
               placeholder="选填" placeholder-class="cu-ph" />
      </view>
      <view class="cu-field">
        <text class="cu-label">教室</text>
        <input class="cu-input" value="{{formClassroom}}" bindinput="onFormClassroom" maxlength="30"
               placeholder="选填" placeholder-class="cu-ph" />
      </view>

      <view class="cu-field">
        <text class="cu-label">星期</text>
        <picker mode="selector" range="{{dayOptions}}" value="{{formDayIdx}}" bindchange="onFormDay">
          <view class="cu-pick">{{dayOptions[formDayIdx]}} <view class="cu-arrow"><icon name="next" size="24" color="#64748B" /></view></view>
        </picker>
      </view>
      <view class="cu-field">
        <text class="cu-label">上课时间</text>
        <view class="cu-range">
          <picker mode="selector" range="{{periodOptions}}" value="{{formStartIdx}}" bindchange="onFormStart">
            <view class="cu-pick">{{periodOptions[formStartIdx]}}</view>
          </picker>
          <text class="cu-dash">—</text>
          <picker mode="selector" range="{{periodOptions}}" value="{{formEndIdx}}" bindchange="onFormEnd">
            <view class="cu-pick">{{periodOptions[formEndIdx]}}</view>
          </picker>
        </view>
      </view>
      <view class="cu-field">
        <text class="cu-label">周次类型</text>
        <picker mode="selector" range="{{weekTypeOptions}}" value="{{formTypeIdx}}" bindchange="onFormType">
          <view class="cu-pick">{{weekTypeOptions[formTypeIdx]}} <view class="cu-arrow"><icon name="next" size="24" color="#64748B" /></view></view>
        </picker>
      </view>
      <view class="cu-field">
        <text class="cu-label">周次范围</text>
        <view class="cu-range">
          <picker mode="selector" range="{{weekOptions}}" value="{{formWeekStartIdx}}" bindchange="onFormWeekStart">
            <view class="cu-pick">{{weekOptions[formWeekStartIdx]}}</view>
          </picker>
          <text class="cu-dash">至</text>
          <picker mode="selector" range="{{weekOptions}}" value="{{formWeekEndIdx}}" bindchange="onFormWeekEnd">
            <view class="cu-pick">{{weekOptions[formWeekEndIdx]}}</view>
          </picker>
        </view>
      </view>

      <view class="modal-actions">
        <button class="u-btn u-btn-outline" bindtap="closeCustomForm">取消</button>
        <button class="u-btn u-btn-primary" bindtap="onSaveCustom">保存</button>
      </view>
    </view>
  </view>

</view>
