:host {
  display: block;
  height: 100%;
  min-height: 0;
}

.container,
.view-root {
  display: flex;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  color: var(--text-primary);
  background: var(--bg-page);
}

.view-scroll {
  height: 100%;
  min-height: 0;
  -webkit-overflow-scrolling: touch;
}

.topbar,
.weekbar {
  display: flex;
  align-items: center;
  border: 1rpx solid var(--line);
  background: var(--glass-bg-strong);
  box-shadow: var(--shadow-card);
  -webkit-backdrop-filter: blur(18rpx) saturate(140%);
  backdrop-filter: blur(18rpx) saturate(140%);
}

.topbar {
  min-height: 68rpx;
  gap: 10rpx;
  margin: 12rpx 20rpx 0;
  padding: 8rpx 12rpx;
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  border-bottom: 0;
}

.topbar picker,
.weekbar picker {
  min-width: 0;
}

.topbar picker { flex-shrink: 1; }

.tb-sem {
  display: flex;
  align-items: center;
  max-width: 220rpx;
  gap: 4rpx;
  overflow: hidden;
  padding: 7rpx 12rpx;
  border-radius: var(--radius-control);
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 23rpx;
  font-weight: 650;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tb-caret {
  flex: none;
  margin-left: 3rpx;
  color: var(--text-muted);
  font-size: 16rpx;
}

.tb-today {
  flex: 1;
  color: var(--text-muted);
  font-family: var(--font-num);
  font-size: 21rpx;
  text-align: right;
  white-space: nowrap;
}

.tb-fav {
  display: inline-flex;
  align-items: center;
  flex: none;
  gap: 4rpx;
  padding: 7rpx 10rpx;
  border-radius: var(--radius-pill);
  color: var(--signal);
  background: var(--signal-soft);
  font-size: 21rpx;
  font-weight: 650;
}

.weekbar {
  min-height: 76rpx;
  gap: 4rpx;
  margin: 0 20rpx 12rpx;
  padding: 4rpx 6rpx 8rpx;
  border-top: 0;
  border-radius: 0 0 var(--radius-card) var(--radius-card);
}

.weekbar picker {
  flex: 1;
}

.week-btn,
.tb-toggle,
.refresh-btn,
.tb-acts .u-ico-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  flex: none;
  border-radius: 50%;
}

.week-btn:active,
.tb-toggle:active,
.refresh-btn:active,
.tb-acts .u-ico-btn:active {
  background: var(--primary-soft);
}

.prev-icon,
.next-icon,
.toggle-icon,
.refresh-icon,
.plus-icon {
  transition: transform var(--motion-base) var(--ease-spring);
}

.week-btn:active .prev-icon { transform: translateX(-5rpx) scale(.94); }
.week-btn:active .next-icon { transform: translateX(5rpx) scale(.94); }
.tb-toggle:active .toggle-icon { transform: rotate(12deg) scale(.92); }
.refresh-btn:active .refresh-icon { transform: rotate(180deg) scale(.92); }
.tb-acts .u-ico-btn:active .plus-icon { transform: rotate(90deg) scale(.92); }

.week-label {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: 0 4rpx;
  box-sizing: border-box;
  text-align: center;
  line-height: 1.3;
}

.week-main {
  max-width: 100%;
  overflow: hidden;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 750;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.week-range {
  color: var(--text-muted);
  font-family: var(--font-num);
  font-size: 20rpx;
  white-space: nowrap;
}

.tb-acts {
  display: flex;
  align-items: center;
  flex: none;
}

.week-body.from-right,
.week-body.from-left {
  animation-duration: 220ms;
  animation-timing-function: var(--ease-standard);
  animation-fill-mode: both;
}

.week-body.from-right { animation-name: week-in-right; }
.week-body.from-left { animation-name: week-in-left; }

@keyframes week-in-right {
  from { opacity: .5; transform: translateX(28rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes week-in-left {
  from { opacity: .5; transform: translateX(-28rpx); }
  to { opacity: 1; transform: translateX(0); }
}

.today-card,
.grid-wrapper {
  margin-right: 20rpx;
  margin-left: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.today-card {
  margin-bottom: 10rpx;
  padding: 16rpx 18rpx;
  background: #FFFBF3;
  border-color: #F1E2C5;
}

.today-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.today-title {
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 700;
}

.today-title::before {
  display: inline-block;
  width: 7rpx;
  height: 22rpx;
  margin-right: 9rpx;
  border-radius: var(--radius-pill);
  background: var(--signal);
  content: "";
  vertical-align: -3rpx;
}

.today-count,
.today-time {
  color: var(--text-muted);
  font-size: 21rpx;
}

.today-empty {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: 25rpx;
}

.today-row {
  display: flex;
  align-items: center;
  min-height: 52rpx;
  margin-top: 10rpx;
}

.today-row.on {
  margin-right: -8rpx;
  margin-left: -8rpx;
  padding: 8rpx;
  border-radius: var(--radius-control);
  background: var(--signal-soft);
}

.today-dot {
  width: 9rpx;
  height: 9rpx;
  flex: none;
  margin-right: 12rpx;
  border-radius: 50%;
}

.today-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.today-name {
  overflow: hidden;
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 650;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.today-sub {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 2rpx;
}

.today-room {
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 650;
}

.today-next {
  flex: none;
  margin-left: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-pill);
  color: var(--signal);
  background: #FFF0D4;
  font-size: 20rpx;
  font-weight: 700;
}

.grid-wrapper {
  margin-top: 8rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  background: var(--bg-card);
}

.list-wrapper {
  padding: 8rpx 20rpx 24rpx;
  overflow: visible;
}

.day-group {
  margin-bottom: 22rpx;
}

.day-title {
  margin-bottom: 10rpx;
  padding: 8rpx 4rpx 10rpx;
  border-bottom: 1rpx solid var(--line-soft);
  color: var(--text-secondary);
  font-size: 25rpx;
  font-weight: 700;
}

.course-card {
  margin-bottom: 10rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(24, 34, 48, .07);
  border-radius: var(--radius-control);
  box-shadow: var(--shadow-card);
  transition: transform var(--motion-base) var(--ease-spring),
              box-shadow var(--motion-base) var(--ease-standard);
}

.course-card:active { transform: scale(.98); }
.course-card.audit { border-style: dashed; }

.view-root.is-entering .topbar {
  animation: scheduleChromeIn 360ms var(--ease-spring) both;
}

.view-root.is-entering .weekbar {
  animation: scheduleChromeIn 380ms var(--ease-spring) 35ms both;
}

.view-root.is-entering .week-body {
  animation: scheduleBodyIn 430ms var(--ease-spring) 70ms both;
}

.view-root.is-entering .today-card {
  animation: scheduleItemIn 400ms var(--ease-spring) 120ms backwards;
}

.view-root.is-entering .grid-wrapper {
  animation: scheduleItemIn 420ms var(--ease-spring) 155ms backwards;
}

.view-root.is-entering .day-group {
  animation: scheduleItemIn 380ms var(--ease-spring) backwards;
}

.view-root.is-entering .day-group:nth-child(2) { animation-delay: 80ms; }
.view-root.is-entering .day-group:nth-child(3) { animation-delay: 120ms; }
.view-root.is-entering .day-group:nth-child(4) { animation-delay: 160ms; }
.view-root.is-entering .day-group:nth-child(5) { animation-delay: 200ms; }
.view-root.is-entering .day-group:nth-child(6) { animation-delay: 240ms; }
.view-root.is-entering .day-group:nth-child(7) { animation-delay: 280ms; }

@keyframes scheduleChromeIn {
  from { opacity: 0; transform: translateY(-12rpx) scale(.99); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes scheduleBodyIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes scheduleItemIn {
  0%   { opacity: 0; transform: translateY(16rpx) scale(.985); }
  70%  { opacity: 1; transform: translateY(-2rpx) scale(1.002); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

.card-header,
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-header { margin-bottom: 8rpx; }
.card-name { overflow: hidden; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.card-periods { margin-left: 12rpx; font-size: 22rpx; }
.card-body { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 8rpx; font-size: 23rpx; }
.card-teacher { opacity: .86; }
.card-room { font-size: 25rpx; font-weight: 650; }
.card-footer { justify-content: flex-start; gap: 10rpx; }
.card-weeks { color: var(--text-muted); font-size: 20rpx; }
.card-badge { padding: 3rpx 9rpx; border-radius: var(--radius-xs); color: var(--signal); background: var(--signal-soft); font-size: 19rpx; }
.card-badge.even { color: var(--primary); background: var(--primary-soft); }
.card-badge.audit { color: var(--success); background: var(--success-soft); }

.schedule-popup {
  --td-popup-bg-color: var(--glass-bg-strong);
  --td-popup-border-radius: var(--radius-panel);
  --td-popup-transition: all var(--motion-slow) var(--ease-standard);
}

.modal-card {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  padding: 30rpx 24rpx 28rpx;
  border-radius: var(--radius-panel) var(--radius-panel) 0 0;
  background: var(--glass-bg-strong);
  box-shadow: var(--shadow-sheet);
}

.modal-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--line-soft);
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 750;
  text-align: center;
}

.modal-badge { padding: 4rpx 10rpx; border-radius: var(--radius-xs); color: var(--signal); background: var(--signal-soft); font-size: 19rpx; }
.modal-badge.even { color: var(--primary); background: var(--primary-soft); }
.modal-row { display: flex; align-items: flex-start; justify-content: space-between; padding: 13rpx 0; border-bottom: 1rpx solid var(--line-soft); color: var(--text-primary); font-size: 26rpx; }
.modal-row .label { min-width: 88rpx; color: var(--text-muted); font-size: 22rpx; }
.modal-row .m-value { flex: 1; margin-left: 16rpx; color: var(--text-secondary); text-align: right; word-break: break-all; }
.weeks-text { word-break: break-all; }

.cu-card { max-height: 84vh; }
.cu-field { display: flex; align-items: center; gap: 12rpx; padding: 11rpx 0; }
.cu-label { width: 134rpx; flex: none; color: var(--text-muted); font-size: 24rpx; }
.cu-input,
.cu-pick { height: 68rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: var(--radius-control); background: var(--bg-sunken); font-size: 25rpx; }
.cu-input { min-width: 0; flex: 1; padding: 0 16rpx; }
.cu-pick { display: flex; align-items: center; justify-content: space-between; min-width: 220rpx; padding: 0 16rpx; color: var(--text-primary); line-height: 68rpx; }
.cu-ph { color: var(--text-hint); }
.cu-arrow { display: flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; }
.cu-range { display: flex; min-width: 0; flex: 1; align-items: center; gap: 10rpx; }
.cu-range .cu-pick { min-width: 0; flex: 1; justify-content: center; }
.cu-dash { color: var(--text-hint); }
.modal-actions { display: flex; gap: 12rpx; margin-top: 22rpx; }
.modal-actions .u-btn { min-width: 0; flex: 1; }

@media (max-width: 360px) {
  .topbar,
  .weekbar { margin-right: 14rpx; margin-left: 14rpx; }
  .today-card,
  .grid-wrapper { margin-right: 14rpx; margin-left: 14rpx; }
  .list-wrapper { padding-right: 14rpx; padding-left: 14rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .view-root.is-entering .topbar,
  .view-root.is-entering .weekbar,
  .view-root.is-entering .week-body,
  .view-root.is-entering .today-card,
  .view-root.is-entering .grid-wrapper,
  .view-root.is-entering .day-group {
    animation: none;
  }
}
