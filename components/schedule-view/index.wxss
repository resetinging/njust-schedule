/* ============================================================
   课表页 · 清透课堂
   顶栏不是卡片而是白底工具条; 颜色只留给课程块和"今天"
   ============================================================ */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}

.view-root {
  height: 100%;
  box-sizing: border-box;
}

.view-scroll {
  height: 100%;
}

/* 宿主节点高度(swiper-item 内撑满, 保证内部 100% 高度链有效) */
:host {
  display: block;
  height: 100%;
}

/* ============================================================
   顶栏: 第一行 学期 + 今天 / 第二行 周次 + 工具
   (两行都做薄, 比原来的"卡片+胶囊"省 ~40rpx)
   ============================================================ */

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 8rpx 20rpx;
  background: var(--bg-card);
}

.tb-today {
  font-size: 22rpx;
  color: var(--text-hint);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  font-family: var(--font-display);
}

.weekbar {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 2rpx 12rpx 6rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--line-soft);
}

/* picker 是 flex 子项: 学期允许压缩, 周次占满剩余宽度 */
.topbar picker { min-width: 0; flex-shrink: 1; }
.weekbar picker { flex: 1; min-width: 0; }

/* 学期: 浅蓝底小胶囊(可点开切换) */
.tb-sem {
  display: flex;
  align-items: center;
  gap: 4rpx;
  max-width: 200rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-chip);
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-size: 24rpx;
  font-weight: 600;
  font-family: var(--font-display);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-variant-numeric: tabular-nums;
}

.tb-caret {
  font-size: 18rpx;
  opacity: 0.75;
  flex-shrink: 0;
}

/* 图标钮: 无底色, 只有按下反馈(热区 84rpx) */
.week-btn {
  width: 84rpx;
  height: 84rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--text-muted);
  border-radius: 50%;
  flex-shrink: 0;
}

.week-btn:active {
  background: rgba(59, 130, 246, 0.10);
}

.week-label {
  width: 100%;
  padding: 0 6rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.3;
  box-sizing: border-box;
}

.week-main {
  max-width: 100%;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-family: var(--font-display);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.week-range {
  font-size: 19rpx;
  font-weight: 400;
  color: var(--text-hint);
  font-family: var(--font-display);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* 右侧工具组 */
.tb-acts {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.tb-toggle {
  width: 84rpx;
  height: 84rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.tb-toggle:active {
  background: rgba(59, 130, 246, 0.10);
}

/* 手动刷新: 与 u-ico-btn 一致的无底色图标钮 */
.refresh-btn {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border-radius: 50%;
  color: var(--text-muted);
}

.refresh-btn:active {
  background: rgba(59, 130, 246, 0.10);
}

/* 加号按钮(全局 u-ico-btn 是 88rpx, 这里跟工具组对齐) */
.tb-acts .u-ico-btn {
  width: 84rpx;
  height: 84rpx;
}

/* 周次切换动画: 下一周从右滑入, 上一周从左滑入 */
.week-body.from-right {
  animation: weekSlideInRight 0.26s ease-out;
}

.week-body.from-left {
  animation: weekSlideInLeft 0.26s ease-out;
}

@keyframes weekSlideInRight {
  from { opacity: 0.4; transform: translateX(90rpx); }
  to   { opacity: 1;   transform: translateX(0); }
}

@keyframes weekSlideInLeft {
  from { opacity: 0.4; transform: translateX(-90rpx); }
  to   { opacity: 1;   transform: translateX(0); }
}

/* ============================================================
   网格视图容器
   ============================================================ */

.grid-wrapper {
  flex: 1;
  margin: 8rpx 16rpx 0;
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  overflow: hidden;
}

/* ============================================================
   列表视图
   ============================================================ */

.list-wrapper {
  flex: 1;
  overflow-y: auto;
  padding: 8rpx 20rpx 24rpx;
}

.day-group {
  margin-bottom: 24rpx;
}

.day-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  padding: 10rpx 4rpx 12rpx;
  border-bottom: 1rpx solid var(--line-soft);
  margin-bottom: 12rpx;
}

/* 课程卡: 底色/左侧色条由课程配色内联给出, 这里只定义形状 */
.course-card {
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-ctrl);
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-card);
}

.course-card:active { transform: scale(0.988); }

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
}

.card-periods {
  font-size: 24rpx;
}

.card-body {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-weeks {
  font-size: 22rpx;
}

/* 单周/双周徽标: 淡橙/淡蓝小胶囊 */
.card-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-chip);
  background: var(--signal-soft);
  color: var(--signal-deep);
  font-weight: 600;
}

.card-badge.even {
  background: var(--primary-soft);
  color: var(--primary-dark);
}

/* ============================================================
   课程详情 / 自定义课程弹窗(底部弹出)
   ============================================================ */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
}

.modal-card {
  width: 100%;
  max-width: 100%;
  background: var(--bg-card);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-sheet);
  overflow-y: auto;
  max-height: 80vh;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.modal-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-chip);
  background: var(--signal-soft);
  color: var(--signal-deep);
  font-weight: 600;
}

.modal-badge.even {
  background: var(--primary-soft);
  color: var(--primary-dark);
}

.modal-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: var(--text-primary);
  border-bottom: 1rpx solid var(--line-soft);
}

/* 标签: 浅灰胶囊 */
.modal-row .label {
  color: var(--text-muted);
  font-size: 22rpx;
  font-weight: 600;
  min-width: 104rpx;
  background: var(--line-soft);
  border-radius: var(--radius-chip);
  padding: 4rpx 12rpx;
  text-align: center;
  align-self: center;
}

.modal-row .m-value {
  flex: 1;
  text-align: right;
  margin-left: 16rpx;
  word-break: break-all;
}

.weeks-text {
  word-break: break-all;
}

/* ============================================================
   自定义课程表单
   ============================================================ */

.cu-card {
  max-height: 82vh;
  overflow-y: auto;
}

.cu-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.cu-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: var(--text-muted);
}

.cu-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--bg-sunken);
  border: var(--bw-ctrl) solid var(--line-strong);
  border-radius: var(--radius-ctrl);
  font-size: 28rpx;
  box-sizing: border-box;
}

.cu-ph {
  color: var(--text-hint);
}

.cu-pick {
  min-width: 240rpx;
  height: 72rpx;
  padding: 0 20rpx;
  line-height: 72rpx;
  background: var(--bg-sunken);
  border: var(--bw-ctrl) solid var(--line-strong);
  border-radius: var(--radius-ctrl);
  font-size: 27rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.cu-arrow {
  float: right;
  color: var(--text-hint);
}

.cu-range {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}

.cu-range .cu-pick {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.cu-dash {
  color: var(--text-hint);
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}
