:host {
  display: block;
  height: 100%;
  min-height: 0;
}

.container,
.view-root {
  display: flex;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  color: var(--text-primary);
  background: var(--bg-page);
}

.view-scroll {
  height: 100%;
  min-height: 0;
  /* 底部为浮动底栏(92rpx + 14rpx + 安全区)留白，避免最后一行被遮挡 */
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.topbar,
.weekbar {
  display: flex;
  align-items: center;
  border: none;
  background: var(--bg-card);
  border-radius: var(--radius-island);
  box-shadow: var(--shadow-island);
}

.topbar {
  min-height: 68rpx;
  gap: 10rpx;
  margin: 12rpx 20rpx 0;
  padding: 8rpx 12rpx;
  border-radius: var(--radius-island);
  border-bottom: 0;
  border: none;
  background: var(--bg-card);
  box-shadow: var(--shadow-island);
}

.topbar picker,
.weekbar picker {
  min-width: 0;
}

.topbar picker { flex-shrink: 1; }

.tb-sem {
  display: flex;
  align-items: center;
  max-width: 220rpx;
  gap: 4rpx;
  overflow: hidden;
  padding: 7rpx 12rpx;
  border-radius: var(--radius-control);
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 23rpx;
  font-weight: 650;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tb-caret {
  flex: none;
  margin-left: 3rpx;
  color: var(--text-muted);
  font-size: 16rpx;
}

.tb-today {
  flex: 1;
  color: var(--text-muted);
  font-family: var(--font-num);
  font-size: 21rpx;
  text-align: right;
  white-space: nowrap;
}

.tb-fav {
  display: inline-flex;
  align-items: center;
  flex: none;
  gap: 4rpx;
  padding: 7rpx 10rpx;
  border-radius: var(--radius-pill);
  color: var(--signal);
  background: var(--signal-soft);
  font-size: 21rpx;
  font-weight: 650;
}

.weekbar {
  min-height: 76rpx;
  gap: 4rpx;
  /* 与上方学期/日期岛保持 12rpx 呼吸间距，两块都是完整圆角岛，避免断续边缘 */
  margin: 12rpx 20rpx 12rpx;
  padding: 4rpx 6rpx 8rpx;
  border-top: 0;
  border-radius: var(--radius-island);
}

.weekbar picker {
  flex: 1;
}

.week-btn,
.tb-toggle,
.tb-acts .u-ico-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border-radius: var(--radius-pill);
}

.week-btn:active,
.tb-toggle:active,
.tb-acts .u-ico-btn:active {
  background: var(--primary-soft);
}

.prev-icon,
.next-icon,
.toggle-icon,
.refresh-icon,
.plus-icon {
  transition: transform var(--motion-base) var(--ease-spring);
}

.week-btn:active .prev-icon { transform: translateX(-5rpx) scale(.94); }
.week-btn:active .next-icon { transform: translateX(5rpx) scale(.94); }
.tb-toggle:active .toggle-icon { transform: rotate(12deg) scale(.92); }
.refresh-btn:active .refresh-icon { transform: rotate(180deg) scale(.92); }
.tb-acts .u-ico-btn:active .plus-icon { transform: rotate(90deg) scale(.92); }

.week-label {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: 0 4rpx;
  box-sizing: border-box;
  text-align: center;
  line-height: 1.3;
}

.week-main {
  max-width: 100%;
  overflow: hidden;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 750;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.week-range {
  color: var(--text-muted);
  font-family: var(--font-num);
  font-size: 20rpx;
  white-space: nowrap;
}

.tb-acts {
  display: flex;
  align-items: center;
  flex: none;
}

.week-body.from-right,
.week-body.from-left {
  animation-duration: 220ms;
  animation-timing-function: var(--ease-standard);
  animation-fill-mode: both;
}

.week-body.from-right { animation-name: week-in-right; }
.week-body.from-left { animation-name: week-in-left; }

@keyframes week-in-right {
  from { opacity: .5; transform: translateX(28rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes week-in-left {
  from { opacity: .5; transform: translateX(-28rpx); }
  to { opacity: 1; transform: translateX(0); }
}

.today-card,
.grid-wrapper {
  margin-right: 20rpx;
  margin-left: 20rpx;
  border: none;
  border-radius: var(--radius-island);
  background: var(--bg-card);
  box-shadow: var(--shadow-island);
}

.today-card {
  margin-bottom: 10rpx;
  padding: 16rpx 18rpx;
  background: var(--bg-card);
  border-color: var(--signal-line);
  border: none;
  border-radius: var(--radius-island);
  box-shadow: var(--shadow-island);
}

.today-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.today-title {
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 700;
}

.today-title::before {
  display: inline-block;
  width: 7rpx;
  height: 22rpx;
  margin-right: 9rpx;
  border-radius: var(--radius-pill);
  background: var(--signal);
  content: "";
  vertical-align: -3rpx;
}

.today-count,
.today-time {
  color: var(--text-muted);
  font-size: 21rpx;
}

.today-empty {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: 25rpx;
}

.today-row {
  display: flex;
  align-items: center;
  min-height: 52rpx;
  margin-top: 10rpx;
}

.today-row.on {
  margin-right: -8rpx;
  margin-left: -8rpx;
  padding: 8rpx;
  border-radius: var(--radius-control);
  background: var(--signal-soft);
}

.today-dot {
  width: 9rpx;
  height: 9rpx;
  flex: none;
  margin-right: 12rpx;
  border-radius: 50%;
}

.today-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.today-name {
  overflow: hidden;
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 650;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.today-sub {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 2rpx;
}

.today-room {
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 650;
}

.today-next {
  flex: none;
  margin-left: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-pill);
  color: var(--signal);
  background: var(--signal-soft);
  font-size: 20rpx;
  font-weight: 700;
}

.grid-wrapper {
  margin-top: 8rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  background: var(--bg-card);
}

.list-wrapper {
  padding: 8rpx 20rpx 24rpx;
  overflow: visible;
}

.day-group {
  margin-bottom: 22rpx;
  border: none;
  border-radius: var(--radius-island);
  background: var(--bg-card);
  box-shadow: var(--shadow-island);
}

.day-title {
  margin-bottom: 10rpx;
  padding: 8rpx 4rpx 10rpx;
  border-bottom: 1rpx solid var(--line-soft);
  color: var(--text-secondary);
  font-size: 25rpx;
  font-weight: 700;
}

.course-card {
  margin-bottom: 10rpx;
  padding: 16rpx 18rpx;
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-control);
  background: var(--bg-card);
}

.course-card:active {
  border-color: var(--line-strong);
  background: var(--bg-hover);
}
.course-card.audit { border-style: dashed; }

/* 切页入场由唯一责任层负责：pages/main/main.wxss 的 tabPageIn。
   本组件内不再播放整页/顶栏入场，避免父子叠加；周次切换动画(week-in-*)保留。 */

.card-header,
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-header { margin-bottom: 8rpx; }
.card-name { overflow: hidden; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.card-periods { margin-left: 12rpx; font-size: 22rpx; }
.card-body { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 8rpx; font-size: 23rpx; }
.card-teacher { opacity: .86; }
.card-room { font-size: 25rpx; font-weight: 650; }
.card-footer { justify-content: flex-start; gap: 10rpx; }
.card-weeks { color: var(--text-muted); font-size: 20rpx; }
.card-badge { padding: 3rpx 9rpx; border-radius: var(--radius-xs); color: var(--signal); background: var(--signal-soft); font-size: 19rpx; }
.card-badge.even { color: var(--primary); background: var(--primary-soft); }
.card-badge.audit { color: var(--success); background: var(--success-soft); }

.schedule-popup {
  /* 统一最大高度 88vh：TDesign 用 distance-top 计算，直接写 max-height 会被其自身规则覆盖 */
  --td-popup-distance-top: 12vh;
  /* 底部弹层统一规格：过渡只由 t-popup 负责（内容不自播入场/退出），
     遮罩色统一走 --td-overlay-bg-color，底部安全区由 t-popup--bottom 负责 */
  --td-popup-bg-color: var(--bg-card);
  --td-popup-border-radius: var(--radius-sheet);
  --td-popup-transition: all var(--motion-sheet) var(--ease-bounce);
  max-height: 88vh;
}

.modal-card {
  width: 100%;
  max-height: 84vh;
  overflow-y: auto;
  padding: var(--space-lg) var(--space-lg) var(--space-lg);
  box-sizing: border-box;
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  background: var(--bg-card);
  box-shadow: var(--shadow-sheet);
}

.modal-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--line-soft);
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 750;
  text-align: center;
}

.modal-badge { padding: 4rpx 10rpx; border-radius: var(--radius-xs); color: var(--signal); background: var(--signal-soft); font-size: 19rpx; }
.modal-badge.even { color: var(--primary); background: var(--primary-soft); }
.modal-row { display: flex; align-items: flex-start; justify-content: space-between; padding: 13rpx 0; border-bottom: 1rpx solid var(--line-soft); color: var(--text-primary); font-size: 26rpx; }
.modal-row .label { min-width: 88rpx; color: var(--text-muted); font-size: 22rpx; }
.modal-row .m-value { flex: 1; margin-left: 16rpx; color: var(--text-secondary); text-align: right; word-break: break-all; }
.weeks-text { word-break: break-all; }

.cu-field { display: flex; align-items: center; gap: 12rpx; padding: 11rpx 0; }
.cu-label { width: 134rpx; flex: none; color: var(--text-muted); font-size: 24rpx; }
.cu-input,
.cu-pick { height: 88rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: var(--radius-control); background: var(--bg-sunken) !important; font-size: 25rpx; }
.cu-input { min-width: 0; flex: 1; padding: 0 16rpx; }
.cu-pick { display: flex; align-items: center; justify-content: space-between; min-width: 220rpx; padding: 0 16rpx; color: var(--text-primary); line-height: 68rpx; }
.cu-ph { color: var(--text-hint); }
.cu-arrow { display: flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; }
.cu-range { display: flex; min-width: 0; flex: 1; align-items: center; gap: 10rpx; }
.cu-range .cu-pick { min-width: 0; flex: 1; justify-content: center; }
.cu-dash { color: var(--text-hint); }
.modal-actions { display: flex; gap: 12rpx; margin-top: 22rpx; }
.modal-actions .u-btn { min-width: 0; flex: 1; }

@media (max-width: 360px) {
  .topbar,
  .weekbar { margin-right: 14rpx; margin-left: 14rpx; }
  .today-card,
  .grid-wrapper { margin-right: 14rpx; margin-left: 14rpx; }
  .list-wrapper { padding-right: 14rpx; padding-left: 14rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .week-body,
  .course-card,
  .day-group {
    animation: none;
    transition-duration: .01ms !important;
  }
}
