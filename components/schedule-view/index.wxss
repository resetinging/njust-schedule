/* 课表页面样式 — 参考桌面端 static/css/ 设计 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}

/* 顶部信息栏 */
.header {
  background: #fff;
  padding: 12rpx 24rpx 8rpx;
  border-bottom: 1rpx solid var(--border);
}

.semester-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.semester-picker {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--primary);
}

.arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
}

.week-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.this-week-label {
  font-size: 22rpx;
  color: #E65100;
  font-weight: bold;
}

.week-nav {
  display: flex;
  gap: 8rpx;
}

.week-btn {
  display: inline-block;
  padding: 4rpx 12rpx;
  color: var(--primary);
  font-size: 24rpx;
}

/* 视图切换 */
.view-toggle {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 10rpx;
}

.toggle-btn {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  color: #666;
  background: #F5F5F5;
  transition: all 0.2s;
}

.toggle-btn.active {
  color: #fff;
  background: var(--primary);
  font-weight: bold;
}

/* ==============================
   列表视图（参考桌面端 renderListView）
   ============================== */

.list-wrapper {
  flex: 1;
  overflow-y: auto;
  padding: 12rpx 16rpx 24rpx;
}

.day-group {
  margin-bottom: 24rpx;
}

.day-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  padding: 8rpx 4rpx 12rpx;
  border-bottom: 2rpx solid #EEE;
  margin-bottom: 12rpx;
}

.course-card {
  background: #fff;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
  /* 单双周左边框 — 参考桌面端 type-1/type-2 */
}

.course-card.type-odd {
  border-left: 6rpx solid #FF9800;
}

.course-card.type-even {
  border-left: 6rpx solid #2196F3;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.card-periods {
  font-size: 24rpx;
  color: #999;
}

.card-body {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-weeks {
  font-size: 22rpx;
  color: #999;
}

.card-badge {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #FFF3E0;
  color: #E65100;
  font-weight: bold;
}

.card-badge.even {
  background: #E3F2FD;
  color: #1565C0;
}

/* ==============================
   课程详情弹窗（桌面端无弹窗，此为小程序特有增强）
   ============================== */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  width: 85vw;
  max-width: 580rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #222;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.modal-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: #FFF3E0;
  color: #E65100;
  font-weight: bold;
}

.modal-badge.even {
  background: #E3F2FD;
  color: #1565C0;
}

.modal-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.modal-row .label {
  color: var(--text-hint);
  min-width: 80rpx;
  flex-shrink: 0;
}

.weeks-text {
  text-align: right;
  color: #333;
  word-break: break-all;
}

/* ==============================
   空状态 & 加载
   ============================== */

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-hint);
}

.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-state .text {
  font-size: 28rpx;
}

/* ==============================
   网格视图容器
   ============================== */

.grid-wrapper {
  flex: 1;
  overflow: hidden;
}

/* ==============================
   全局按钮
   ============================== */

.btn-primary {
  display: block;
  width: 70%;
  margin: 0 auto;
  padding: 20rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
}

/* ==== 优化: 周次跳转 + 搜索 ==== */
.week-label-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--primary);
}
.week-jump-hint {
  font-size: 20rpx;
  color: var(--text-hint);
}
.search-bar {
  position: relative;
  margin: 16rpx 20rpx 8rpx;
}
.search-input {
  height: 72rpx;
  padding: 0 64rpx 0 24rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: 36rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.search-clear {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-hint);
  font-size: 28rpx;
  padding: 8rpx;
}

/* ============================================================
   V2 视觉升级 — 课表页
   ============================================================ */
/* 顶部信息栏卡片化(白底悬浮) */
.header {
  background: #fff;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 82, 118, 0.12);
  padding-bottom: 20rpx;
  position: sticky;
  top: 0;
  z-index: 30;
}

/* 学期选择胶囊 */
.semester-picker {
  background: #EFEBFC;
  border-radius: 32rpx;
  padding: 10rpx 24rpx;
  color: var(--primary);
  font-weight: 600;
}

/* 当前周徽标 */
.this-week-label {
  background: linear-gradient(135deg, #7C6BE8, #8B79EC);
  color: #fff;
  border-radius: 16rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  margin-left: 8rpx;
}

/* 视图切换胶囊 */
.view-toggle {
  background: #EFEBFC;
  border-radius: 32rpx;
  padding: 6rpx;
}
.toggle-btn {
  border-radius: 28rpx;
  transition: all 0.15s;
}
.toggle-btn.active {
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(26, 82, 118, 0.18);
  color: var(--primary);
  font-weight: 600;
}

/* 列表课程卡 */
.course-card {
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid rgba(26, 82, 118, 0.05);
}
.course-card:active { transform: scale(0.985); }

/* 日期分组标题 */
.day-title {
  border-left: 8rpx solid var(--primary);
  padding-left: 16rpx;
  color: var(--primary-dark);
  font-weight: 700;
}

/* 详情弹窗标题装饰 */
.modal-title {
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #EFEBFC;
}
.modal-badge {
  background: linear-gradient(135deg, #7C6BE8, #8B79EC);
  color: #fff;
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
}


/* ============================================================
   V3 视觉升级 — 课表页头部 Hero + 底部弹层
   ============================================================ */
/* 顶部 Hero 渐变(白字) */
.header {
  background: linear-gradient(135deg, #7C6BE8 0%, #8B79EC 55%, #3498db 100%);
  color: #fff;
}
.header .semester-picker {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
}
.header .arrow { color: rgba(255, 255, 255, 0.85); }
.header .week-info { color: #fff; }
.header .week-jump-hint { color: rgba(255, 255, 255, 0.85); }
.header .week-btn {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  border-radius: 16rpx;
}
.this-week-label {
  background: rgba(255, 255, 255, 0.92);
  color: var(--primary);
}
.header .view-toggle { background: rgba(255, 255, 255, 0.20); }
.header .toggle-btn { color: rgba(255, 255, 255, 0.95); }
.header .toggle-btn.active {
  background: #fff;
  color: var(--primary);
}
.header .search-bar { margin-top: 4rpx; }
.header .search-input {
  background: rgba(255, 255, 255, 0.95);
  border-color: transparent;
}

/* 详情弹窗 → 底部弹出 */
.modal-mask { align-items: flex-end; padding: 0; }
.modal-card {
  width: 100%;
  max-width: 100%;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.15);
  overflow-y: auto;
  max-height: 80vh;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #EFEBFC;
}
.modal-row { padding: 10rpx 0; }


/* ============================================================
   V4 简约风格 — 课表页
   ============================================================ */
/* 头部: 白底 + 底部分隔, 去渐变 */
.header {
  background: #fff;
  box-shadow: none;
  border-bottom: 1rpx solid #E9EDF2;
  padding-bottom: 16rpx;
}
.header .semester-picker {
  background: #EFEBFC;
  color: var(--primary);
  padding: 8rpx 20rpx;
}
.header .arrow { color: var(--primary); }
.header .week-info { color: #333; }
.header .week-jump-hint { color: var(--text-hint); }
.header .week-btn {
  background: #EFEBFC;
  color: var(--primary);
  border-radius: 12rpx;
  font-size: 26rpx;
}
.this-week-label {
  background: #EFEBFC;
  color: var(--primary);
}
.header .view-toggle { background: #eaf1f8; }
.header .toggle-btn { color: var(--text-secondary); }
.header .toggle-btn.active { background: #fff; color: var(--primary); }
.header .search-input {
  background: #F6F5FA;
  border: 1rpx solid #E6E2F2;
}

/* 列表课程卡: 白底轻阴影 */
.course-card {
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: none;
}

/* 详情弹窗: 保持底部弹出, 白底 */
.modal-card {
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.10);
}


/* ============================================================
   V6 桌面端同款 — 课表页
   ============================================================ */
/* 学期选择器 → 桌面学期徽标样式 */
.header .semester-picker {
  background: #EFEBFC;
  color: #7C6BE8;
  border-radius: 40rpx;
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
}
/* 周次按钮 → 桌面 btn-secondary: 白底描边 */
.header .week-btn {
  background: #fff;
  border: 2rpx solid #E3DFF5;
  color: #33304F;
  border-radius: 12rpx;
}
/* 本周徽标 → 桌面 badge 淡蓝胶囊 */
.this-week-label {
  background: #EFEBFC;
  color: #7C6BE8;
  border-radius: 24rpx;
  font-size: 24rpx;
}
/* 视图切换 → 桌面 btn 组: 白底描边, 选中亮蓝 */
.header .view-toggle { background: #F7F6FB; border-radius: 20rpx; padding: 4rpx; }
.header .toggle-btn {
  color: #8A87A8;
  border-radius: 16rpx;
}
.header .toggle-btn.active {
  background: #8B79EC;
  color: #fff;
}
.header .search-input {
  background: #fff;
  border: 2rpx solid #E3DFF5;
  border-radius: 18rpx;
}
/* 列表课程卡 → 桌面 exam-card 同款白卡 */
.course-card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  padding: 20rpx 24rpx;
}

/* ============================================================
   复刻目标 UI — 顶部紫渐变卡 + 工具栏
   ============================================================ */
.top-card {
  margin: 16rpx 20rpx 0;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #8F7DF0 0%, #A99BF5 55%, #BBAFF8 100%);
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(120, 100, 220, 0.35);
}

.tc-main {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.tc-sem {
  font-size: 40rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

.tc-user {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
}

.tc-avatar {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  font-size: 26rpx;
}

.tc-id { font-size: 24rpx; color: rgba(255, 255, 255, 0.8); }

.tc-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tc-week {
  font-size: 30rpx;
  font-weight: 700;
}

.top-card .view-toggle {
  display: flex;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.20);
  border-radius: 16rpx;
  padding: 6rpx;
}

.top-card .toggle-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 12rpx;
  color: rgba(255, 255, 255, 0.9);
}

.top-card .toggle-btn.active {
  background: rgba(255, 255, 255, 0.95);
  color: #7C6BE8;
}

/* 工具栏 */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 16rpx 20rpx 8rpx;
}

.week-nav {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.week-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #fff;
  border: 2rpx solid #E3DFF5;
  color: #7C6BE8;
  border-radius: 14rpx;
  font-size: 26rpx;
}

.week-label {
  min-width: 150rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.35;
}

.week-main {
  font-size: 26rpx;
  font-weight: 600;
  color: #4A4670;
}

/* 周次下方的日期范围 (如 "9/1 - 9/7") */
.week-range {
  font-size: 20rpx;
  font-weight: 400;
  color: #9B96B8;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  position: relative;
  background: #fff;
  border: 2rpx solid #E3DFF5;
  border-radius: 30rpx;
  padding: 0 8rpx 0 20rpx;
  height: 64rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  height: 60rpx;
  /* 去掉 input 自身边框/背景/圆角(历史样式残留), 只保留外层 search-box 一个框 */
  border: none !important;
  background: transparent !important;
  border-radius: 0 !important;
  padding: 0;
}

.search-clear {
  padding: 0 16rpx;
  color: #9A96B8;
  font-size: 26rpx;
}

/* ============================================================
   V7 风格统一 — 课程详情弹窗对齐其他页面(紫色系主题)
   ============================================================ */
.modal-card {
  box-shadow: 0 -6rpx 28rpx rgba(87, 74, 160, 0.16);
}
.modal-title {
  color: #33304F;
  justify-content: center;
  text-align: center;
}
.modal-badge {
  border-radius: 14rpx;
}
.modal-row {
  color: #33304F;              /* 值: 深紫黑 */
  border-bottom: 1rpx solid #F1EFF8;
}
.modal-row .label {
  color: #6C5CE0;              /* 标签: 紫色 */
  font-size: 22rpx;
  font-weight: 600;
  min-width: 104rpx;
  background: #F2F0FA;         /* 浅紫胶囊 */
  border-radius: 12rpx;
  padding: 4rpx 12rpx;
  text-align: center;
  align-self: center;
}

/* 详情弹窗值: 右对齐, 可换行 */
.modal-row .m-value {
  flex: 1;
  text-align: right;
  margin-left: 16rpx;
  word-break: break-all;
}


/* 组件根/滚动区 */
.view-root {
  height: 100%;
  box-sizing: border-box;
}
.view-scroll {
  height: 100%;
}
/* 手动刷新按钮(工具栏右侧) */
.refresh-btn {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 30rpx;
  background: #EFEBFC;
  border-radius: 16rpx;
  color: #7C6BE8;
}

/* 宿主节点高度(swiper-item 内撑满, 保证内部 100% 高度链有效) */
:host {
  display: block;
  height: 100%;
}

/* 系统公告横幅 */
.announce-bar {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 16rpx 20rpx 0;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #FFF7E0, #FFEFC2);
  border: 2rpx solid #F5D87A;
  border-radius: 20rpx;
}
.ann-ico { font-size: 30rpx; flex-shrink: 0; line-height: 1.5; }
.ann-text {
  flex: 1;
  font-size: 26rpx;
  color: #7A5B12;
  line-height: 1.6;
  word-break: break-all;
}

/* ============================================================
   V8 课程块统一橙黄(设计规范 §3.5) — 列表视图与网格同款
   背景 #FCF0D9 · 边 #F3D9A8 · 字 #8A6116
   ============================================================ */
.course-card {
  background: #FCF0D9;
  border: 2rpx solid #F3D9A8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(138, 97, 22, 0.08);
}
.course-card.type-odd,
.course-card.type-even {
  border-left: 6rpx solid #F5D9A0;
}
.course-card .card-name { color: #8A6116; }
.course-card .card-periods { color: #9A7332; }
.course-card .card-body { color: #8A6116; }
.course-card .card-weeks { color: #9A7332; }
.course-card .card-badge,
.course-card .card-badge.even {
  background: #F5D9A0;
  color: #8A6116;
}
