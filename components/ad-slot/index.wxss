/* ==========================================================================
   广告槽位：每个接入位置复用同一套原生模板广告样式
   --------------------------------------------------------------------------
   · 顶部留白 16rpx（与基座 --space-md 同值；既有回归测试锁定该字面值，
     故保留字面量并在此说明，不改变留白大小）
   · height 只作为槽位最小高度，原生模板广告保留自身高度，避免强制缩放或裁剪
   · 槽位保持在文档流内，不定位、不悬浮、不设阴影，避免遮挡工具内容
   ========================================================================== */

:host {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding-top: 16rpx; /* = var(--space-md) */
}

.ad-slot {
  display: block;
  width: 100%;
}

.ad-slot-sized {
  width: 100%;
}
