/* ==========================================================================
   信息中心（公告 / 更新记录 / 联系）
   --------------------------------------------------------------------------
   · 白色内容面 + 细边线；分区用留白与分隔线，不做卡片套卡片
   · 无装饰圆、无渐变、无厚投影；列表时间统一右对齐、字号与色阶同源
   · 二级页入场统一由主页 tool-layer 管理（260ms 淡入 + 小幅上移），
     组件内不再重复播放整页入场，避免父子层叠加两套动画
   · 底部预留安全区；返回按钮热区 88rpx，按压反馈由基座 .tap 提供
   ========================================================================== */

.notice-root {
  display: flex;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg-page);
}

.notice-nav {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 var(--space-page);
  background: var(--bg-card);
  border-bottom: var(--bw-card) solid var(--line);
  border: none;
  border-radius: var(--radius-island);
  box-shadow: var(--shadow-island);
}

/* 返回：图标 + 文字，与图鉴页保持同一位置与热区 */
.notice-back {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xxs);
  min-height: 88rpx;
  padding: 0 var(--space-md) 0 var(--space-xs);
  border-radius: var(--radius-pill);
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  font-weight: 500;
}

.notice-back:active {
  background: var(--bg-hover);
}

.notice-updated {
  margin-left: auto;
  max-width: 240rpx;
  overflow: hidden;
  color: var(--text-hint);
  font-size: var(--fs-cap);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.notice-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.notice-content {
  padding: var(--space-md) var(--space-page)
           calc(var(--space-xl) + env(safe-area-inset-bottom));
}

/* 三栏切换：8rpx 倍数间距，选中态用白色面 + 品牌色文字，热区 88rpx */
.notice-tabs {
  position: sticky;
  top: 0;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-xs);
  margin: 0 0 var(--space-md);
  padding: var(--space-xxs);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-pill);
  background: var(--bg-sunken);
}

.notice-tab {
  display: flex;
  min-width: 0;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  border-radius: var(--radius-pill);
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  font-weight: 500;
  transition:
    color var(--motion-fast) var(--ease-standard),
    background-color var(--motion-fast) var(--ease-standard);
}

.notice-tab.on {
  color: var(--primary);
  background: var(--bg-card);
  font-weight: 600;
}

.tab-count {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 var(--space-xs);
  border-radius: var(--radius-chip);
  color: var(--primary);
  background: var(--primary-soft);
  font-size: var(--fs-cap);
  line-height: 32rpx;
  text-align: center;
}

.load-warning {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin: 0 0 var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border: var(--bw-card) solid var(--warning-line);
  border-radius: var(--radius-control);
  background: var(--warning-soft);
}

.load-warning-text {
  flex: 1;
  color: var(--text-primary);
  font-size: var(--fs-sub);
}

.load-warning-action {
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-chip);
  color: var(--warning);
  font-size: var(--fs-sub);
  font-weight: 600;
}

/* 页签切换时的轻量淡入；整页入场交给 tool-layer */
.notice-panel {
  animation: panelReveal var(--motion-slow) var(--ease-standard) both;
}

/* 头条公告：白面 + 细边线，优先级用边线与文字标签表达，不用渐变/投影 */
.featured-card {
  padding: var(--space-lg);
  border: none;
  border-radius: var(--radius-island);
  background: var(--bg-card);
  box-shadow: var(--shadow-island);
}

.featured-card.priority-important {
  border-color: var(--warning-line);
}

.featured-card.priority-urgent {
  border-color: var(--danger-soft);
  background: var(--danger-soft);
}

.featured-meta,
.announcement-meta,
.announcement-head,
.changelog-head {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}

.featured-meta {
  flex-wrap: wrap;
}

.type-label {
  color: var(--primary);
  font-size: var(--fs-cap);
  font-weight: 600;
}

.priority-label {
  padding: var(--space-xxs) var(--space-xs);
  border-radius: var(--radius-chip);
  color: var(--warning);
  background: var(--warning-soft);
  font-size: var(--fs-cap);
  font-weight: 600;
}

.priority-label.priority-urgent {
  color: var(--danger);
  background: var(--danger-soft);
}

/* 列表时间：统一右对齐、同一字号与弱色阶 */
.featured-date,
.announcement-date,
.changelog-date {
  margin-left: auto;
  color: var(--text-hint);
  font-size: var(--fs-cap);
}

.featured-title {
  display: block;
  margin-top: var(--space-md);
  color: var(--text-primary);
  font-size: var(--fs-page-title);
  font-weight: 700;
  line-height: 1.4;
}

.audience-line {
  display: block;
  margin-top: var(--space-xs);
  color: var(--text-hint);
  font-size: var(--fs-cap);
  line-height: 1.6;
}

.featured-body,
.announcement-body {
  display: block;
  margin-top: var(--space-sm);
  color: var(--text-secondary);
  font-size: var(--fs-body);
  line-height: 1.7;
  white-space: pre-wrap;
}

.is-clamped {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.action-note,
.action-inline {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  margin-top: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-control);
  color: var(--text-primary);
  background: var(--warning-soft);
  font-size: var(--fs-sub);
  line-height: 1.6;
}

.action-label {
  flex: none;
  color: var(--warning);
  font-weight: 600;
}

.action-text {
  min-width: 0;
}

.text-action {
  width: fit-content;
  margin-top: var(--space-md);
  padding: var(--space-xs) 0;
  color: var(--primary);
  font-size: var(--fs-sub);
  font-weight: 600;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  min-height: 40rpx;
  margin: var(--space-lg) 0 var(--space-sm);
  color: var(--text-primary);
  font-size: var(--fs-section);
  font-weight: 700;
}

.section-count {
  color: var(--text-hint);
  font-size: var(--fs-cap);
  font-weight: 400;
}

/* 公告列表：单个白色分区，条目之间只用分隔线 */
.announcement-list {
  overflow: hidden;
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  background: var(--bg-card);
}

.announcement-item {
  padding: var(--space-lg);
  border-bottom: var(--bw-card) solid var(--line-soft);
}

.announcement-item:last-child {
  border-bottom: 0;
}

.announcement-meta {
  min-height: 32rpx;
}

.announcement-head {
  justify-content: space-between;
  margin-top: var(--space-xs);
}

.announcement-title {
  flex: 1;
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.5;
}

.expand-state {
  flex: none;
  color: var(--primary);
  font-size: var(--fs-cap);
  font-weight: 600;
}

/* 更新记录：白色分区 + 左侧时间轴，条目之间用分隔线而不是卡片 */
.changelog-list {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: var(--space-lg);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  background: var(--bg-card);
}

.changelog-item {
  display: flex;
  gap: var(--space-sm);
}

.timeline {
  position: relative;
  display: flex;
  width: 16rpx;
  flex: none;
  justify-content: center;
}

.timeline::after {
  position: absolute;
  top: var(--space-lg);
  bottom: 0;
  width: 2rpx;
  background: var(--line);
  content: "";
}

.changelog-item:last-child .timeline::after {
  display: none;
}

/* 时间轴节点：去掉装饰圆，改为小方块标记，纵向对齐版本号首行 */
.timeline-dot {
  position: relative;
  z-index: 1;
  width: 8rpx;
  height: 8rpx;
  margin-top: var(--space-md);
  background: var(--primary);
}

.changelog-card {
  flex: 1;
  min-width: 0;
  margin-bottom: var(--space-md);
  padding-bottom: var(--space-md);
  border-bottom: var(--bw-card) solid var(--line-soft);
}

.changelog-item:last-child .changelog-card {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: 0;
}

.changelog-head {
  justify-content: space-between;
  min-height: 40rpx;
}

.version {
  color: var(--primary);
  font-family: var(--font-num);
  font-size: var(--fs-body);
  font-weight: 700;
}

.changelog-title {
  display: block;
  margin-top: var(--space-xs);
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.5;
}

.changelog-lines {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-top: var(--space-sm);
}

.changelog-line {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.6;
}

.change-badge {
  flex: none;
  min-width: 56rpx;
  padding: var(--space-xxs) var(--space-xs);
  border-radius: var(--radius-chip);
  color: var(--primary);
  background: var(--primary-soft);
  font-size: var(--fs-cap);
  font-weight: 600;
  line-height: 1.6;
  text-align: center;
}

.change-badge.change-improve {
  color: var(--success);
  background: var(--success-soft);
}

.change-badge.change-fix {
  color: var(--warning);
  background: var(--warning-soft);
}

.change-badge.change-remove {
  color: var(--danger);
  background: var(--danger-soft);
}

.change-badge.change-update {
  color: var(--text-secondary);
  background: var(--bg-sunken);
}

.change-text {
  min-width: 0;
}

/* 联系 / QQ 群：单个白色分区，行内排版 */
.support-card {
  padding: var(--space-lg);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  background: var(--bg-card);
}

.support-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.support-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-control);
  background: var(--primary-soft);
}

.support-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.support-label {
  color: var(--text-hint);
  font-size: var(--fs-cap);
  font-weight: 500;
}

.support-name {
  margin-top: var(--space-xxs);
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
}

.support-number {
  margin-top: var(--space-xxs);
  color: var(--primary);
  font-family: var(--font-num);
  font-size: var(--fs-page-title);
  font-weight: 700;
  line-height: 1.3;
}

.copy-btn {
  display: inline-flex;
  min-width: 112rpx;
  min-height: 72rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-md);
  border-radius: var(--radius-control);
  color: var(--primary);
  background: var(--primary-soft);
  font-size: var(--fs-sub);
  font-weight: 600;
}

.copy-btn.is-copied {
  color: var(--success);
  background: var(--success-soft);
}

.support-note {
  display: block;
  margin-top: var(--space-lg);
  padding-top: var(--space-md);
  border-top: var(--bw-card) solid var(--line-soft);
  color: var(--text-muted);
  font-size: var(--fs-sub);
  line-height: 1.6;
}

/* 空态：居中，无图标圆底 */
.section-empty,
.notice-empty {
  display: flex;
  min-height: 320rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  color: var(--text-muted);
  font-size: var(--fs-sub);
  text-align: center;
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-title {
  color: var(--text-secondary);
  font-size: var(--fs-body);
}

.retry-btn {
  display: inline-flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-lg);
  border: var(--bw-card) solid var(--primary-line);
  border-radius: var(--radius-control);
  color: var(--primary);
  background: var(--primary-soft);
  font-size: var(--fs-sub);
  font-weight: 600;
}

/* 加载骨架：纯色块，不再使用扫光渐变 */
.notice-loading {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding-top: var(--space-xs);
}

.skeleton {
  width: 74%;
  height: 24rpx;
  border-radius: var(--radius-chip);
  background: var(--bg-sunken);
}

.skeleton-wide {
  width: 92%;
  height: 32rpx;
}

.skeleton-short {
  width: 48%;
}

/* 整页入场由 main 的 tool-layer 统一管理，组件内不再播放同方向进场 */

@keyframes panelReveal {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .notice-panel {
    animation: none;
  }

  .notice-tab {
    transition-duration: .01ms;
  }
}
