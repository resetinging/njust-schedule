<t-dialog visible="{{visible}}" title="{{title}}" close-on-overlay-click="{{false}}">
  <view slot="content" class="loading-content">
    <t-progress wx:if="{{showProgress}}" percentage="{{percent}}" color="var(--primary)" />
    <t-loading wx:if="{{spinning}}" class="loading-indicator" theme="dots" size="44rpx" />
    <text class="message" wx:if="{{message}}">{{message}}</text>
    <slot></slot>
  </view>
  <view slot="actions" class="loading-actions" wx:if="{{done}}">
    <t-button theme="primary" block bind:tap="onClose">{{doneText}}</t-button>
  </view>
</t-dialog>
