/* ==========================================================================
   加载 / 进度弹层的内容排版
   --------------------------------------------------------------------------
   · 轻量对齐：内容居中、正文 24rpx、间距 8rpx 倍数
   · 弹层圆角与阴影由基座 token 与 TDesign t-dialog 统一提供，
     这里不再声明卡片、阴影或覆盖层样式
   ========================================================================== */

.loading-content {
  display: flex;
  min-height: 112rpx;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: var(--space-lg);
}

.loading-indicator {
  align-self: center;
  color: var(--primary);
}

.loading-actions {
  width: 100%;
}

.message {
  display: block;
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.6;
  text-align: center;
}
