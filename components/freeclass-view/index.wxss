/* ==========================================================================
   空教室查询 · 样式统一
   --------------------------------------------------------------------------
   · 颜色 / 圆角 / 间距 / 阴影 / 动效全部引用 styles/design-system.wxss 令牌
   · 普通分区无投影、无渐变、无装饰圆；按压反馈由基座 .tap 提供
   · 结果按教学楼分组：一张白面 + 组间分隔线，教室用固定列网格保证等宽与顺序
   · 保留：江阴全部楼宇由 JS 原样传入、孝陵卫四大教学楼过滤在 JS 内完成，
     WXML 分组渲染与折叠/展开逻辑未改动
   ========================================================================== */

/* ============================================================
   容器与滚动
   ============================================================ */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
  background: var(--bg-page);
}

.view-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.page-content {
  padding: var(--space-md) var(--space-page) calc(48rpx + env(safe-area-inset-bottom));
}

/* ============================================================
   顶部导航（sticky 与层级保持原值，避免影响 ui-picker 底部弹层）
   ============================================================ */

.custom-nav {
  position: sticky;
  top: 0;
  z-index: 80;
  background: var(--bg-card);
  border-bottom: var(--bw-card) solid var(--line);
}

.custom-nav.is-embedded {
  padding-top: 0;
}

.custom-nav.is-embedded .custom-nav-title {
  display: none;
}

.custom-nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  padding-left: var(--space-xs);
  box-sizing: border-box;
}

/* 返回：88rpx 热区，中性底，无投影 */
.custom-back {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  min-height: 88rpx;
  padding: 0 var(--space-md) 0 var(--space-xs);
  border: none;
  border-radius: var(--radius-pill);
  background: transparent;
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  font-weight: 600;
}

.icon-back {
  display: inline-flex;
  align-items: center;
}

.custom-nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 700;
  pointer-events: none;
}

/* ============================================================
   筛选项：图标 / 标签固定列宽，值右对齐成列
   （每行由 ui-picker 包裹，不能依赖相邻兄弟选择器，故用行间距 + 软底控件行）
   ============================================================ */

.filter-card {
  margin-top: var(--space-md);
  padding: var(--space-xs) var(--space-xs) 0;
  background: var(--bg-card);
  border: none;
  border-radius: var(--radius-island);
  box-shadow: var(--shadow-island);
}

.filter-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-height: 88rpx;
  margin-bottom: var(--space-xs);
  padding: 0 var(--space-md);
  border-radius: var(--radius-control);
  background: var(--bg-sunken);
}

.filter-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  flex: none;
}

.filter-label {
  flex: none;
  width: 160rpx;
  color: var(--text-secondary);
  font-size: var(--fs-sub);
}

.filter-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-left: var(--space-xs);
  flex: none;
}

/* ============================================================
   结果摘要（留白分区，不再用浮动卡片）
   ============================================================ */

.result-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  margin-top: var(--space-lg);
}

.result-summary {
  flex: 1;
  min-width: 0;
  color: var(--text-muted);
  font-size: var(--fs-sub);
  line-height: 1.5;
}

.result-count-box {
  display: flex;
  align-items: baseline;
  flex: none;
}

.result-count-num {
  color: var(--text-primary);
  font-family: var(--font-num);
  font-size: var(--fs-page-title);
  font-weight: 700;
  line-height: 1;
}

.result-count-unit {
  margin-left: var(--space-xs);
  color: var(--text-muted);
  font-size: var(--fs-cap);
}

/* 数据来源提示（缓存秒开 / 后台刷新 / 离线） */
.cache-note {
  margin-top: var(--space-xs);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  text-align: right;
}

/* ============================================================
   教学楼分组：一张白面 + 组间分隔线
   ============================================================ */

.group-list {
  margin-top: var(--space-xs);
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  overflow: hidden;
}

.group-card {
  padding: var(--space-lg);
}

.group-card + .group-card {
  border-top: var(--bw-card) solid var(--line-soft);
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  padding-bottom: var(--space-sm);
}

.group-name-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  min-width: 0;
}

.group-emoji {
  display: flex;
  align-items: center;
  flex: none;
}

.group-name {
  overflow: hidden;
  color: var(--text-primary);
  font-size: var(--fs-section);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-badge {
  flex: none;
  padding: var(--space-xxs) var(--space-sm);
  border-radius: var(--radius-pill);
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: var(--fs-cap);
  font-weight: 600;
}

/* 折叠裁剪容器：仅负责裁掉两行以外的教室；展开后由外层 scroll-view 连续滚动 */
.group-chips {
  overflow: hidden;
}

/* 两行教室：行高 72rpx + 行距 12rpx → 72 * 2 + 12 = 156rpx。
   156rpx 是 components/freeclass-view/index.js 中 COLLAPSED_HEIGHT_RPX 的
   溢出实测基准，改动网格行高/行距时必须同步该常量（本次未改 JS）。 */
.group-chips.is-collapsed {
  max-height: 156rpx;
}

/* 稳定网格：固定 4 列等宽、按 DOM 顺序换行，数量多时不会被压缩变形 */
.chips-inner {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-sm);
}

.room-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 72rpx;
  padding: 0 var(--space-xs);
  overflow: hidden;
  border: var(--bw-card) solid var(--line-soft);
  border-radius: var(--radius-chip);
  background: var(--bg-sunken);
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  min-height: 88rpx;
  margin-top: var(--space-xs);
  color: var(--primary);
  font-size: var(--fs-sub);
  font-weight: 600;
}

.toggle-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* ============================================================
   加载 / 错误 / 未登录
   ============================================================ */

.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx var(--space-xl);
}

.err-tip {
  margin-top: var(--space-lg);
  padding: var(--space-md) var(--space-lg);
  border-radius: var(--radius-control);
  background: var(--danger-soft);
  color: var(--danger);
  font-size: var(--fs-sub);
  text-align: center;
}

.login-wrap {
  padding-top: 96rpx;
}

/* ============================================================
   减少动态效果：本页无自定义动效，仅收掉残余过渡，其余由基座统一处理
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  .filter-row,
  .group-card,
  .room-chip,
  .custom-back {
    transition: none;
  }
}
