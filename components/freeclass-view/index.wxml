<!-- 空教室查询页: 渐变头卡 + 筛选卡片 + 按教学楼分组的教室列表 -->
<view class="container {{fontClass}}">

  <view class="custom-nav {{embedded ? 'is-embedded' : ''}}"
        style="{{embedded ? 'padding-top:0;' : 'padding-top:' + statusBarHeight + 'px;'}}">
    <view class="custom-nav-inner"
          style="{{embedded ? 'height:88rpx;' : 'height:' + navBarHeight + 'px;'}}padding-right:{{navRight}}px;">
      <view class="custom-back tap" aria-label="返回" bindtap="goBack">
        <view class="icon-back"><icon name="back" size="28" color="#6B7684" /></view>
        <text>返回</text>
      </view>
      <text class="custom-nav-title">空教室查询</text>
    </view>
  </view>

  <scroll-view class="view-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="page-content">

  <!-- ============ 已登录 ============ -->
  <block wx:if="{{loggedIn}}">

    <!-- 筛选卡片 -->
    <view class="filter-card">
      <ui-picker range="{{campusList}}" value="{{campusIndex}}" title="选择校区" bind:change="onCampusChange">
        <view class="filter-row tap">
          <view class="filter-icon"><icon name="building" size="30" color="#6B7684" /></view>
          <text class="filter-label">校区</text>
          <text class="filter-value">{{campusList[campusIndex]}}</text>
          <view class="arrow"><icon name="next" size="26" color="#6B7684" /></view>
        </view>
      </ui-picker>
      <ui-picker range="{{weekdayList}}" value="{{weekdayIndex}}" title="选择星期" bind:change="onWeekdayChange">
        <view class="filter-row tap">
          <view class="filter-icon"><icon name="calendar" size="30" color="#6B7684" /></view>
          <text class="filter-label">星期</text>
          <text class="filter-value">{{weekdayList[weekdayIndex]}}</text>
          <view class="arrow"><icon name="next" size="26" color="#6B7684" /></view>
        </view>
      </ui-picker>
      <ui-picker range="{{weekList}}" value="{{weekIndex}}" title="选择周次" bind:change="onWeekChange">
        <view class="filter-row tap">
          <view class="filter-icon"><icon name="calendar" size="30" color="#6B7684" /></view>
          <text class="filter-label">周次</text>
          <text class="filter-value">{{weekList[weekIndex]}}</text>
          <view class="arrow"><icon name="next" size="26" color="#6B7684" /></view>
        </view>
      </ui-picker>
      <ui-picker range="{{slotList}}" range-key="label" value="{{startIndex}}" title="选择开始时段" bind:change="onStartChange">
        <view class="filter-row tap">
          <view class="filter-icon"><icon name="clock" size="30" color="#6B7684" /></view>
          <text class="filter-label">开始时段</text>
          <text class="filter-value">{{slotList[startIndex].label}}</text>
          <view class="arrow"><icon name="next" size="26" color="#6B7684" /></view>
        </view>
      </ui-picker>
      <ui-picker range="{{slotList}}" range-key="label" value="{{endIndex}}" title="选择结束时段" bind:change="onEndChange">
        <view class="filter-row filter-row-last tap">
          <view class="filter-icon"><icon name="hourglass" size="30" color="#6B7684" /></view>
          <text class="filter-label">结束时段</text>
          <text class="filter-value">{{slotList[endIndex].label}}</text>
          <view class="arrow"><icon name="next" size="26" color="#6B7684" /></view>
        </view>
      </ui-picker>
    </view>

    <!-- 结果摘要(渐变条) -->
    <view class="result-bar" wx:if="{{result}}">
      <view class="result-summary">{{result.summary}}</view>
      <view class="result-count-box">
        <text class="result-count-num">{{result.count}}</text>
        <text class="result-count-unit">间空闲</text>
      </view>
    </view>
    <view id="slot-freeclass-mid" class="analytics-slot-marker"></view>

    <!-- 数据来源提示(缓存秒开/后台更新/离线) -->
    <view class="cache-note" wx:if="{{cacheNote}}">{{cacheNote}}</view>

    <!-- 按教学楼分组的教室(纯展示) -->
    <view class="group-list" wx:if="{{groups.length}}">
      <block wx:for="{{groups}}" wx:key="prefix" wx:for-item="grp" wx:for-index="groupIndex">
        <view class="group-card">
          <view class="group-head">
            <view class="group-name-wrap">
              <view class="group-emoji"><icon name="building" size="30" color="#3157D5" /></view>
              <text class="group-name">{{grp.label}}</text>
            </view>
            <view class="group-badge">{{grp.rooms.length}} 间</view>
          </view>
          <view class="floor-nav" wx:if="{{grp.showFloorNav}}">
            <scroll-view class="floor-scroll" scroll-x enhanced show-scrollbar="{{false}}">
              <view class="floor-tabs">
                <view class="floor-tab tap {{grp.activeFloorIndex === floorIndex ? 'is-active' : ''}}"
                      wx:for="{{grp.floors}}" wx:for-item="floor" wx:for-index="floorIndex" wx:key="key"
                      data-group-index="{{groupIndex}}" data-floor-index="{{floorIndex}}" bindtap="onFloorTap"
                      aria-label="{{floor.label}}">
                  <text class="floor-tab-label">{{floor.label}}</text>
                </view>
              </view>
            </scroll-view>
          </view>
          <view class="group-chips {{grp.expanded ? '' : 'is-collapsed'}}">
            <view class="chips-inner">
              <view class="room-chip {{roomIndex % 4 === 3 ? 'room-chip-end' : ''}}"
                    wx:for="{{grp.visibleChips}}" wx:for-index="roomIndex" wx:key="*this">{{item}}</view>
            </view>
          </view>
          <view class="group-toggle tap" wx:if="{{!grp.showFloorNav && grp.overflow}}" data-index="{{groupIndex}}" bindtap="onToggleGroup">
            <text>{{grp.expanded ? '收起' : '展开全部 ' + grp.rooms.length + ' 间'}}</text>
            <view class="toggle-arrow"><icon name="{{grp.expanded ? 'prev' : 'next'}}" size="24" color="#3157D5" /></view>
          </view>
        </view>
      </block>
    </view>

    <!-- 服务端准备中 -->
    <empty-state wx:elif="{{pending && !loading && !errorMsg}}" icon="refresh" title="服务端正在准备数据"
                 desc="该时段尚未完成同步，请稍后点击刷新" />
    <!-- 无空闲 -->
    <empty-state wx:elif="{{searched && !loading && !errorMsg}}" icon="building" title="该时段没有空闲教室"
                 desc="试试放宽时段范围、换个星期或校区" />
    <!-- 查询中 -->
    <view class="loading-box" wx:if="{{loading}}">
      <t-loading theme="circular" size="44rpx" text="正在查询空闲教室…" />
    </view>
    <!-- 错误 -->
    <view class="err-tip" wx:elif="{{errorMsg}}">{{errorMsg}}</view>
    <view id="slot-freeclass-bottom">
      <ad-slot unit-id="adunit-8f99eb551760e548"
               slot-id="slot-freeclass-bottom"
               page="freeclass"
               ad-type="native" />
    </view>
  </block>

  <!-- ============ 未登录 ============ -->
  <view wx:else class="login-wrap">
    <empty-state icon="lock" title="需要先登录" desc="登录后即可查询空闲教室"
                 action-text="去登录" bind:action="goLogin" />
  </view>

  </view>
  </scroll-view>

</view>
