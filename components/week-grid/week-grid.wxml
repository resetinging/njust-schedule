<!-- 周课表网格组件 — 小节行布局 -->
<view class="week-grid">

  <!-- 表头: 星期 -->
  <view class="grid-header">
    <view class="head-time"></view>
    <view class="head-day" wx:for="{{weekdays}}" wx:key="*this">
      <text>{{item}}</text>
    </view>
  </view>

  <!-- 网格体: 时间列 + 7 天列(课程块绝对定位) -->
  <view class="grid-body">
    <!-- 节次时间列 -->
    <view class="time-col">
      <view class="time-cell" wx:for="{{timeRows}}" wx:key="index">
        <text class="t-num">{{item.index}}</text>
        <text class="t-time">{{item.time}}</text>
      </view>
    </view>

    <!-- 每天一列 -->
    <view class="day-col" wx:for="{{dayCols}}" wx:key="day">
      <!-- 课程块 -->
      <view
        wx:for="{{item.blocks}}"
        wx:key="index"
        wx:for-item="b"
        class="course-block"
        style="top: {{b._top}}rpx; height: {{b._height}}rpx; background: {{b._bg}}; border-left-color: {{b._bar}}"
        bindtap="onCourseTap"
        data-course="{{b}}"
      >
        <text class="cb-name" style="color: {{b._text}}">{{b.name}}</text>
        <text class="cb-code" wx:if="{{b.classroom}}" style="color: {{b._text}}">{{b.classroom}}</text>
        <text class="cb-range" style="color: {{b._text}}">{{b._range}}</text>
      </view>
    </view>
  </view>

</view>
