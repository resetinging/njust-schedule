<!-- 周课表网格组件 — 小节行布局 -->
<view class="week-grid">

  <!-- 表头: 星期 + 日期(今天高亮) -->
  <view class="grid-header">
    <view class="head-time"></view>
    <view class="head-day {{item.today ? 'today' : ''}}" wx:for="{{weekdays}}" wx:key="name">
      <text class="hd-name">{{item.name}}</text>
      <text class="hd-date" wx:if="{{item.date}}">{{item.date}}</text>
    </view>
  </view>

  <!-- 网格体: 时间列 + 7 天列(课程块绝对定位) -->
  <view class="grid-body">
    <!-- 节次时间列: 节号 + 上课时间(不再显示上午/下午/晚上分组, 把宽度让给课程块) -->
    <view class="time-col">
      <view class="sec-col">
        <view class="time-cell" wx:for="{{timeRows}}" wx:key="index">
          <text class="t-num">{{item.index}}</text>
          <text class="t-time">{{item.label || item.time}}</text>
        </view>
      </view>
    </view>

    <!-- 每天一列 -->
    <view class="day-col {{item.today ? 'today' : ''}}" wx:for="{{dayCols}}" wx:key="day">
      <!-- 课程块 -->
      <view
        wx:for="{{item.blocks}}"
        wx:key="index"
        wx:for-item="b"
        class="course-block"
        style="top: {{b._top}}rpx; height: {{b._height}}rpx; background: {{b._bg}}; border-left-color: {{b._bar}}; color: {{b._text}}"
        bindtap="onCourseTap"
        data-course="{{b}}"
      >
        <text class="cb-name" style="color: {{b._text}}">{{b.name}}</text>
        <!-- 教室(带 @ 前缀) 优先展示; 上课时间由网格位置表达, 不再占块内空间 -->
        <text class="cb-code" wx:if="{{b.classroom}}" style="color: {{b._text}}">@{{b.classroom}}</text>
      </view>
    </view>
  </view>

</view>
