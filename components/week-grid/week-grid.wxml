<!-- 周课表网格组件 — 大节分组布局 -->
<view class="week-grid">

  <!-- 表头：日期行 -->
  <view class="grid-header date-header">
    <view class="header-cell period-header"></view>
    <view
      class="header-cell date-cell {{index + 1 === todayDay ? 'today-col' : ''}}"
      wx:for="{{dateLabels}}"
      wx:key="index"
    >
      <text>{{item}}</text>
    </view>
  </view>

  <!-- 表头：星期 -->
  <view class="grid-header">
    <view class="header-cell period-header">节次</view>
    <view
      class="header-cell {{index + 1 === todayDay ? 'today-col' : ''}}"
      wx:for="{{weekdays}}"
      wx:key="*this"
    >
      <text>{{item}}</text>
    </view>
  </view>

  <!-- 大节行 -->
  <view class="grid-body">
    <view
      class="big-period-row"
      wx:for="{{bigPeriodRows}}"
      wx:key="label"
      wx:for-item="row"
      style="min-height: {{row.height}}rpx"
    >
      <!-- 节次标签 -->
      <view class="period-label" style="min-height: {{row.height}}rpx">
        <text class="period-name">{{row.label}}</text>
        <text class="period-time">{{row.time}}</text>
      </view>

      <!-- 每天的这一大节 -->
      <view
        class="day-cell {{index + 1 === todayDay ? 'today-col' : ''}}"
        wx:for="{{row.days}}"
        wx:key="index"
        wx:for-item="dayCell"
      >
        <!-- 课程块（不从大节顶部开始时带偏移占位，与桌面端一致） -->
        <block wx:for="{{dayCell.courses}}" wx:key="name" wx:for-item="course">
          <view wx:if="{{course._offsetHeight > 0}}" class="course-offset"
                style="height: {{course._offsetHeight}}rpx"></view>
          <view
            class="course-block {{course._cssClass}}"
            style="height: {{course._height}}rpx; background: {{course._color}}"
            bindtap="onCourseTap"
            data-course="{{course}}"
          >
            <text class="course-name">{{course.name}}</text>
            <text class="course-teacher" wx:if="{{course.teacher && course._isFirst}}">{{course.teacher}}</text>
            <text class="course-room" wx:if="{{course.classroom && course._isFirst}}">{{course.classroom}}</text>
            <!-- 单双周角标 -->
            <text class="week-badge" wx:if="{{course.week_type === 1 && course._isFirst}}">单</text>
            <text class="week-badge even" wx:if="{{course.week_type === 2 && course._isFirst}}">双</text>
          </view>
        </block>
      </view>
    </view>
  </view>

</view>
