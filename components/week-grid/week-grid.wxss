/* 周课表网格组件 — 小节行布局
   颜色/圆角/描边全部走主题变量, 三套主题共用同一份结构 */

.week-grid {
  margin: 0;
  background: var(--bg-card);
  overflow: hidden;
}

/* 表头 */
.grid-header {
  display: flex;
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--line);
}

.head-time {
  /* 必须与 .time-col 的宽度一致, 否则表头星期与下面的列错位 */
  flex: 0 0 76rpx;
  min-width: 76rpx;
}

.head-day {
  flex: 1;
  text-align: center;
  padding: 8rpx 0 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-muted);
  font-family: var(--font-display);
  border-left: 1rpx solid var(--line-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  line-height: 1.1;
}

/* 表头日期 */
.head-day .hd-date {
  font-size: 19rpx;
  font-weight: 500;
  opacity: .65;
}

/* 今天: 整个表头格填充暖色(主流做法, 比描边更容易一眼定位) */
.head-day.today {
  margin: 4rpx 5rpx;
  padding: 6rpx 0;
  border-left: none;
  border-radius: var(--radius-chip);
  background: var(--today-chip-bg);
  color: var(--today-chip-fg);
}

.head-day.today .hd-date {
  opacity: 1;
  font-weight: 700;
  color: var(--today-chip-fg);
}

/* 网格体(外层 scroll-view 统一滚动, 这里不再独立滚动) */
.grid-body {
  display: flex;
}

/* 节次时间列 */
.time-col {
  /* 去掉上午/下午/晚上分组列后收窄, 省出的宽度全部给课程块(教室要显示完整) */
  flex: 0 0 76rpx;
  min-width: 76rpx;
  display: flex;
  /* 时间轴: 清透主题是浅→深的渐变, 另两套主题三色相同即纯色 */
  background: linear-gradient(180deg, var(--tcol-start) 0%, var(--tcol-mid) 45%, var(--tcol-end) 100%);
}

.sec-col {
  flex: 1;
  min-width: 0;
}

.time-cell {
  height: 80rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--line-soft);
  border-right: 1rpx solid var(--line-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  line-height: 1;
}

/* 节号: 深一点的数字(扫视时先看节次) */
.t-num {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  font-family: var(--font-display);
}

/* 上课时间: 浅灰小字 */
.t-time {
  font-size: 17rpx;
  font-weight: 500;
  color: var(--text-hint);
  font-family: var(--font-display);
}

/* 每天列: 纯白底, 行线只画在 5 个大节边界(高透明浅线), 大节内部不细分 */
.day-col {
  flex: 1;
  min-width: 0;
  position: relative;
  border-left: 1rpx solid var(--line-soft);
  height: 1120rpx; /* 14 * 80 */
  background-color: transparent;
  background-image:
    linear-gradient(180deg, var(--grid-line), var(--grid-line)),
    linear-gradient(180deg, var(--grid-line), var(--grid-line)),
    linear-gradient(180deg, var(--grid-line), var(--grid-line)),
    linear-gradient(180deg, var(--grid-line), var(--grid-line)),
    linear-gradient(180deg, var(--grid-line), var(--grid-line));
  background-size: 100% 2rpx, 100% 2rpx, 100% 2rpx, 100% 2rpx, 100% 2rpx;
  background-repeat: no-repeat;
  background-position:
    0 239rpx,   /* 第4小节前(第一大节 1-3 结束) */
    0 399rpx,   /* 第6小节前(第二大节 4-5 结束) */
    0 559rpx,   /* 第8小节前(第三大节 6-7 结束) */
    0 799rpx,   /* 第11小节前(第四大节 8-10 结束) */
    0 1039rpx;  /* 第14小节前(第五大节 11-13 结束) */
}

/* 今天整列: 细描边圈出(极淡暖底 + 2rpx 暖圈), 不抢课程块的颜色 */
.day-col.today {
  background-color: var(--today-col-bg);
  box-shadow: inset 0 0 0 2rpx var(--today-ring);
  border-radius: var(--radius-chip);
}

/* 课程块: 绝对定位 + 圆角 + 左侧深色条 */
.course-block {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  box-sizing: border-box;
  /* 左色条宽度与整块描边宽度都来自主题(像素主题: 四周 2rpx 墨线) */
  border: var(--co-border-w) solid currentColor;
  border-left-width: var(--co-bar-w);
  border-radius: var(--co-radius);
  padding: 3rpx 6rpx 3rpx 8rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  box-shadow: none;
  transition: transform var(--motion-base) var(--ease-spring),
              box-shadow var(--motion-base) var(--ease-standard);
  animation: courseBlockIn 320ms var(--ease-spring) backwards;
  will-change: transform;
}

@keyframes courseBlockIn {
  from { opacity: 0; transform: scale(.94); }
  to   { opacity: 1; transform: scale(1); }
}

.course-block:active {
  transform: scale(.945);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, .18);
}

/* 课程名: 占满剩余空间、按块高自然换行 */
.cb-name {
  flex: 1;
  min-height: 0;
  display: -webkit-box;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.15;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: normal;
}

.cb-code {
  flex-shrink: 0;
  font-size: 16rpx;
  line-height: 1.12;
  /* 教室必须显示完整: 允许换行, 不做省略号截断 */
  white-space: normal;
  word-break: break-all;
}

