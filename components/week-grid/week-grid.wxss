/* 周课表网格组件 — 大节分组布局 */

.week-grid {
  background: #fff;
  margin: 12rpx 8rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

/* 表头 */
.grid-header {
  display: flex;
  border-bottom: 2rpx solid #E0E0E0;
  background: #F5F5F5;
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-cell {
  flex: 1;
  text-align: center;
  padding: 16rpx 4rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: var(--text-secondary);
  border-right: 1rpx solid #EEE;
}

.header-cell:last-child {
  border-right: none;
}

/* 日期行 */
.date-header {
  background: #FAFAFA;
  border-bottom: 1rpx solid #EEE;
}

.date-cell {
  font-size: 22rpx;
  font-weight: 500;
  color: #999;
  padding: 8rpx 4rpx;
}

/* 今日列高亮 */
.header-cell.today-col {
  background: #FFF8E1;
  color: #E65100;
  font-weight: bold;
}

.date-cell.today-col {
  color: #E65100;
  font-weight: bold;
}

.day-cell.today-col {
  background: #FFFDE7;
}

.period-header {
  flex: 0 0 80rpx;
  min-width: 80rpx;
}

/* 大节行 */
.grid-body {
  overflow-y: auto;
  max-height: calc(100vh - 200rpx);
}

.big-period-row {
  display: flex;
  border-bottom: 2rpx solid #E0E0E0;
  position: relative;
}

/* 节次标签 */
.period-label {
  flex: 0 0 80rpx;
  min-width: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAFAFA;
  border-right: 1rpx solid #E0E0E0;
  padding: 6rpx;
  box-sizing: border-box;
}

.period-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.3;
}

.period-time {
  font-size: 20rpx;
  color: #999;
  line-height: 1.3;
}

/* 每天格 */
.day-cell {
  flex: 1;
  min-width: 0;
  border-right: 1rpx solid #F0F0F0;
}

.day-cell:last-child {
  border-right: none;
}

/* 大节内偏移占位（课程不从大节顶部开始时，与桌面端 spacer 一致） */
.course-offset {
  width: 100%;
}

/* 课程块 */
.course-block {
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-radius: 8rpx;
  padding: 6rpx 8rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.12);
  margin: 2rpx;
  box-sizing: border-box;
}

/* 单双周左边框标识 */
.course-block.type-odd {
  border-left: 5rpx solid #FF9800;
}

.course-block.type-even {
  border-left: 5rpx solid #2196F3;
}

.course-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.course-teacher {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.course-room {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

/* 单双周角标 */
.week-badge {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  font-size: 18rpx;
  color: #fff;
  background: #FF9800;
  border-radius: 50%;
  width: 32rpx;
  height: 32rpx;
  text-align: center;
  line-height: 32rpx;
  font-weight: bold;
}

.week-badge.even {
  background: #2196F3;
}
