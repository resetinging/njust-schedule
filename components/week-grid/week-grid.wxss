/* 周课表网格组件 — 小节行布局(复刻目标 UI) */

.week-grid {
  margin: 0;
  background: #fff;
  overflow: hidden;
}

/* 表头 */
.grid-header {
  display: flex;
  position: sticky;
  top: 0;
  z-index: 10;
  background: #F7F6FB;
  border-bottom: 1rpx solid #EEEBF6;
}

.head-time {
  flex: 0 0 110rpx;
  min-width: 110rpx;
}

.head-day {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #4A4670;
  border-left: 1rpx solid #F1EFF8;
}

/* 网格体 */
.grid-body {
  display: flex;
  overflow-y: auto;
  max-height: calc(100vh - 340rpx);
}

/* 节次时间列 */
.time-col {
  flex: 0 0 110rpx;
  min-width: 110rpx;
}

.time-cell {
  height: 112rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #F1EFF8;
  border-right: 1rpx solid #F1EFF8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.t-num {
  font-size: 22rpx;
  font-weight: 700;
  color: #4A4670;
}

.t-time {
  font-size: 16rpx;
  color: #9A96B8;
}

/* 每天列: 相对容器 + 行线背景 */
.day-col {
  flex: 1;
  min-width: 0;
  position: relative;
  border-left: 1rpx solid #F1EFF8;
  height: 1568rpx; /* 14 * 112 */
  background-image: repeating-linear-gradient(
    180deg,
    #F1EFF8 0,
    #F1EFF8 1rpx,
    transparent 1rpx,
    transparent 112rpx
  );
}

/* 课程块: 绝对定位 + 圆角 + 左侧深色条 */
.course-block {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  box-sizing: border-box;
  border-left: 5rpx solid;
  border-radius: 10rpx;
  padding: 6rpx 8rpx 4rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  box-shadow: 0 2rpx 8rpx rgba(76, 70, 122, 0.10);
}

/* 课程名: 占满剩余空间、按块高自然换行 */
.cb-name {
  flex: 1;
  min-height: 0;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.25;
  overflow: hidden;
  word-break: break-all;
}

.cb-code {
  flex-shrink: 0;
  font-size: 16rpx;
  line-height: 1.2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cb-range {
  flex-shrink: 0;
  font-size: 16rpx;
  line-height: 1.2;
}
