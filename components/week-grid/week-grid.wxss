/* 周课表网格组件 — 小节行布局(复刻目标 UI) */

.week-grid {
  margin: 0;
  background: #fff;
  overflow: hidden;
}

/* 表头 */
.grid-header {
  display: flex;
  position: sticky;
  top: 0;
  z-index: 10;
  background: #F7F6FB;
  border-bottom: 1rpx solid #EEEBF6;
}

.head-time {
  flex: 0 0 110rpx;
  min-width: 110rpx;
}

.head-day {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #4A4670;
  border-left: 1rpx solid #F1EFF8;
}

/* 网格体(外层 scroll-view 统一滚动, 这里不再独立滚动) */
.grid-body {
  display: flex;
}

/* 节次时间列 */
.time-col {
  flex: 0 0 110rpx;
  min-width: 110rpx;
}

.time-cell {
  height: 80rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #F1EFF8;
  border-right: 1rpx solid #F1EFF8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  line-height: 1;
}

/* 节号: 浅灰小字 */
.t-num {
  font-size: 20rpx;
  font-weight: 600;
  color: #C0BBD9;
}

/* 上课时间: 深紫黑, 重点 */
.t-time {
  font-size: 17rpx;
  font-weight: 600;
  color: #44406B;
}

/* 每天列: 纯白底, 行线只画在 5 个大节边界(高透明浅线), 大节内部不细分 */
.day-col {
  flex: 1;
  min-width: 0;
  position: relative;
  border-left: 1rpx solid #F1EFF8;
  height: 1120rpx; /* 14 * 80 */
  background-color: transparent;
  background-image:
    linear-gradient(180deg, rgba(155, 145, 205, 0.35), rgba(155, 145, 205, 0.35)),
    linear-gradient(180deg, rgba(155, 145, 205, 0.35), rgba(155, 145, 205, 0.35)),
    linear-gradient(180deg, rgba(155, 145, 205, 0.35), rgba(155, 145, 205, 0.35)),
    linear-gradient(180deg, rgba(155, 145, 205, 0.35), rgba(155, 145, 205, 0.35)),
    linear-gradient(180deg, rgba(155, 145, 205, 0.35), rgba(155, 145, 205, 0.35));
  background-size: 100% 2rpx, 100% 2rpx, 100% 2rpx, 100% 2rpx, 100% 2rpx;
  background-repeat: no-repeat;
  background-position:
    0 239rpx,   /* 第4小节前(第一大节 1-3 结束) */
    0 399rpx,   /* 第6小节前(第二大节 4-5 结束) */
    0 559rpx,   /* 第8小节前(第三大节 6-7 结束) */
    0 799rpx,   /* 第11小节前(第四大节 8-10 结束) */
    0 1039rpx;  /* 第14小节前(第五大节 11-13 结束) */
}

/* 课程块: 绝对定位 + 圆角 + 左侧深色条 */
.course-block {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  box-sizing: border-box;
  border-left: 5rpx solid;
  border-radius: 10rpx;
  padding: 6rpx 8rpx 4rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  box-shadow: 0 2rpx 8rpx rgba(76, 70, 122, 0.10);
}

/* 课程名: 占满剩余空间、按块高自然换行 */
.cb-name {
  flex: 1;
  min-height: 0;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.25;
  overflow: hidden;
  word-break: break-all;
}

.cb-code {
  flex-shrink: 0;
  font-size: 16rpx;
  line-height: 1.2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cb-range {
  flex-shrink: 0;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.25;
}
