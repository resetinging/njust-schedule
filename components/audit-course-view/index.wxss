/* ==========================================================================
   蹭课查询 · 样式统一
   --------------------------------------------------------------------------
   · 颜色 / 圆角 / 间距 / 阴影 / 动效全部引用 styles/design-system.wxss 令牌
   · 去掉装饰圆（原两处 50% 圆）、厚投影、渐变；普通卡片与列表项一律无投影
   · 按压反馈由基座 .tap 提供，页面不再自定义缩放；图标按钮热区 ≥ 88rpx
   · 候选列表 / 长列表滚动为纯布局：不加 max-height、overflow 或滚动动画，
     面板只做定位；重复点击同一输入框时没有可重放的入场动画
   · 业务逻辑（本地索引、联动筛选、教师拆分、聚合、收藏）未改动
   ========================================================================== */

/* ============================================================
   容器与滚动
   ============================================================ */

.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  background: var(--bg-page);
}

.view-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  -webkit-overflow-scrolling: touch;
}

.page-content {
  padding: var(--space-md) var(--space-page) calc(48rpx + env(safe-area-inset-bottom));
}

/* ============================================================
   查询条件卡
   ============================================================ */

/* 层级保持原值：候选面板需要浮在结果卡片之上 */
.filter-card {
  position: relative;
  z-index: 5;
  padding: var(--space-lg);
  border: none;
  border-radius: var(--radius-island);
  background: var(--bg-card);
  box-shadow: var(--shadow-island);
}

.filter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  min-height: 48rpx;
}

.filter-title-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  min-width: 0;
}

.filter-head-ico {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex: none;
  border-radius: var(--radius-chip);
  background: var(--primary-soft);
}

.filter-title {
  color: var(--text-primary);
  font-size: var(--fs-section);
  font-weight: 700;
}

.filter-actions {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  flex: none;
}

.favorites-filter {
  display: flex;
  align-items: center;
  gap: var(--space-xxs);
  height: 56rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-pill);
  background: var(--bg-sunken);
  color: var(--text-secondary);
  font-size: var(--fs-cap);
  font-weight: 600;
}

.favorites-filter.active {
  background: var(--primary-soft);
  color: var(--primary-strong);
}

.favorites-count {
  min-width: 32rpx;
  padding: 0 var(--space-xs);
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  color: var(--primary);
  text-align: center;
  font-size: var(--fs-cap);
  line-height: 32rpx;
}

.explorer-open {
  display: flex;
  align-items: center;
  gap: var(--space-xxs);
  height: 56rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-pill);
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: var(--fs-cap);
  font-weight: 600;
}

.reset {
  display: flex;
  align-items: center;
  gap: var(--space-xxs);
  height: 56rpx;
  padding: 0 var(--space-sm);
  border-radius: var(--radius-control);
  color: var(--text-muted);
  font-size: var(--fs-cap);
}

/* ============================================================
   筛选输入行 + 候选面板
   ============================================================ */

.filter-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.filter-field {
  position: relative;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-height: 88rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-control);
  background: var(--bg-sunken);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  transform: translateZ(0);
  will-change: background-color, transform;
  transition: background-color var(--motion-fast) var(--ease-standard);
}

.filter-row:focus-within {
  background: var(--primary-soft);
}

.filter-ico {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  flex: none;
}

.filter-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  /* TDesign input 默认白底会盖住筛选行的灰底，需显式覆盖 */
  background: transparent !important;
  color: var(--text-primary);
  /* t-class 根节点与 TDesign 自身样式同优先级，需显式提升以覆盖默认小圆角 */
  border-radius: var(--radius-pill) !important;
}

/* 候选面板：只做定位与圆角裁剪，滚动由 WXML 内的 scroll-view 承担。
   面板本身不加 max-height / overflow 滚动 / 入场动画，避免重复点击时闪烁。 */
.suggest-panel {
  position: absolute;
  z-index: 40;
  top: 96rpx;
  left: 0;
  right: 0;
  overflow: hidden;
  border: none;
  border-radius: var(--radius-island);
  background: var(--bg-card);
  box-shadow: var(--shadow-island);
}

.suggest-scroll {
  width: 100%;
  -webkit-overflow-scrolling: touch;
}

/* 行高固定 68rpx：index.js 按 options.length * 68 计算面板高度（>5 项时上限 360rpx），
   此处不得改动，否则候选面板高度与内容会错位。 */
.suggest-item {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-height: 68rpx;
  padding: var(--space-sm) var(--space-md);
  border-bottom: var(--bw-card) solid var(--line-soft);
  color: var(--text-primary);
  font-size: var(--fs-sub);
  line-height: 1.4;
}

.suggest-item:last-child {
  border-bottom: 0;
}

.suggest-state {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  min-height: 96rpx;
  color: var(--text-hint);
  font-size: var(--fs-sub);
}

/* ============================================================
   时间条件 / 查询按钮
   ============================================================ */

.time-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.time-picker {
  min-width: 0;
}

.time-cell {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-xxs);
  min-width: 0;
  min-height: 88rpx;
  padding: var(--space-sm) var(--space-md);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-control);
  background: var(--bg-card);
}

.time-label {
  display: block;
  color: var(--text-hint);
  font-size: var(--fs-cap);
}

.time-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-xxs);
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--fs-sub);
  font-weight: 600;
}

.time-value-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.query-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  min-height: 88rpx;
  margin-top: var(--space-md);
  border-radius: var(--radius-pill);
  background: var(--primary);
  color: var(--bg-card);
  font-size: var(--fs-body);
  font-weight: 600;
}

/* ============================================================
   已选条件 / 结果摘要
   ============================================================ */

.active-filters {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  margin-top: var(--space-md);
  overflow-x: auto;
  white-space: nowrap;
}

.active-chip {
  display: flex;
  align-items: center;
  gap: var(--space-xxs);
  flex: none;
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-chip);
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: var(--fs-cap);
}

.active-chip-label {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.active-edit {
  flex: none;
  padding: var(--space-xs) var(--space-sm);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-control);
  background: var(--bg-card);
  color: var(--primary);
  font-size: var(--fs-cap);
  font-weight: 600;
}

.summary {
  margin: var(--space-md) 0 var(--space-xs);
  color: var(--text-muted);
  font-size: var(--fs-cap);
}

/* ============================================================
   结果卡片（普通卡片：无投影、无入场动画、无渐变）
   ============================================================ */

.course-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-top: var(--space-xs);
}

.course-card {
  padding: var(--space-lg);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  background: var(--bg-card);
}

.course-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.course-title-wrap {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  flex: 1;
  min-width: 0;
}

.course-card-ico {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex: none;
  border-radius: var(--radius-chip);
  background: var(--primary-soft);
}

.course-name {
  flex: 1;
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: 1.4;
}

.course-head-right {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  flex: none;
}

.course-day {
  padding: var(--space-xxs) var(--space-sm);
  border-radius: var(--radius-pill);
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: var(--fs-cap);
  font-weight: 600;
}

.course-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs);
}

.audit-status {
  display: inline-flex;
  align-items: center;
  padding: var(--space-xxs) var(--space-sm);
  border-radius: var(--radius-chip);
  background: var(--success-soft);
  color: var(--success);
  font-size: var(--fs-cap);
  font-weight: 600;
}

.audit-status.conflict {
  background: var(--signal-soft);
  color: var(--signal);
}

.audit-status.loading,
.audit-status.unavailable {
  background: var(--bg-sunken);
  color: var(--text-hint);
}

.favorite-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xxs);
  min-height: 56rpx;
  padding: 0 var(--space-sm);
  border-radius: var(--radius-control);
  background: var(--bg-sunken);
  color: var(--text-secondary);
  font-size: var(--fs-cap);
  font-weight: 600;
}

.favorite-btn.on {
  background: var(--primary-soft);
  color: var(--primary-strong);
}

.conflict-detail {
  margin-bottom: var(--space-xs);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-control);
  background: var(--signal-soft);
  color: var(--signal);
  font-size: var(--fs-cap);
  line-height: 1.45;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-height: 40rpx;
  color: var(--text-secondary);
  font-size: var(--fs-sub);
}

.meta-row-text {
  flex: 1;
  min-width: 0;
  line-height: 1.5;
  word-break: break-all;
}

/* ============================================================
   列表状态
   ============================================================ */

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: var(--space-md);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-control);
  background: var(--bg-card);
  color: var(--primary);
  font-size: var(--fs-body);
  font-weight: 600;
}

.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  color: var(--text-hint);
  font-size: var(--fs-sub);
}

.error {
  margin-top: var(--space-lg);
  padding: var(--space-md);
  border-radius: var(--radius-control);
  background: var(--danger-soft);
  color: var(--danger);
  text-align: center;
  font-size: var(--fs-sub);
}

/* ============================================================
   扩展查询弹层（t-popup 内部；自身只做布局，过渡交给 t-popup）
   ============================================================ */

.explorer-popup {
  /* 统一最大高度 88vh：TDesign 用 distance-top 计算，直接写 max-height 会被其自身规则覆盖 */
  --td-popup-distance-top: 12vh;
  /* 底部弹层统一规格：过渡只由 t-popup 负责（内容不自播入场/退出），
     遮罩色统一走 --td-overlay-bg-color，底部安全区由 t-popup--bottom 负责 */
  --td-popup-bg-color: var(--bg-card);
  --td-popup-border-radius: var(--radius-sheet);
  --td-popup-transition: all var(--motion-sheet) var(--ease-bounce);
  max-height: 88vh;
}

.explorer-sheet {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  background: var(--bg-page);
  overflow: hidden;
}

.explorer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  flex-shrink: 0;
  padding: var(--space-md) var(--space-page);
  background: var(--bg-card);
}

.explorer-title {
  display: block;
  color: var(--text-primary);
  font-size: var(--fs-page-title);
  font-weight: 700;
  line-height: 1.3;
}

.explorer-sub {
  display: block;
  margin-top: var(--space-xxs);
  color: var(--text-hint);
  font-size: var(--fs-cap);
}

/* 关闭：88rpx 热区、12rpx 圆角，不再使用装饰圆 */
.explorer-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border-radius: var(--radius-control);
  background: var(--bg-sunken);
}

.explorer-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-xs);
  flex-shrink: 0;
  padding: var(--space-sm) var(--space-page);
  border-top: var(--bw-card) solid var(--line-soft);
  background: var(--bg-card);
}

.explorer-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border-radius: var(--radius-control);
  background: var(--bg-sunken);
  color: var(--text-secondary);
  text-align: center;
  font-size: var(--fs-sub);
  font-weight: 600;
}

.explorer-tab.active {
  background: var(--primary);
  color: var(--bg-card);
}

.explorer-time-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-xs);
  flex-shrink: 0;
  padding: var(--space-sm) var(--space-page) var(--space-md);
  background: var(--bg-card);
}

.explorer-time-cell {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-xxs);
  min-width: 0;
  min-height: 88rpx;
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-control);
  background: var(--bg-sunken);
  color: var(--text-primary);
  text-align: center;
  font-size: var(--fs-sub);
  font-weight: 600;
}

.explorer-time-value {
  display: block;
  margin-top: var(--space-xxs);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.explorer-time-label {
  display: block;
  color: var(--text-hint);
  font-size: var(--fs-cap);
  font-weight: 500;
}

.explorer-recent {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  flex-shrink: 0;
  padding: var(--space-xs) var(--space-page) var(--space-sm);
  background: var(--bg-card);
  overflow-x: auto;
  white-space: nowrap;
}

.explorer-recent-label {
  flex: none;
  color: var(--text-hint);
  font-size: var(--fs-cap);
}

.recent-chip {
  flex: none;
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-chip);
  background: var(--bg-sunken);
  color: var(--text-secondary);
  font-size: var(--fs-cap);
}

.explorer-selected {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  flex-shrink: 0;
  padding: 0 var(--space-page) var(--space-sm);
  background: var(--bg-card);
}

.selected-chip {
  display: flex;
  align-items: center;
  gap: var(--space-xxs);
  max-width: 100%;
  padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-sm);
  border-radius: var(--radius-chip);
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: var(--fs-cap);
}

.selected-chip-label {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.explorer-search {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  flex-shrink: 0;
  min-height: 88rpx;
  margin: var(--space-md) var(--space-page) var(--space-xs);
  padding: 0 var(--space-md);
  border-radius: var(--radius-control);
  background: var(--bg-sunken);
}

.explorer-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  color: var(--text-primary);
  font-size: var(--fs-body);
}

/* 清除：88rpx 热区，负外边距保持右侧视觉留白 */
.explorer-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-right: calc(-1 * var(--space-md));
  flex: none;
}

.explorer-count {
  flex-shrink: 0;
  padding: var(--space-xs) var(--space-page) var(--space-sm);
  color: var(--text-hint);
  font-size: var(--fs-cap);
}

/* 列表滚动：纯 flex 高度，由 scroll-view 连续滚动；不设 max-height / 滚动动画 */
.explorer-body {
  position: relative;
  flex: 1;
  min-height: 0;
}

.explorer-scroll {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: var(--bg-card);
}

.explorer-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  min-height: 88rpx;
  padding: var(--space-sm) var(--space-page);
  border-bottom: var(--bw-card) solid var(--line-soft);
  color: var(--text-primary);
  font-size: var(--fs-body);
}

.explorer-item.selected {
  background: var(--primary-soft);
  color: var(--primary-strong);
}

.explorer-item-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  flex: 1;
  min-width: 0;
}

.explorer-item-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.explorer-item-count {
  flex: none;
  color: var(--text-hint);
  font-size: var(--fs-cap);
}

.explorer-check {
  width: 32rpx;
  flex: none;
  color: var(--primary);
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 700;
}

.explorer-load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: var(--space-sm) var(--space-page) var(--space-lg);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-control);
  background: var(--bg-sunken);
  color: var(--primary);
  font-size: var(--fs-sub);
  font-weight: 600;
}

.explorer-end {
  padding: var(--space-lg);
  color: var(--text-hint);
  font-size: var(--fs-cap);
  text-align: center;
}

.explorer-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  flex-shrink: 0;
  padding: var(--space-sm) var(--space-page) calc(var(--space-sm) + env(safe-area-inset-bottom));
  border-top: var(--bw-card) solid var(--line);
  background: var(--bg-card);
}

.explorer-footer-meta {
  display: flex;
  flex-direction: column;
  gap: var(--space-xxs);
  min-width: 0;
  color: var(--text-hint);
  font-size: var(--fs-cap);
}

.explorer-query {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  min-width: 240rpx;
  min-height: 88rpx;
  flex: none;
  border-radius: var(--radius-control);
  background: var(--primary);
  color: var(--bg-card);
  font-size: var(--fs-sub);
  font-weight: 600;
}

/* ============================================================
   周课表弹层（底部弹层：24rpx 顶部圆角，仅弹层保留轻投影）
   ============================================================ */

.weekly-popup {
  /* 统一最大高度 88vh：TDesign 用 distance-top 计算，直接写 max-height 会被其自身规则覆盖 */
  --td-popup-distance-top: 12vh;
  /* 底部弹层统一规格：过渡只由 t-popup 负责（内容不自播入场/退出），
     遮罩色统一走 --td-overlay-bg-color，底部安全区由 t-popup--bottom 负责 */
  --td-popup-bg-color: var(--bg-card);
  --td-popup-border-radius: var(--radius-sheet);
  --td-popup-transition: all var(--motion-sheet) var(--ease-bounce);
  max-height: 88vh;
}

.weekly-sheet {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  background: var(--bg-page);
  box-shadow: var(--shadow-sheet);
  overflow: hidden;
}

.weekly-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  flex-shrink: 0;
  padding: var(--space-md) var(--space-page);
  background: var(--bg-card);
}

.weekly-title-wrap {
  flex: 1;
  min-width: 0;
}

.weekly-title {
  display: block;
  color: var(--text-primary);
  font-size: var(--fs-page-title);
  font-weight: 700;
  line-height: 1.3;
}

.weekly-sub {
  display: block;
  margin-top: var(--space-xxs);
  color: var(--text-muted);
  font-size: var(--fs-sub);
}

.weekly-actions {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  flex-shrink: 0;
}

/* 周课表头的收藏是纯图标按钮：88rpx 热区 */
.weekly-actions .favorite-btn {
  justify-content: center;
  width: 88rpx;
  min-height: 88rpx;
  padding: 0;
  font-size: var(--fs-section);
}

/* 关闭：88rpx 热区、12rpx 圆角，不再使用装饰圆 */
.weekly-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: var(--radius-control);
  background: var(--bg-sunken);
}

.weekly-weekbar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
  flex-shrink: 0;
  padding: var(--space-sm) var(--space-page);
  border-top: var(--bw-card) solid var(--line-soft);
  border-bottom: var(--bw-card) solid var(--line);
  background: var(--bg-card);
}

.weekly-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border-radius: var(--radius-control);
  background: var(--bg-sunken);
}

.weekly-week-label {
  min-width: 160rpx;
  padding: var(--space-xs) var(--space-lg);
  border-radius: var(--radius-pill);
  background: var(--primary-soft);
  color: var(--primary-strong);
  text-align: center;
  font-size: var(--fs-sub);
  font-weight: 700;
}

.weekly-grid-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  background: var(--bg-card);
}

/* ============================================================
   减少动态效果：关掉本页残余过渡；入场动画已整体移除以避免列表重播
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  .filter-row,
  .suggest-item,
  .explorer-tab,
  .explorer-item,
  .course-card,
  .query-btn,
  .load-more {
    animation: none;
    transition: none;
  }
}
