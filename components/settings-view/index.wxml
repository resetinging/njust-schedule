<!-- 设置/登录视图组件 — 原 pages/settings 页面改造（方案A 合页 swiper） -->
<view class="container view-root" wx:if="{{active}}">

  <!-- 滚动内容区(scroll-view 内滚, 无下拉刷新) -->
  <scroll-view class="view-scroll" scroll-y>

  <!-- ============================================================ -->
  <!-- 公告栏(常驻, 登录前后均显示): 折叠展示, 点击展开全文即视为已读 -->
  <!-- ============================================================ -->
  <view class="announce-card" wx:if="{{announcement}}" bindtap="onToggleAnnounce">
    <view class="announce-head">
      <text class="announce-icon">📢</text>
      <text class="announce-title">公告</text>
      <text class="announce-new" wx:if="{{annIsNew}}">新</text>
      <text class="announce-state" wx:if="{{annLong}}">{{annExpanded ? '收起' : '查看全文'}}</text>
    </view>
    <view class="announce-body {{annExpanded || !annLong ? '' : 'clamped'}}">{{announcement}}</view>
  </view>

  <!-- ============================================================ -->
  <!-- 已登录状态 -->
  <!-- ============================================================ -->
  <view wx:if="{{isLoggedIn}}">

    <!-- 用户信息卡片(紫渐变) -->
    <view class="user-card card">
      <view class="avatar">👤</view>
      <view class="user-info">
        <text class="user-name">{{studentName || '未设置'}}</text>
        <text class="user-id">{{studentId}}</text>
      </view>
    </view>

    <!-- 信息行(灰底圆角) -->
    <view class="info-card">
      <view class="info-row">
        <text class="info-label">账号</text>
        <text class="info-value">{{studentId}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">姓名</text>
        <text class="info-value">{{studentName || '未设置'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">当前学期</text>
        <text class="info-value">{{semester || '未知'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">成绩数量</text>
        <text class="info-value">{{gradeCount}} 门</text>
      </view>
    </view>

    <!-- 快捷操作(简洁文字) -->
    <view class="action-list">
      <view class="action-item" bindtap="onGoFreeClass">
        <text>空教室查询</text>
        <text class="arrow">›</text>
      </view>
      <view class="action-item" bindtap="onGoGallery">
        <text>校历 & 照片墙</text>
        <text class="arrow">›</text>
      </view>
      <view class="action-item" bindtap="onOpenLinks">
        <text>常用链接</text>
        <text class="arrow">›</text>
      </view>
      <view class="action-item" bindtap="onOpenFeedback">
        <text>问题反馈</text>
        <text class="arrow">›</text>
      </view>
      <view class="action-item" bindtap="onOpenMyFeedback">
        <view class="action-label">
          <text>我的反馈</text>
          <text class="fb-dot" wx:if="{{fbUnread > 0}}">{{fbUnread > 99 ? '99+' : fbUnread}}</text>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="action-item" bindtap="onClearData">
        <text>清除缓存数据</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 校历设置 -->
    <view class="setting-card card">
      <view class="setting-title">学期第一周周一</view>
      <picker mode="date" value="{{firstWeekDate}}" bindchange="onFirstWeekDateChange">
        <view class="setting-value">{{firstWeekDate || '点击设置（课表自动跳转本周）'}}</view>
      </picker>
      <view class="setting-hint">设置后课表将自动定位当前教学周并高亮今天</view>
    </view>

    <!-- 按钮组(主/描边) -->
    <view class="btn-group">
      <button class="btn-primary main-btn" bindtap="onRefreshAll">重新同步课表与成绩</button>
      <button class="btn-outline main-btn" bindtap="onGoGrades">查看成绩</button>
    </view>

    <!-- 退出登录(白底红描边) -->
    <view class="logout-area">
      <button class="btn-danger-plain" bindtap="onLogout">退出登录</button>
    </view>
  </view>

  <!-- ============================================================ -->
  <!-- 未登录状态 -->
  <!-- ============================================================ -->
  <view wx:if="{{!isLoggedIn}}">
    <!-- 登录表单 -->
    <view class="login-card card">
      <view class="login-title">登录教务系统</view>

      <!-- 教务改版后仅保留智慧理工统一认证登录（教务直连已下线） -->
      <view class="mode-desc">智慧理工统一认证登录（校外可用）</view>

      <!-- 学号 -->
      <view class="form-group">
        <text class="form-label">学号</text>
        <input class="form-input" placeholder="请输入学号"
               value="{{studentId}}" bindinput="onStudentIdInput" />
      </view>

      <!-- 密码 -->
      <view class="form-group">
        <text class="form-label">智慧理工密码</text>
        <view class="pwd-row">
          <input class="form-input pwd-input" placeholder="请输入智慧理工密码"
                 password="{{!showPassword}}" value="{{password}}"
                 bindinput="onPasswordInput" />
          <text class="pwd-toggle" bindtap="onTogglePassword">{{showPassword ? '🙈' : '👁'}}</text>
        </view>
      </view>

      <!-- 记住学号密码 -->
      <view class="remember-row">
        <switch checked="{{rememberPwd}}" bindchange="onToggleRemember" color="#7C6BE8" style="transform:scale(0.8);" />
        <text class="remember-label" bindtap="onTapRemember">记住学号和密码</text>
      </view>

      <!-- 登录按钮(不禁用: 空表单点击时 onLogin 校验并提示, 避免"点了没反应") -->
      <button class="btn-primary login-btn" bindtap="onLogin"
              disabled="{{loggingIn}}">
        {{loggingIn ? '登录中…' : '登录'}}
      </button>
    </view>

    <!-- 提示 -->
    <view class="login-tip">
      <text>只填学号和智慧理工密码，一步直连教务，无需教务密码和验证码</text>
    </view>
  </view>

  <!-- 版本标识 -->
  <view class="version-tip">v1.1.0 · build {{build}}</view>

  </scroll-view>

  <!-- ============================================================ -->
  <!-- 问题反馈弹窗(不另开页面, 点击遮罩关闭) -->
  <!-- ============================================================ -->
  <view class="fb-mask" wx:if="{{showFeedback}}" bindtap="onFbClose">
    <view class="fb-card" catchtap="noop">
      <view class="fb-head">
        <text class="fb-title">问题反馈</text>
        <text class="fb-close" bindtap="onFbClose">✕</text>
      </view>

      <view class="fb-label">反馈类型</view>
      <view class="type-tabs">
        <view class="type-tab {{fbType === 'suggest' ? 'on' : ''}}" data-type="suggest" bindtap="onFbType">功能建议</view>
        <view class="type-tab {{fbType === 'bug' ? 'on' : ''}}" data-type="bug" bindtap="onFbType">问题/Bug</view>
        <view class="type-tab {{fbType === 'other' ? 'on' : ''}}" data-type="other" bindtap="onFbType">其他</view>
      </view>

      <view class="fb-label">反馈内容</view>
      <textarea class="fb-textarea" placeholder="请描述您遇到的问题或建议（500 字内）"
                value="{{fbContent}}" bindinput="onFbInput" maxlength="500"
                cursor-spacing="120" />
      <view class="fb-count">{{fbContent.length}} / 500</view>

      <button class="btn-primary fb-submit" bindtap="onFbSubmit" disabled="{{fbSending}}">
        {{fbSending ? '提交中…' : '提交反馈'}}
      </button>
    </view>
  </view>

  <!-- ============================================================ -->
  <!-- 我的反馈弹窗: 查看官方回复(有新回复时入口带小红点) -->
  <!-- ============================================================ -->
  <view class="fb-mask" wx:if="{{showMyFeedback}}" bindtap="onMyFbClose">
    <view class="fb-card" catchtap="noop">
      <view class="fb-head">
        <text class="fb-title">我的反馈</text>
        <text class="fb-close" bindtap="onMyFbClose">✕</text>
      </view>

      <view class="myfb-list">
        <view class="myfb-item" wx:for="{{myFeedback}}" wx:key="id">
          <view class="myfb-top">
            <text class="myfb-type">{{item._typeLabel}}</text>
            <text class="myfb-time">{{item.created_at}}</text>
            <text class="myfb-status {{item._reply ? 'replied' : 'pending'}}">{{item._reply ? '已回复' : '待处理'}}</text>
          </view>
          <view class="myfb-content">{{item.content}}</view>
          <view class="myfb-reply" wx:if="{{item._reply}}">
            <view class="myfb-reply-head">
              <text class="myfb-reply-tag">官方回复</text>
              <text class="myfb-reply-time" wx:if="{{item.replied_at}}">{{item.replied_at}}</text>
            </view>
            <view class="myfb-reply-text">{{item._reply}}</view>
          </view>
          <view class="myfb-noreply" wx:else>尚无回复，我们会尽快处理</view>
        </view>

        <view class="myfb-empty" wx:if="{{fbLoading}}"><text>加载中…</text></view>
        <view class="myfb-empty" wx:if="{{!fbLoading && myFeedback.length === 0}}">
          <text>还没有提交过反馈</text>
        </view>
      </view>

      <button class="btn-primary fb-submit" bindtap="onMyFbClose">关闭</button>
    </view>
  </view>

  <!-- ============================================================ -->
  <!-- 常用链接弹窗(点击复制; 小程序无法直接打开外部网页) -->
  <!-- ============================================================ -->
  <view class="fb-mask" wx:if="{{showLinks}}" bindtap="onLinksClose">
    <view class="fb-card" catchtap="noop">
      <view class="fb-head">
        <text class="fb-title">常用链接</text>
        <text class="fb-close" bindtap="onLinksClose">✕</text>
      </view>

      <view class="link-tip">点击复制链接，在浏览器粘贴打开 · 长按查看完整网址</view>

      <view class="link-list">
        <block wx:for="{{linkGroups}}" wx:key="title" wx:for-item="group">
          <view class="link-group-title">{{group.icon}} {{group.title}}（{{group.items.length}}）</view>
          <view class="link-row" wx:for="{{group.items}}" wx:key="url" wx:for-item="item"
                data-url="{{item.url}}" data-name="{{item.name}}"
                bindtap="onCopyLink" bindlongpress="onShowLink">
            <view class="link-main">
              <text class="link-name">{{item.name}}</text>
              <text class="link-url">{{item.url}}</text>
            </view>
            <text class="link-act">复制</text>
          </view>
        </block>

        <view class="link-empty" wx:if="{{linkGroups.length === 0}}">链接数据加载失败，请重新编译</view>
      </view>

      <view class="link-foot">共 {{linkTotal}} 个常用链接</view>
    </view>
  </view>

</view>
