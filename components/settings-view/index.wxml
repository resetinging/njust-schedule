<!-- 设置/登录视图组件 — 原 pages/settings 页面改造（方案A 合页 swiper） -->
<view class="container view-root" wx:if="{{active}}">

  <!-- 滚动内容区(scroll-view 内滚, 无下拉刷新) -->
  <scroll-view class="view-scroll" scroll-y>

  <!-- ============================================================ -->
  <!-- 已登录状态 -->
  <!-- ============================================================ -->
  <view wx:if="{{isLoggedIn}}">

    <!-- 用户信息卡片(紫渐变) -->
    <view class="user-card card">
      <view class="avatar">👤</view>
      <view class="user-info">
        <text class="user-name">{{studentName || '未设置'}}</text>
        <text class="user-id">{{studentId}}</text>
      </view>
    </view>

    <!-- 信息行(灰底圆角) -->
    <view class="info-card">
      <view class="info-row">
        <text class="info-label">账号</text>
        <text class="info-value">{{studentId}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">姓名</text>
        <text class="info-value">{{studentName || '未设置'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">当前学期</text>
        <text class="info-value">{{semester || '未知'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">成绩数量</text>
        <text class="info-value">{{gradeCount}} 门</text>
      </view>
    </view>

    <!-- 快捷操作(简洁文字) -->
    <view class="action-list">
      <view class="action-item" bindtap="onGoBoard">
        <text>留言板</text>
        <text class="arrow">›</text>
      </view>
      <view class="action-item" bindtap="onGoGallery">
        <text>校历 & 照片墙</text>
        <text class="arrow">›</text>
      </view>
      <view class="action-item" bindtap="onOpenFeedback">
        <text>问题反馈</text>
        <text class="arrow">›</text>
      </view>
      <view class="action-item" bindtap="onClearData">
        <text>清除缓存数据</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 校历设置 -->
    <view class="setting-card card">
      <view class="setting-title">学期第一周周一</view>
      <picker mode="date" value="{{firstWeekDate}}" bindchange="onFirstWeekDateChange">
        <view class="setting-value">{{firstWeekDate || '点击设置（课表自动跳转本周）'}}</view>
      </picker>
      <view class="setting-hint">设置后课表将自动定位当前教学周并高亮今天</view>
    </view>

    <!-- 按钮组(主/描边) -->
    <view class="btn-group">
      <button class="btn-primary main-btn" bindtap="onRefreshAll">重新同步课表与成绩</button>
      <button class="btn-outline main-btn" bindtap="onGoGrades">查看成绩</button>
    </view>

    <!-- 退出登录(白底红描边) -->
    <view class="logout-area">
      <button class="btn-danger-plain" bindtap="onLogout">退出登录</button>
    </view>
  </view>

  <!-- ============================================================ -->
  <!-- 未登录状态 -->
  <!-- ============================================================ -->
  <view wx:if="{{!isLoggedIn}}">
    <!-- 登录表单 -->
    <view class="login-card card">
      <view class="login-title">登录教务系统</view>

      <!-- 登录模式切换 -->
      <view class="mode-tabs">
        <view class="mode-tab {{loginMode === 'direct' ? 'active' : ''}}"
              data-mode="direct" bindtap="switchLoginMode">🏫 教务直连</view>
        <view class="mode-tab {{loginMode === 'webvpn' ? 'active' : ''}}"
              data-mode="webvpn" bindtap="switchLoginMode">🌐 智慧理工</view>
      </view>
      <view class="mode-desc" wx:if="{{loginMode === 'webvpn'}}">
        两步登录：Step 1 智慧理工 SSO 验证 → Step 2 教务系统登录（适合校外网络）
      </view>
      <view class="mode-desc" wx:else>直接登录教务系统（需教务可达）</view>

      <!-- 学号 -->
      <view class="form-group">
        <text class="form-label">学号</text>
        <input class="form-input" placeholder="请输入学号"
               value="{{studentId}}" bindinput="onStudentIdInput" />
      </view>

      <!-- 密码 -->
      <view class="form-group">
        <text class="form-label">{{loginMode === 'webvpn' ? '智慧理工密码（Step 1）' : '教务密码'}}</text>
        <view class="pwd-row">
          <input class="form-input pwd-input" placeholder="{{loginMode === 'webvpn' ? '请输入智慧理工密码' : '请输入教务密码'}}"
                 password="{{!showPassword}}" value="{{password}}"
                 bindinput="onPasswordInput" />
          <text class="pwd-toggle" bindtap="onTogglePassword">{{showPassword ? '🙈' : '👁'}}</text>
        </view>
        <view class="pwd-hint" wx:if="{{loginMode === 'direct'}}">💡 教务处默认密码为: 学号 + @Njust（如未修改过）</view>
      </view>

      <!-- 记住学号密码 -->
      <view class="remember-row">
        <switch checked="{{rememberPwd}}" bindchange="onToggleRemember" color="#7C6BE8" style="transform:scale(0.8);" />
        <text class="remember-label" bindtap="onTapRemember">记住学号和密码（保存在本机）</text>
      </view>

      <!-- 教务密码（智慧理工模式，与智慧理工密码相同可留空） -->
      <view class="form-group" wx:if="{{loginMode === 'webvpn'}}">
        <text class="form-label">教务密码（Step 2，不同时填写）</text>
        <view class="pwd-row">
          <input class="form-input pwd-input" placeholder="教务密码与智慧理工密码相同可留空"
                 password="{{!showJwcPassword}}" value="{{jwcPassword}}"
                 bindinput="onJwcPasswordInput" />
          <text class="pwd-toggle" bindtap="onToggleJwcPassword">{{showJwcPassword ? '🙈' : '👁'}}</text>
        </view>
      </view>

      <!-- 验证码 -->
      <view class="form-group">
        <text class="form-label">{{loginMode === 'webvpn' ? (ssoStepDone ? '教务验证码（Step 2）' : '验证码（点击右侧刷新完成 Step 1）') : '验证码'}}</text>
        <captcha-input src="{{captchaSrc}}" value="{{captcha}}"
                       bind:input="onCaptchaInput" bind:refresh="onRefreshCaptcha" />
      </view>

      <!-- 登录按钮(不禁用: 空表单点击时 onLogin 校验并提示, 避免"点了没反应") -->
      <button class="btn-primary login-btn" bindtap="onLogin"
              disabled="{{loggingIn}}">
        {{loggingIn ? '登录中…' : (loginMode === 'webvpn' ? '智慧理工登录' : (captcha ? '登录' : '登录（自动识别验证码）'))}}
      </button>
    </view>

    <!-- 提示 -->
    <view class="login-tip">
      <text>{{loginMode === 'webvpn' ? '智慧理工密码与教务密码可能不同，请分别填写' : '登录后即可查看课表、考试与成绩'}}</text>
    </view>
  </view>

  <!-- 版本标识 -->
  <view class="version-tip">v1.1.0 · build {{build}}</view>

  </scroll-view>

  <!-- ============================================================ -->
  <!-- 问题反馈弹窗(不另开页面, 点击遮罩关闭) -->
  <!-- ============================================================ -->
  <view class="fb-mask" wx:if="{{showFeedback}}" bindtap="onFbClose">
    <view class="fb-card" catchtap="noop">
      <view class="fb-head">
        <text class="fb-title">问题反馈</text>
        <text class="fb-close" bindtap="onFbClose">✕</text>
      </view>

      <view class="fb-label">反馈类型</view>
      <view class="type-tabs">
        <view class="type-tab {{fbType === 'suggest' ? 'on' : ''}}" data-type="suggest" bindtap="onFbType">功能建议</view>
        <view class="type-tab {{fbType === 'bug' ? 'on' : ''}}" data-type="bug" bindtap="onFbType">问题/Bug</view>
        <view class="type-tab {{fbType === 'other' ? 'on' : ''}}" data-type="other" bindtap="onFbType">其他</view>
      </view>

      <view class="fb-label">反馈内容</view>
      <textarea class="fb-textarea" placeholder="请描述您遇到的问题或建议（500 字内）"
                value="{{fbContent}}" bindinput="onFbInput" maxlength="500"
                cursor-spacing="120" />
      <view class="fb-count">{{fbContent.length}} / 500</view>

      <button class="btn-primary fb-submit" bindtap="onFbSubmit" disabled="{{fbSending}}">
        {{fbSending ? '提交中…' : '提交反馈'}}
      </button>
    </view>
  </view>

</view>
