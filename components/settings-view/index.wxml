<!-- 设置/登录视图组件 — 原 pages/settings 页面改造（方案A 合页 swiper） -->
<view class="container view-root {{fontSwitching ? 'font-switching' : ''}} {{entering ? 'is-entering' : ''}}" wx:if="{{active}}">

  <!-- 滚动内容区(scroll-view 内滚, 无下拉刷新) -->
  <scroll-view class="view-scroll" scroll-y>

  <!-- ============================================================ -->
  <!-- 公告栏(常驻, 登录前后均显示): 折叠展示, 点击展开全文即视为已读 -->
  <!-- ============================================================ -->
  <view class="announce-card tap" wx:if="{{announcement}}" bindtap="onToggleAnnounce">
    <view class="announce-head">
      <view class="announce-icon"><icon name="megaphone" size="28" color="#2563EB" /></view>
      <text class="announce-title">公告</text>
      <text class="announce-new" wx:if="{{annIsNew}}">新</text>
      <text class="announce-state" wx:if="{{annLong}}">{{annExpanded ? '收起' : '查看全文'}}</text>
    </view>
    <view class="announce-body {{annExpanded || !annLong ? '' : 'clamped'}}">{{announcement}}</view>
  </view>

  <!-- ============================================================ -->
  <!-- 已登录状态 -->
  <!-- ============================================================ -->
  <view wx:if="{{isLoggedIn}}">

    <!-- 身份面板: 只保留身份信息, 指标与校历单独分层 -->
    <view class="user-card card">
      <view class="user-top">
        <view class="avatar"><icon name="user" size="40" color="#2563EB" /></view>
        <view class="user-info">
          <text class="user-name">{{studentName || '未设置'}}</text>
          <text class="user-id">{{studentId}}</text>
        </view>
        <text class="user-semester">{{semester || '未知学期'}}</text>
      </view>
    </view>

    <!-- 关键指标行 -->
    <view class="profile-metrics card">
      <view class="user-overview">
        <view class="user-overview-item">
          <text class="user-overview-value">{{gradeCount}}</text>
          <text class="user-overview-label">成绩记录</text>
        </view>
        <view class="user-overview-divider"></view>
        <view class="user-overview-item">
          <text class="user-overview-value">{{gpa}}</text>
          <text class="user-overview-label">总 GPA</text>
        </view>
        <view class="user-overview-divider"></view>
        <view class="user-overview-item">
          <text class="user-overview-value credit-value">{{creditProgress}}</text>
          <text class="user-overview-label">学分进度</text>
        </view>
      </view>
    </view>

    <!-- 校历校准 -->
    <view class="profile-calibration card">
      <view class="user-calibration">
        <picker class="calibration-picker" mode="date" value="{{firstWeekDate}}" bindchange="onFirstWeekDateChange">
          <view class="calibration-inline tap">
            <view class="calibration-icon"><icon name="calendar" size="28" color="#2563EB" /></view>
            <view class="calibration-copy">
              <text class="calibration-title">第一周周一</text>
            </view>
            <text class="calibration-value">{{firstWeekDate || '设置'}}</text>
            <view class="calibration-arrow"><icon name="next" size="24" color="#64748B" /></view>
          </view>
        </picker>
        <view class="sync-inline tap" bindtap="onSyncCalendar">
          <view class="sync-icon {{calendarSyncing ? 'spin' : ''}}"><icon name="refresh" size="28" color="#2563EB" /></view>
          <text>{{calendarSyncing ? '同步中…' : '从教务同步'}}</text>
        </view>
      </view>
    </view>

    <!-- 界面字体: 紧凑分段选择 -->
    <view class="profile-section-label">偏好</view>
    <view class="setting-card card">
      <view class="group-title">界面字体</view>
      <view class="font-seg">
        <view class="font-choice f-pixel tap {{fontMode === 'pixel' ? 'on' : ''}}" data-mode="pixel" bindtap="onPickFont">
          <text class="font-name">像素点阵</text>
        </view>
        <view class="font-choice f-system tap {{fontMode === 'system' ? 'on' : ''}}" data-mode="system" bindtap="onPickFont">
          <text class="font-name">系统字体</text>
        </view>
      </view>
    </view>

    <!-- 消息提醒(订阅消息): 授权一次可发一条; 服务端未配置时不显示 -->
    <view class="profile-section-label service-label">服务</view>
    <view class="notice-card" wx:if="{{subKinds.length > 0}}">
      <view class="act-row tap" bindtap="onOpenSubscriptions">
        <view class="notice-dot {{subHasQuota ? 'on' : ''}}"></view>
        <view class="act-main">
          <text class="act-title">消息提醒</text>
          <text class="act-sub">{{subSummary}}</text>
        </view>
        <view class="act-arrow"><icon name="next" size="26" color="#64748B" /></view>
      </view>
    </view>

    <!-- 帮助与反馈(弹窗实现都在本组件内, 入口必须放在同一页, 否则会先跳页再弹窗) -->
    <view class="menu-card">
      <view class="act-row tap {{testingConnection ? 'is-disabled' : ''}}" bindtap="onTestConnection">
        <view class="menu-ico"><icon name="sync" size="28" color="#2563EB" /></view>
        <view class="menu-copy">
          <text class="act-title">测试连接</text>
          <text class="act-sub {{connectionStatus === 'ok' ? 'is-ok' : (connectionStatus === 'fail' ? 'is-fail' : '')}}"
                wx:if="{{connectionText}}">{{connectionText}}</text>
        </view>
        <view class="act-arrow"><icon name="next" size="26" color="#64748B" /></view>
      </view>
      <view class="act-row tap" bindtap="onOpenLinks">
        <view class="menu-ico"><icon name="grid" size="28" color="#2563EB" /></view>
        <view class="menu-copy"><text class="act-title">常用链接</text></view>
        <view class="act-arrow"><icon name="next" size="26" color="#64748B" /></view>
      </view>
      <view class="act-row tap" bindtap="onOpenFeedback">
        <view class="menu-ico"><icon name="doc" size="28" color="#2563EB" /></view>
        <view class="menu-copy"><text class="act-title">问题反馈</text></view>
        <view class="act-arrow"><icon name="next" size="26" color="#64748B" /></view>
      </view>
      <view class="act-row tap" bindtap="onOpenMyFeedback">
        <view class="menu-ico"><icon name="clipboard" size="28" color="#2563EB" /></view>
        <view class="menu-copy"><text class="act-title">我的反馈</text></view>
        <text class="act-badge" wx:if="{{fbUnread > 0}}">{{fbUnread > 99 ? '99+' : fbUnread}}</text>
        <view class="act-arrow"><icon name="next" size="26" color="#64748B" /></view>
      </view>
      <view class="act-row tap" bindtap="onOpenAppreciate">
        <view class="menu-ico"><icon name="award" size="28" color="#2563EB" /></view>
        <view class="menu-copy"><text class="act-title">赞赏支持</text></view>
        <view class="act-arrow"><icon name="next" size="26" color="#64748B" /></view>
      </view>
    </view>

    <!-- 底部操作: 清除缓存 / 退出登录(放在最下方, 危险操作标红) -->
    <view class="btn-group">
      <t-button t-class="btn-outline main-btn clear-btn" theme="primary" variant="outline" block bind:tap="onClearData">清除缓存数据</t-button>
      <t-button t-class="btn-danger-plain main-btn logout-btn" theme="danger" variant="text" block
                wx:if="{{isLoggedIn}}" bind:tap="onLogout">退出登录</t-button>
    </view>
    <view id="slot-profile-bottom" class="analytics-slot-marker"></view>
  </view>

  <!-- ============================================================ -->
  <!-- 未登录状态 -->
  <!-- ============================================================ -->
  <view wx:if="{{!isLoggedIn}}">
    <!-- 登录表单 -->
    <view class="login-card card">
      <view class="login-title">登录教务系统</view>

      <!-- 教务改版后仅保留智慧理工统一认证登录（教务直连已下线） -->
      <view class="mode-desc">智慧理工统一认证</view>

      <!-- 学号 -->
      <view class="form-group">
        <text class="form-label">学号</text>
        <t-input t-class="form-input" placeholder="请输入学号" clearable
                 value="{{studentId}}" bind:change="onStudentIdInput" />
      </view>

      <!-- 密码 -->
      <view class="form-group">
        <text class="form-label">智慧理工密码</text>
        <view class="pwd-row">
          <t-input t-class="form-input pwd-input" placeholder="请输入智慧理工密码"
                   type="{{showPassword ? 'text' : 'password'}}" value="{{password}}"
                   bind:change="onPasswordInput" />
          <view class="pwd-toggle tap" bindtap="onTogglePassword">
            <view class="pwd-eye {{showPassword ? 'pwd-eye-on' : ''}}"></view>
          </view>
        </view>
      </view>

      <!-- 登录按钮(不禁用: 空表单点击时 onLogin 校验并提示, 避免"点了没反应") -->
      <t-button t-class="btn-primary login-btn" theme="primary" block bind:tap="onLogin"
                loading="{{loggingIn}}" disabled="{{loggingIn}}">
        {{loggingIn ? '登录中…' : '登录'}}
      </t-button>

      <!-- 微信扫码登录(免密码): 长按二维码 → 识别图中二维码 → 确认登录 -->
      <view wx:if="{{!qrMode}}" class="qr-entry">
        <text class="qr-entry-link tap" bindtap="onStartQr">扫码登录</text>
      </view>
      <view wx:else class="qr-panel">
        <image class="qr-img tap" src="{{qrSrc}}" mode="widthFix"
               show-menu-by-longpress="{{true}}" binderror="onQrImgError"
               bindtap="onQrPreview" />
        <view class="qr-panel-hint">{{qrHint}}</view>
        <t-button t-class="qr-save-btn" theme="primary" variant="outline" size="small" bind:tap="onQrSave">保存到相册</t-button>
        <view class="qr-save-tip">用微信「扫一扫」→ 相册，选择刚保存的二维码</view>
        <view class="qr-panel-actions">
          <text class="qr-link tap" bindtap="onStartQr">刷新</text>
          <text class="qr-link tap" bindtap="onQrConfirmTap">我已确认</text>
          <text class="qr-link tap" bindtap="onCloseQr">返回</text>
        </view>
      </view>
    </view>

    <!-- 提示 -->
    <view class="login-tip">
      <text>使用智慧理工统一认证账号，无需教务密码</text>
    </view>
  </view>

  <!-- 版本标识 -->
  <view class="version-tip">v1.2.0 · build {{build}}</view>

  </scroll-view>

  <!-- ============================================================ -->
  <!-- 问题反馈底部面板 -->
  <!-- ============================================================ -->
  <t-popup t-class="settings-popup" visible="{{showFeedback}}" placement="bottom"
           duration="{{280}}" close-on-overlay-click
           bind:visible-change="onFeedbackVisibleChange">
    <view class="fb-card">
      <view class="fb-head">
        <text class="fb-title">问题反馈</text>
        <view class="fb-close tap" bindtap="onFbClose"><icon name="close" size="26" color="#64748B" /></view>
      </view>

      <view class="fb-label">反馈类型</view>
      <view class="type-tabs">
        <view class="type-tab tap {{fbType === 'suggest' ? 'on' : ''}}" data-type="suggest" bindtap="onFbType">功能建议</view>
        <view class="type-tab tap {{fbType === 'bug' ? 'on' : ''}}" data-type="bug" bindtap="onFbType">问题/Bug</view>
        <view class="type-tab tap {{fbType === 'other' ? 'on' : ''}}" data-type="other" bindtap="onFbType">其他</view>
      </view>

      <view class="fb-label">反馈内容</view>
      <t-textarea t-class="fb-textarea" placeholder="请描述您遇到的问题或建议（500 字内）"
                  value="{{fbContent}}" bind:change="onFbInput" maxlength="500" indicator
                  cursor-spacing="120" />
      <view class="fb-count">{{fbContent.length}} / 500</view>

      <t-button t-class="btn-primary fb-submit" theme="primary" block bind:tap="onFbSubmit"
                loading="{{fbSending}}" disabled="{{fbSending}}">
        {{fbSending ? '提交中…' : '提交反馈'}}
      </t-button>
    </view>
  </t-popup>

  <!-- ============================================================ -->
  <!-- 我的反馈面板: 查看官方回复(有新回复时入口带小红点) -->
  <!-- ============================================================ -->
  <t-popup t-class="settings-popup" visible="{{showMyFeedback}}" placement="bottom"
           duration="{{280}}" close-on-overlay-click
           bind:visible-change="onMyFeedbackVisibleChange">
    <view class="fb-card">
      <view class="fb-head">
        <text class="fb-title">我的反馈</text>
        <view class="fb-close tap" bindtap="onMyFbClose"><icon name="close" size="26" color="#64748B" /></view>
      </view>

      <view class="myfb-list">
        <view class="myfb-item" wx:for="{{myFeedback}}" wx:key="id">
          <view class="myfb-top">
            <text class="myfb-type">{{item._typeLabel}}</text>
            <text class="myfb-time">{{item.created_at}}</text>
            <text class="myfb-status {{item._reply ? 'replied' : 'pending'}}">{{item._reply ? '已回复' : '待处理'}}</text>
          </view>
          <view class="myfb-content">{{item.content}}</view>
          <view class="myfb-reply" wx:if="{{item._reply}}">
            <view class="myfb-reply-head">
              <text class="myfb-reply-tag">官方回复</text>
              <text class="myfb-reply-time" wx:if="{{item.replied_at}}">{{item.replied_at}}</text>
            </view>
            <view class="myfb-reply-text">{{item._reply}}</view>
          </view>
          <view class="myfb-noreply" wx:else>尚无回复，我们会尽快处理</view>
        </view>

        <view class="myfb-empty" wx:if="{{fbLoading}}"><t-loading theme="circular" size="36rpx" text="加载中…" /></view>
        <view class="myfb-empty" wx:if="{{!fbLoading && myFeedback.length === 0}}">
          <text>还没有提交过反馈</text>
        </view>
      </view>

      <t-button t-class="btn-primary fb-submit" theme="primary" block bind:tap="onMyFbClose">关闭</t-button>
    </view>
  </t-popup>

  <!-- ============================================================ -->
  <!-- 常用链接面板(点击复制; 小程序无法直接打开外部网页) -->
  <!-- ============================================================ -->
  <t-popup t-class="settings-popup" visible="{{showLinks}}" placement="bottom"
           duration="{{280}}" close-on-overlay-click
           bind:visible-change="onLinksVisibleChange">
    <view class="fb-card">
      <view class="fb-head">
        <text class="fb-title">常用链接</text>
        <view class="fb-close tap" bindtap="onLinksClose"><icon name="close" size="26" color="#64748B" /></view>
      </view>

      <view class="link-tip">点击复制链接，在浏览器粘贴打开 · 长按查看完整网址</view>

      <view class="link-list">
        <block wx:for="{{linkGroups}}" wx:key="title" wx:for-item="group">
          <view class="link-group-title">{{group.icon}} {{group.title}}（{{group.items.length}}）</view>
          <view class="link-row tap" wx:for="{{group.items}}" wx:key="url" wx:for-item="item"
                data-url="{{item.url}}" data-name="{{item.name}}"
                bindtap="onCopyLink" bindlongpress="onShowLink">
            <view class="link-main">
              <text class="link-name">{{item.name}}</text>
              <text class="link-url">{{item.url}}</text>
            </view>
            <text class="link-act">复制</text>
          </view>
        </block>

        <view class="link-empty" wx:if="{{linkGroups.length === 0}}">链接数据加载失败，请重新编译</view>
      </view>

      <view class="link-foot">共 {{linkTotal}} 个常用链接</view>
    </view>
  </t-popup>

  <!-- 消息提醒管理面板: 考试/成绩分别授权，额度独立 -->
  <t-popup t-class="settings-popup" visible="{{showSubscriptions}}" placement="bottom"
           duration="{{280}}" close-on-overlay-click
           bind:visible-change="onSubscriptionsVisibleChange">
    <view class="fb-card sub-card">
      <view class="fb-head">
        <text class="fb-title">消息提醒</text>
        <view class="fb-close tap" bindtap="onSubscriptionsClose"><icon name="close" size="26" color="#64748B" /></view>
      </view>
      <view class="sub-tip">微信每次授权可发送一条；勾选“总是保持以上选择”后，可继续点击累积额度。</view>
      <view class="notice-card sub-list">
        <view class="act-row tap" wx:for="{{subKinds}}" wx:key="kind"
              data-kind="{{item.kind}}" bindtap="onSubscribeTap">
          <view class="notice-dot {{item.quota > 0 ? 'on' : ''}}"></view>
          <view class="act-main">
            <text class="act-title">{{item.label}}</text>
            <text class="act-sub">{{item.quota > 0 ? ('已开启 · 剩余 ' + item.quota + ' 条') : '点一下开启，可重复点击囤额度'}}</text>
          </view>
          <text class="act-plus">{{item.quota > 0 ? '＋1' : '开启'}}</text>
        </view>
      </view>
    </view>
  </t-popup>

  <!-- 赞赏支持面板: 显示赞赏码(长按可保存/识别, 点击可放大) -->
  <t-popup t-class="settings-popup" visible="{{showAppreciate}}" placement="bottom"
           duration="{{280}}" close-on-overlay-click
           bind:visible-change="onAppreciateVisibleChange">
    <view class="fb-card appreciate-card">
      <view class="fb-head">
        <text class="fb-title">赞赏支持</text>
        <view class="fb-close tap" bindtap="onCloseAppreciate"><icon name="close" size="26" color="#64748B" /></view>
      </view>
      <image class="appreciate-img" src="/static/appreciate.jpg" mode="widthFix"
             show-menu-by-longpress="{{true}}" />
      <view class="appreciate-tip">如果这个小工具帮到了你，欢迎支持后续维护</view>
      <view class="appreciate-sub">长按图片可保存或识别</view>
    </view>
  </t-popup>

</view>
