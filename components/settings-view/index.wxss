/* 设置/登录页面样式 */

/* ---- 快捷操作卡片(自有实现) ---- */
.act-card {
  margin: 12rpx 20rpx 0;
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.act-row {
  display: flex;
  align-items: center;
  padding: 20rpx 18rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.act-row:last-child { border-bottom: none; }
.act-row:active { background: var(--bg-hover); }

.act-title {
  flex: 1;
  font-size: 29rpx;
  color: var(--text-primary);
}

.act-badge {
  margin-right: 14rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--signal);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.act-arrow {
  width: 40rpx;
  height: 40rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.act-title.act-danger { color: var(--danger); }

/* 消息提醒: 主标题 + 副行(剩余次数)与底部说明 */
.act-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.act-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--text-hint);
}

.act-note {
  padding: 12rpx 18rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-hint);
}

.act-plus {
  flex: none;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--brand-soft, #EFF6FF);
  color: var(--brand, #2563EB);
  font-size: 24rpx;
  font-weight: 600;
}

/* 分组标题(账号 / 数据与账号 / 字体) */
.group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-hint);
  margin-bottom: 6rpx;
}

.info-arrow {
  width: 36rpx;
  height: 36rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
}

/* 入口行右侧的值 */
.act-value {
  margin-right: 12rpx;
  font-size: 26rpx;
  color: var(--text-hint);
}

/* 二级页返回条 */
.sub-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin: 12rpx 20rpx 4rpx;
  padding: 14rpx 18rpx;
  font-size: 27rpx;
  color: var(--primary);
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
}

.sub-back:active { background: var(--bg-hover); }
.sub-back-ico { font-size: 32rpx; }

/* 用户卡一行式: 头像 + 姓名/学号 + 学期 */
.user-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.user-card .user-info { flex: 1; min-width: 0; }

.user-semester {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  color: var(--primary-dark);
  font-size: 22rpx;
  font-weight: 600;
}

/* ---- 字体档位选择 ---- */
.font-row {
  display: flex;
  align-items: center;
  padding: 15rpx 4rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

/* 每一行用"它自己那种字体"渲染, 相当于字体预览 */
.font-row.f-pixel { font-family: "ZpixPixel", "PingFang SC", monospace; }
.font-row.f-system { font-family: var(--font-plain); }

.font-row:last-child { border-bottom: none; }
.font-row:active { background: var(--bg-hover); }

.font-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.font-name {
  font-size: 29rpx;
  color: var(--text-primary);
}

.font-tick {
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 700;
}

/* ============================================================
   紧凑化: 统一收紧卡片间距与行高(放在最后, 覆盖上面的零散定义)
   ============================================================ */
.announce-card { margin: 12rpx 20rpx 0 !important; padding: 18rpx 20rpx !important; }
.user-card { margin: 12rpx 20rpx 0 !important; padding: 20rpx 20rpx !important; }
.info-card { margin: 12rpx 20rpx 0 !important; padding: 14rpx 16rpx !important; gap: 8rpx !important; }
.info-row { padding: 12rpx 18rpx !important; }
/* 行内: 标签左、值右(日期等靠右对齐, 与箭头同一侧) */
.info-row .info-label { flex-shrink: 0; }
.info-row .info-value { flex: 1; text-align: right; }
.act-card { margin: 12rpx 20rpx 0 !important; }
.act-row { padding: 20rpx 18rpx !important; }
.font-row { padding: 15rpx 4rpx !important; }
.setting-card { margin: 12rpx 20rpx 0 !important; padding: 18rpx 20rpx !important; }
.setting-title { margin-bottom: 8rpx !important; }
.btn-group { margin: 16rpx 20rpx 0 !important; }
.version-tip { margin-top: 22rpx !important; padding-bottom: 26rpx !important; }

/* 微信扫码登录 */
.qr-entry {
  margin-top: 24rpx;
  text-align: center;
}

.qr-entry-link {
  font-size: 28rpx;
  color: var(--primary);
}

.qr-panel {
  margin-top: 20rpx;
  text-align: center;
}

.qr-img {
  width: 520rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-ctrl);
  padding: 16rpx;
}

.qr-panel-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 16rpx;
  min-height: 34rpx;
}

.qr-save-btn {
  margin-top: 20rpx;
  background: var(--primary);
  color: var(--bg-card);
  border-radius: var(--radius-ctrl);
  font-size: 30rpx;
  line-height: 84rpx;
  height: 84rpx;
  padding: 0;
}

.qr-save-tip {
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1.6;
  margin-top: 12rpx;
}

.qr-panel-actions {
  display: flex;
  justify-content: space-around;
  margin-top: 22rpx;
}

.qr-link {
  font-size: 25rpx;
  color: var(--primary);
}

.container {
  padding-bottom: 40rpx;
}

/* 公告栏(我的页常驻; 展开即视为已读) */
.announce-card {
  font-family: var(--font-ann);
  margin: 12rpx 20rpx 0;
  padding: 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  border: var(--bw-card) solid var(--line);
  box-shadow: var(--shadow-card);
}

.announce-head {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.announce-icon {
  margin-right: 10rpx;
  font-size: 30rpx;
}

.announce-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: bold;
}

/* 未读新公告标记(展开查看后消失) */
.announce-new {
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 1rpx 12rpx;
  border-radius: var(--radius-card);
  background: var(--danger);
  color: var(--bg-card);
  font-size: 20rpx;
  line-height: 1.7;
  font-weight: normal;
}

.announce-state {
  font-size: 22rpx;
  color: var(--text-hint);
}

.announce-body {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-line;
}

/* 折叠: 最多显示 2 行, 点击展开 */
.announce-body.clamped {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 20rpx 24rpx 0;
}

.avatar {
  font-size: 80rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: bold;
}

.user-id {
  font-size: 24rpx;
  color: var(--text-hint);
}

.user-semester {
  font-size: 22rpx;
  color: var(--primary);
  margin-top: 4rpx;
}

/* 操作列表 */
.action-list {
  margin: 20rpx 24rpx 0;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  border: var(--bw-card) solid var(--line);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.action-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.action-item:last-child {
  border-bottom: none;
}

.action-item .arrow {
  color: var(--text-hint);
  font-size: 32rpx;
}

/* 校历设置卡片 */
.setting-card {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
}

.setting-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.setting-value {
  font-size: 26rpx;
  color: var(--primary);
  padding: 16rpx 0;
}

.setting-hint {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

/* 退出登录 */
.logout-area {
  padding: 32rpx 24rpx 48rpx;
}

.logout-area .btn-danger-plain {
  font-size: 28rpx;
}

/* 登录表单 */
.login-card {
  margin: 40rpx 24rpx 20rpx;
  padding: 40rpx 32rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 24rpx;
  color: var(--primary);
}

/* 登录模式切换 */
.mode-tabs {
  display: flex;
  background: var(--line-soft);
  border-radius: var(--radius-ctrl);
  overflow: hidden;
  margin-bottom: 12rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.mode-tab.active {
  background: var(--primary);
  color: var(--bg-card);
  font-weight: bold;
}

.mode-desc {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-ctrl);
  font-size: 28rpx;
  box-sizing: border-box;
  background: var(--bg-sunken);
}

.login-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 104rpx;          /* 加高: 长文案"登录(自动识别验证码)"显示完整 */
  font-size: 30rpx;
  line-height: 104rpx;     /* 行高与高度一致, 文字垂直居中不裁切 */
  border-radius: var(--radius-ctrl);
  padding: 0;
}

/* 密码输入行: 输入框 + 明文切换按钮 */
.pwd-row {
  position: relative;
  display: block;
}

.pwd-input {
  padding-right: 112rpx;   /* 给右侧的眼睛图标留位, 避免文字重叠 */
}

.pwd-toggle {
  position: absolute;
  right: 4rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 88rpx;    /* 44px 热区: 移动端推荐的最小点击区域 */
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 眼睛图标: 内联 SVG(矢量, 透明底) — 默认"睁眼"(点开查看), 显示中为"闭眼"(点击隐藏) */
.pwd-eye {
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 40rpx 40rpx;
  background-image: url("data:image/svg+xml;base64,");
}

.pwd-eye-on {
  background-image: url("data:image/svg+xml;base64,");
}

.pwd-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1.5;
}

.login-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 24rpx;
}

/* ============================================================
   V2 视觉升级 — 设置页
   ============================================================ */
/* 用户卡渐变头部 */
.user-card {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary) 100%);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}
.user-card .user-name { color: var(--bg-card); }
.user-card .user-id { color: rgba(255, 255, 255, 0.85); }
.user-card .user-semester { color: rgba(255, 255, 255, 0.95); }

/* 操作项按压反馈 */
.action-item {
  border-radius: var(--radius-ctrl);
  margin: 0 12rpx;
}
.action-item:active { background: var(--primary-soft); }

/* 登录模式胶囊 */
.mode-tabs { border-radius: var(--radius-card); }
.mode-tab { border-radius: var(--radius-card); }
.mode-tab.active {
  font-weight: 700;
  box-shadow: var(--shadow-card);
}

/* 校历设置卡装饰 */
.setting-card { border-left: 8rpx solid var(--primary); }


/* ============================================================
   V3 视觉升级 — 设置页头像与细节
   ============================================================ */
.user-card .avatar {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.20);
  border-radius: 50%;
  font-size: 60rpx;
}
.setting-card .setting-value {
  background: var(--primary-soft);
  border-radius: var(--radius-ctrl);
  padding: 18rpx 20rpx;
}
.login-card {
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* ============================================================
   V4 简约风格 — 设置页
   ============================================================ */
.user-card {
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}
.user-card .user-name { color: var(--primary-dark); }
.user-card .user-id { color: var(--text-secondary); }
.user-card .user-semester { color: var(--primary); }
.user-card .avatar {
  background: var(--primary-soft);
  color: var(--primary);
}
.mode-tabs { background: var(--primary-soft); }
.mode-tab.active { box-shadow: var(--shadow-card); }
.setting-card { border-left: 6rpx solid var(--primary); }


/* ============================================================
   V6 桌面端同款 — 设置页
   ============================================================ */
/* 用户卡 → 桌面信息卡: 白底 + 主色头像 */
.user-card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}
.user-card .user-name { color: var(--text-primary); }
.user-card .user-id { color: var(--text-hint); }
.user-card .user-semester { color: var(--primary); }
.user-card .avatar {
  background: var(--primary-soft);
  color: var(--primary);
}
/* 操作项 → 桌面卡片行 */
.action-item { border-radius: var(--radius-ctrl); }
/* 登录模式 → 桌面 .gpa-mode-bar 同款 */
.mode-tabs {
  display: flex;
  background: none;
  padding: 0;
  gap: 12rpx;
}
.mode-tab {
  background: var(--bg-card);
  border: var(--bw-ctrl) solid var(--line-strong);
  color: var(--text-primary);
  border-radius: var(--radius-ctrl);
}
.mode-tab.active {
  background: var(--primary);
  border-color: var(--primary);
  color: var(--bg-card);
  box-shadow: var(--shadow-card);
}


/* ============================================================
   风格统一 — 对齐课表(白底圆角小方框 + 细边框)
   ============================================================ */
.user-card, .login-card, .setting-card {
  border-radius: var(--radius-card);
  border: var(--bw-card) solid var(--line);
  box-shadow: var(--shadow-card);
}
.login-card { box-shadow: var(--shadow-card); }

/* ============================================================
   已登录用户卡: 浅蓝软底 + 细描边
   ============================================================ */
.user-card {
  background: var(--primary-soft);
  border: 1rpx solid var(--primary-line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}
.user-card .user-name { color: var(--text-primary); }
.user-card .user-id { color: var(--text-muted); }
.user-card .user-semester { color: var(--primary-dark); }
.user-card .avatar {
  background: var(--bg-card) !important;
  color: var(--primary) !important;
}

/* ============================================================
   信息行(设计规范 §3.6): 灰底 var(--primary-soft) 圆角 16rpx 行
   标签左灰字 / 值右深色字
   ============================================================ */
.info-card {
  margin: 16rpx 24rpx 0;
  background: var(--bg-card);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--primary-soft);
  border-radius: var(--radius-ctrl);
  padding: 18rpx 24rpx;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-hint);
}

.info-value {
  font-size: 26rpx;
  color: var(--text-strong);
  font-weight: 500;
}

/* ============================================================
   按钮组(设计规范 §3.7): 主按钮 / 描边按钮 / 危险按钮
   ============================================================ */
.btn-group {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 24rpx 0;
}

/* 底部两个按钮: 等宽并排, 圆角矩形 */
.btn-group .main-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  margin: 0;
  font-size: 27rpx;
  border-radius: var(--radius-ctrl) !important;
  box-sizing: border-box;
}

.btn-group .main-btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  margin: 0;
  font-size: 27rpx;
  border-radius: var(--radius-pill) !important;
  box-sizing: border-box;
}

/* 危险按钮: 白底红描边红字 */
.btn-danger-plain {
  display: block;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  margin: 0;
  background: var(--bg-card) !important;
  color: var(--danger) !important;
  border: 2rpx solid var(--danger) !important;
  border-radius: var(--radius-pill) !important;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.btn-danger-plain::after { border: none; }

/* 版本标识 */
.version-tip {
  text-align: center;
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

/* 组件根/滚动区 */
.view-root { height: 100%; box-sizing: border-box; }
.view-scroll { height: 100%; }

/* 宿主节点高度(swiper-item 内撑满, 保证内部 100% 高度链有效) */
:host {
  display: block;
  height: 100%;
}

/* 系统公告横幅("我的"页面下方) */
.announce-bar {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 8rpx 24rpx 0;
  padding: 16rpx 20rpx;
  background: var(--signal-soft);
  border: 1rpx solid var(--signal-line);
  border-radius: var(--radius-card);
}
.ann-ico { font-size: 30rpx; flex-shrink: 0; line-height: 1.5; }
.ann-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--signal-deep);
  line-height: 1.6;
  word-break: break-all;
}

/* ============================================================
   问题反馈弹窗(不另开页面) — 白卡圆角 + 胶囊类型选择 + 主按钮
   ============================================================ */
.fb-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1300;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fb-card {
  width: 86vw;
  max-width: 640rpx;
  max-height: 82vh;
  overflow-y: auto;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 32rpx 28rpx 28rpx;
  box-sizing: border-box;
}

/* 赞赏支持弹窗: 图片自适应宽度, 提示文案弱化展示 */
.appreciate-card { text-align: center; }

.appreciate-img {
  width: 100%;
  margin: 12rpx 0 8rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
}

.appreciate-tip {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.appreciate-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

.fb-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.fb-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-strong);
}

.fb-close {
  font-size: 32rpx;
  color: var(--text-hint);
  padding: 8rpx;
}

.fb-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 14rpx;
}

/* 类型选择: 胶囊分段 */
.type-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 25rpx;
  color: var(--text-hint);
  background: var(--primary-soft);
  border-radius: var(--radius-pill);
}

.type-tab.on {
  background: var(--primary);
  color: var(--bg-card);
  font-weight: 600;
}

/* 反馈内容 */
.fb-textarea {
  width: 100%;
  height: 240rpx;
  background: var(--bg-page);
  border: var(--bw-card) solid var(--line);
  border-radius: var(--radius-card);
  padding: 20rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--text-strong);
  box-sizing: border-box;
}

.fb-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

/* 提交按钮: 纯色主色 + 小圆角 */
.fb-submit {
  margin-top: 32rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: 29rpx;
  border-radius: var(--radius-ctrl) !important;
  background: var(--primary) !important;
  color: var(--bg-card) !important;
  box-shadow: var(--shadow-card) !important;
}

/* ============================================================ */
/* 我的反馈(查看官方回复) */
/* ============================================================ */
.action-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 未读回复小红点 */
.fb-dot {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: var(--radius-ctrl);
  background: var(--danger);
  color: var(--bg-card);
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
}

/* 列表由弹窗卡片自身滚动(.fb-card 已有 max-height + overflow-y), 避免嵌套滚动 */
.myfb-list {
  padding-right: 4rpx;
}

.myfb-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--primary-soft);
}

.myfb-item:last-child {
  border-bottom: none;
}

.myfb-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.myfb-type {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--line-soft);
  border-radius: var(--radius-chip);
  padding: 2rpx 12rpx;
}

.myfb-time {
  flex: 1;
  font-size: 22rpx;
  color: var(--text-hint);
}

.myfb-status {
  font-size: 22rpx;
  border-radius: var(--radius-card);
  padding: 2rpx 14rpx;
}

.myfb-status.replied {
  background: var(--success-soft);
  color: var(--success);
}

.myfb-status.pending {
  background: var(--line-soft);
  color: var(--text-hint);
}

.myfb-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  word-break: break-all;
}

.myfb-reply {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  background: var(--primary-soft);
  border-left: 6rpx solid var(--primary);
  border-radius: var(--radius-chip);
}

.myfb-reply-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.myfb-reply-tag {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 600;
}

.myfb-reply-time {
  font-size: 20rpx;
  color: var(--text-hint);
}

.myfb-reply-text {
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.65;
  word-break: break-all;
}

.myfb-noreply {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--icon-faint);
}

.myfb-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-hint);
}

/* ============================================================
   常用链接弹窗
   ============================================================ */
.sub-tip {
  margin-bottom: 14rpx;
  color: var(--text-hint);
  font-size: 21rpx;
  line-height: 1.6;
}

.sub-card .notice-card,
.sub-list {
  margin: 0 !important;
}

.link-tip {
  font-size: 21rpx;
  color: var(--text-hint);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

/* 链接列表不用 scroll-view: 竖向滚动必须给固定高度, 未设时内容可能不渲染;
   列表整体交给 .fb-card 统一滚动(卡片已设 max-height + overflow-y) */

.link-group-title {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin: 14rpx 0 8rpx;
}

.link-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  background: var(--bg-page);
  border-radius: var(--radius-ctrl);
  margin-bottom: 12rpx;
}

.link-row:active {
  background: var(--line-soft);
}

.link-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.link-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.35;
}

.link-url {
  font-size: 21rpx;
  color: var(--text-hint);
  word-break: break-all;
  line-height: 1.4;
}

.link-act {
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--primary);
}

.link-empty {
  text-align: center;
  font-size: 25rpx;
  color: var(--text-hint);
  padding: 60rpx 0;
}

.link-foot {
  text-align: center;
  font-size: 21rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
}

/* ============================================================
   账户页最终视觉: 深蓝身份面板 + 白色设置面
   ============================================================ */
.user-card {
  margin: 12rpx 20rpx 0 !important;
  padding: 26rpx 22rpx !important;
  background: rgba(38, 73, 94, .82) !important;
  border: 1rpx solid rgba(255, 255, 255, .25) !important;
  border-radius: 24rpx !important;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .12),
              0 16rpx 38rpx rgba(30, 64, 124, .14) !important;
  -webkit-backdrop-filter: blur(24rpx) saturate(165%);
  backdrop-filter: blur(24rpx) saturate(165%);
  animation: profileRise var(--motion-slow) var(--ease-spring);
}

.user-card .avatar {
  width: 88rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  border-radius: 22rpx !important;
  background: rgba(255, 255, 255, .95) !important;
  color: var(--primary) !important;
}

.user-card .user-name {
  color: #FFFFFF !important;
  font-size: 34rpx;
  font-weight: 750;
}

.user-card .user-id {
  color: rgba(255, 255, 255, .68) !important;
  font-family: var(--font-display);
  font-size: 22rpx;
}

.user-card .user-semester {
  flex-shrink: 0;
  margin-top: 0 !important;
  padding: 7rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, .18);
  border-radius: 10rpx;
  background: rgba(255, 255, 255, .10);
  color: rgba(255, 255, 255, .92) !important;
  font-size: 20rpx;
}

.setting-card {
  margin: 16rpx 20rpx 0 !important;
  border: 1rpx solid var(--line) !important;
  border-radius: 20rpx !important;
  background: var(--bg-card) !important;
  box-shadow: var(--shadow-card) !important;
}

.setting-card .group-title {
  margin-bottom: 10rpx !important;
  color: var(--text-muted);
  font-size: 22rpx;
  letter-spacing: .04em;
}

/* 身份面板: 顶部身份 + 底部关键数据 */
.user-card {
  display: block !important;
  padding: 24rpx 22rpx 18rpx !important;
}

.user-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.user-top .user-info {
  flex: 1;
  min-width: 0;
}

.user-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .16);
}

.user-stat {
  min-width: 0;
}

.user-stat-value {
  display: block;
  overflow: hidden;
  color: #FFFFFF;
  font-family: var(--font-display);
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-stat-label {
  display: block;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, .62);
  font-size: 20rpx;
}

/* 深度整合的账户概览 */
.user-overview {
  display: grid;
  grid-template-columns: minmax(0, .8fr) 1rpx minmax(0, .8fr) 1rpx minmax(0, 1.25fr);
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .15);
}

.user-overview-item {
  min-width: 0;
}

.user-overview-value {
  display: block;
  overflow: hidden;
  color: #FFFFFF;
  font-family: var(--font-display);
  font-size: 27rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-overview-value.credit-value {
  font-size: 22rpx;
}

.user-overview-label {
  display: block;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, .60);
  font-size: 19rpx;
}

.user-overview-divider {
  width: 1rpx;
  height: 42rpx;
  background: rgba(255, 255, 255, .15);
}

.user-calibration {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, .20);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .10);
  -webkit-backdrop-filter: blur(18rpx) saturate(160%);
  backdrop-filter: blur(18rpx) saturate(160%);
}

.calibration-picker {
  display: block;
}

.calibration-inline,
.sync-inline {
  display: flex;
  align-items: center;
  min-height: 70rpx;
  padding: 10rpx 14rpx;
  box-sizing: border-box;
}

.calibration-inline {
  border-bottom: 1rpx solid rgba(255, 255, 255, .13);
}

.calibration-inline:active,
.sync-inline:active {
  background: rgba(255, 255, 255, .08);
}

.calibration-icon,
.sync-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, .94);
}

.calibration-copy {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

.user-calibration .calibration-title {
  display: block;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 650;
}

.user-calibration .calibration-value {
  max-width: 210rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, .90);
  font-family: var(--font-display);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calibration-arrow {
  width: 28rpx;
  height: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 4rpx;
}

.sync-inline {
  color: #FFFFFF;
  font-size: 23rpx;
  font-weight: 650;
}

.sync-inline .sync-icon {
  margin-right: 12rpx;
}

/* 周次校准 */
.calibration-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 88rpx;
  padding: 12rpx 2rpx;
  border-bottom: 1rpx solid var(--line-soft);
  box-sizing: border-box;
  transition: transform var(--motion-base) var(--ease-spring),
              opacity var(--motion-fast) var(--ease-standard);
}

.calibration-row:last-child { border-bottom: 0; }
.calibration-row.action:active { opacity: .78; }
.calibration-row.action:active { transform: scale(.985); }

.calibration-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.calibration-title {
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 650;
}

.calibration-value {
  max-width: 240rpx;
  overflow: hidden;
  color: var(--text-strong);
  font-family: var(--font-display);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-chip {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 700;
}

/* 字体分段选择 */
.font-seg {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: var(--bg-page);
}

.font-choice {
  min-height: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 4rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid transparent;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.font-choice.on {
  background: var(--bg-card);
  border-color: var(--primary-line);
}

.font-choice.f-pixel { font-family: "ZpixPixel", "PingFang SC", monospace; }
.font-choice.f-system { font-family: var(--font-plain); }
.font-choice .font-name { font-size: 27rpx; font-weight: 650; color: var(--text-primary); }

/* 提醒与帮助: 统一的行式信息面 */
.notice-card,
.menu-card {
  margin: 16rpx 20rpx 0;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .84);
  -webkit-backdrop-filter: blur(22rpx) saturate(165%);
  backdrop-filter: blur(22rpx) saturate(165%);
  box-shadow: var(--shadow-card);
}

.notice-card .act-row,
.menu-card .act-row {
  display: flex;
  align-items: center;
  min-height: 74rpx;
  padding: 14rpx 18rpx;
  border-bottom: 1rpx solid var(--line-soft);
  box-sizing: border-box;
  transition: background-color var(--motion-fast) var(--ease-standard),
              transform var(--motion-base) var(--ease-spring);
}

.notice-card .act-row:last-child,
.menu-card .act-row:last-child { border-bottom: 0; }
.notice-card .act-row:active,
.menu-card .act-row:active {
  background: var(--bg-hover);
  transform: scale(.985);
}

.notice-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: var(--line-strong);
}

.notice-dot.on {
  background: var(--success);
  box-shadow: 0 0 0 8rpx var(--success-soft);
}

.act-main {
  flex: 1;
  min-width: 0;
}

.act-title {
  display: block;
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 650;
}

.act-sub {
  display: block;
  margin-top: 3rpx;
  color: var(--text-hint);
  font-size: 21rpx;
}
.act-sub.is-ok { color: var(--success); }
.act-sub.is-fail { color: var(--danger); }
.act-row.is-disabled { opacity: .72; }

.act-plus {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 700;
}

.act-note {
  padding: 12rpx 18rpx 16rpx;
  color: var(--text-hint);
  font-size: 20rpx;
  line-height: 1.55;
}

.menu-ico {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

/* 底部操作: 纵向排列, 降低误触 */
.btn-group {
  flex-direction: column;
  gap: 12rpx !important;
  margin: 20rpx 20rpx 0 !important;
}

.btn-group .main-btn {
  width: 100%;
  flex: none;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 16rpx !important;
}

.logout-btn {
  border: 0 !important;
  background: var(--danger-soft) !important;
}

.version-tip {
  padding: 28rpx 0 calc(72rpx + env(safe-area-inset-bottom)) !important;
}

@keyframes profileRise {
  from { opacity: 0; transform: translateY(18rpx) scale(.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* 我的页所有内容卡统一错峰入场 */
.announce-card,
.login-card,
.setting-card,
.notice-card,
.menu-card {
  animation: settingsCardIn 420ms var(--ease-spring) backwards;
}

.announce-card { animation-delay: 0ms; }
.user-card + .setting-card { animation-delay: 35ms; }
.setting-card + .setting-card { animation-delay: 70ms; }
.setting-card + .notice-card { animation-delay: 105ms; }
.notice-card + .menu-card { animation-delay: 140ms; }
.setting-card + .menu-card { animation-delay: 105ms; }

@keyframes settingsCardIn {
  from { opacity: 0; transform: translateY(20rpx) scale(.982); }
  68% { opacity: 1; transform: translateY(-2rpx) scale(1.004); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* 字体切换: 用短时透明度过渡掩盖字体替换瞬间的重排 */
.view-root.font-switching .view-scroll {
  animation: fontSwap 310ms var(--ease-standard) both;
}

.font-choice.on {
  animation: choicePop 360ms var(--ease-spring);
}

@keyframes fontSwap {
  0% { opacity: 1; }
  32% { opacity: .72; transform: translateY(3rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes choicePop {
  0% { transform: scale(.96); }
  62% { transform: scale(1.025); }
  100% { transform: scale(1); }
}

/* 弹窗: 遮罩渐入 + 卡片上浮回弹 */
.fb-mask {
  animation: modalMaskIn 180ms ease-out both;
}

.fb-card {
  animation: modalPanelIn 380ms var(--ease-spring) both;
  transform-origin: 50% 85%;
}

@keyframes modalMaskIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes modalPanelIn {
  from { opacity: 0; transform: translateY(36rpx) scale(.965); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
