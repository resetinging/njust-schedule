:host {
  display: block;
  height: 100%;
  min-height: 0;
}

.container,
.view-root {
  display: flex;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  color: var(--text-primary);
  background: var(--bg-page);
}

.view-scroll {
  height: 100%;
  min-height: 0;
  -webkit-overflow-scrolling: touch;
}

.announce-card,
.user-card,
.profile-metrics,
.profile-calibration,
.setting-card,
.notice-card,
.menu-card,
.login-card {
  margin: 12rpx 20rpx 0;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
  background: var(--glass-bg-strong);
  box-shadow: var(--shadow-card);
}

.announce-card {
  padding: 16rpx 18rpx;
}

.announce-head,
.user-top,
.calibration-inline,
.sync-inline,
.act-row,
.font-choice,
.fb-head,
.myfb-top {
  display: flex;
  align-items: center;
}

.announce-head { min-height: 42rpx; gap: 10rpx; }
.announce-icon,
.menu-ico,
.calibration-icon,
.sync-icon,
.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.announce-icon,
.menu-ico,
.calibration-icon,
.sync-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-control);
  background: var(--primary-soft);
}

.announce-title { color: var(--text-primary); font-size: 25rpx; font-weight: 700; }
.announce-new { padding: 2rpx 8rpx; border-radius: var(--radius-pill); color: #FFFFFF; background: var(--danger); font-size: 18rpx; }
.announce-state { margin-left: auto; color: var(--primary); font-size: 21rpx; }
.announce-body { margin-top: 10rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.55; }
.announce-body.clamped { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

.user-card { padding: 20rpx; }
.user-top { gap: 14rpx; }
.avatar { width: 78rpx; height: 78rpx; border-radius: 24rpx; background: var(--primary-soft); }
.user-info { min-width: 0; flex: 1; }
.user-name { display: block; overflow: hidden; color: var(--text-primary); font-size: 31rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.user-id { display: block; margin-top: 4rpx; color: var(--text-muted); font-family: var(--font-num); font-size: 22rpx; }
.user-semester { max-width: 190rpx; padding: 7rpx 12rpx; overflow: hidden; border-radius: var(--radius-pill); color: var(--primary); background: var(--primary-soft); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }

.profile-metrics { padding: 18rpx 16rpx; }
.user-overview { display: flex; align-items: stretch; }
.user-overview-item { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; }
.user-overview-value { color: var(--text-primary); font-family: var(--font-num); font-size: 34rpx; font-weight: 700; line-height: 1.2; }
.user-overview-value.credit-value { color: var(--success); }
.user-overview-label { color: var(--text-muted); font-size: 20rpx; }
.user-overview-divider { width: 1rpx; background: var(--line); }

.profile-calibration { padding: 4rpx 16rpx; }
.user-calibration { display: flex; align-items: center; }
.calibration-picker { min-width: 0; flex: 1; }
.calibration-inline { min-height: 76rpx; gap: 10rpx; }
.calibration-copy { min-width: 0; flex: 1; }
.calibration-title { color: var(--text-secondary); font-size: 24rpx; }
.calibration-value { color: var(--text-primary); font-family: var(--font-num); font-size: 22rpx; }
.calibration-arrow { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; }
.sync-inline { gap: 6rpx; padding: 0 6rpx; color: var(--primary); font-size: 21rpx; }

.profile-section-label {
  margin: 26rpx 22rpx 8rpx;
  color: var(--text-muted);
  font-size: 21rpx;
  font-weight: 650;
}

.setting-card { padding: 16rpx; }
.group-title { margin: 0 4rpx 10rpx; color: var(--text-secondary); font-size: 22rpx; font-weight: 650; }
.font-seg { display: flex; gap: 8rpx; padding: 4rpx; border-radius: var(--radius-control); background: var(--bg-sunken); }
.font-choice { min-height: 62rpx; flex: 1; justify-content: center; border-radius: var(--radius-control); color: var(--text-muted); font-size: 23rpx; }
.font-choice.on { color: var(--primary); background: var(--bg-card); box-shadow: var(--shadow-card); font-weight: 700; }
.font-choice.f-pixel { font-family: "ZpixPixel", "PingFang SC", monospace; }
.font-choice.f-system { font-family: var(--font-body); }

.notice-card,
.menu-card { overflow: hidden; }
.act-row { min-height: 76rpx; gap: 12rpx; padding: 12rpx 16rpx; border-bottom: 1rpx solid var(--line-soft); }
.act-row:last-child { border-bottom: 0; }
.act-row:active { background: var(--bg-hover); }

.view-root.is-entering .announce-card,
.view-root.is-entering .user-card,
.view-root.is-entering .profile-metrics,
.view-root.is-entering .profile-calibration,
.view-root.is-entering .profile-section-label,
.view-root.is-entering .setting-card,
.view-root.is-entering .notice-card,
.view-root.is-entering .menu-card,
.view-root.is-entering .btn-group,
.view-root.is-entering .login-card {
  animation: profileItemIn 420ms var(--ease-spring) backwards;
}

.view-root.is-entering .user-card { animation-delay: 35ms; }
.view-root.is-entering .profile-metrics { animation-delay: 60ms; }
.view-root.is-entering .profile-calibration { animation-delay: 85ms; }
.view-root.is-entering .profile-section-label { animation-delay: 105ms; }
.view-root.is-entering .setting-card { animation-delay: 120ms; }
.view-root.is-entering .service-label { animation-delay: 145ms; }
.view-root.is-entering .notice-card { animation-delay: 160ms; }
.view-root.is-entering .menu-card { animation-delay: 185ms; }
.view-root.is-entering .btn-group { animation-delay: 215ms; }

.act-row .menu-ico,
.act-row .act-arrow {
  transition: transform var(--motion-base) var(--ease-spring);
}

.act-row:active .menu-ico {
  transform: scale(.90) rotate(-4deg);
}

.act-row:active .act-arrow {
  transform: translateX(6rpx);
}

@keyframes profileItemIn {
  0%   { opacity: 0; transform: translateY(18rpx) scale(.985); }
  70%  { opacity: 1; transform: translateY(-2rpx) scale(1.002); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .view-root.is-entering .announce-card,
  .view-root.is-entering .user-card,
  .view-root.is-entering .profile-metrics,
  .view-root.is-entering .profile-calibration,
  .view-root.is-entering .profile-section-label,
  .view-root.is-entering .setting-card,
  .view-root.is-entering .notice-card,
  .view-root.is-entering .menu-card,
  .view-root.is-entering .btn-group,
  .view-root.is-entering .login-card {
    animation: none;
  }
}
.act-main,
.menu-copy { min-width: 0; flex: 1; }
.act-title { display: block; color: var(--text-primary); font-size: 25rpx; line-height: 1.3; }
.act-sub { display: block; margin-top: 3rpx; overflow: hidden; color: var(--text-muted); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.act-sub.is-ok { color: var(--success); }
.act-sub.is-fail { color: var(--danger); }
.act-arrow { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; flex: none; }
.menu-ico { width: 50rpx; height: 50rpx; }
.notice-dot { width: 14rpx; height: 14rpx; flex: none; border: 3rpx solid var(--line-strong); border-radius: 50%; }
.notice-dot.on { border-color: var(--success); background: var(--success); }
.act-badge { margin-right: 6rpx; padding: 3rpx 8rpx; border-radius: var(--radius-pill); color: #FFFFFF; background: var(--danger); font-size: 18rpx; }
.act-plus { flex: none; padding: 6rpx 12rpx; border-radius: var(--radius-pill); color: var(--primary); background: var(--primary-soft); font-size: 21rpx; font-weight: 650; }

.btn-group { display: flex; flex-direction: column; gap: 10rpx; margin: 24rpx 20rpx 0; }
.main-btn {
  display: flex;
  width: 100%;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-sizing: border-box;
  border-radius: var(--radius-control);
  font-size: 25rpx;
  line-height: 1;
}
.btn-primary { color: #FFFFFF; background: var(--primary); }
.btn-outline { border: 1rpx solid var(--line-strong); color: var(--text-secondary); background: var(--bg-card); }
.btn-danger-plain { border: 1rpx solid #F2D2D5; color: var(--danger); background: var(--danger-soft); }
.version-tip { padding: 24rpx 0 32rpx; color: var(--text-hint); font-family: var(--font-num); font-size: 19rpx; text-align: center; }

.login-card { margin-top: 28rpx; padding: 24rpx 20rpx; }
.login-title { color: var(--text-primary); font-size: 32rpx; font-weight: 750; text-align: center; }
.mode-desc,
.login-tip { margin-top: 8rpx; color: var(--text-muted); font-size: 22rpx; text-align: center; }
.form-group { margin-top: 20rpx; }
.form-label { display: block; margin-bottom: 7rpx; color: var(--text-secondary); font-size: 22rpx; }
.form-input { width: 100%; height: 72rpx; padding: 0 16rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: var(--radius-control); color: var(--text-primary); background: var(--bg-sunken); font-size: 26rpx; }
.pwd-row { position: relative; }
.pwd-input { padding-right: 86rpx; }
.pwd-toggle { position: absolute; top: 0; right: 0; display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; }
.pwd-eye { width: 30rpx; height: 20rpx; border: 2rpx solid var(--text-muted); border-radius: 60% 20%; transform: rotate(45deg); }
.pwd-eye-on { border-color: var(--primary); }
.login-btn { margin-top: 24rpx; width: 100%; height: 78rpx; border-radius: var(--radius-control); font-size: 27rpx; line-height: 78rpx; }
.qr-entry { margin-top: 22rpx; text-align: center; }
.qr-entry-link,
.qr-link { color: var(--primary); font-size: 23rpx; }
.qr-panel { margin-top: 20rpx; text-align: center; }
.qr-img { width: 520rpx; max-width: 100%; padding: 12rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: var(--radius-control); background: #FFFFFF; }
.qr-panel-hint,
.qr-save-tip { min-height: 32rpx; margin-top: 12rpx; color: var(--text-muted); font-size: 20rpx; }
.qr-save-btn { width: 100%; height: 72rpx; margin-top: 18rpx; border-radius: var(--radius-control); color: #FFFFFF; background: var(--primary); font-size: 25rpx; line-height: 72rpx; }
.qr-panel-actions { display: flex; justify-content: space-around; margin-top: 18rpx; }

.settings-popup {
  --td-popup-bg-color: var(--glass-bg-strong);
  --td-popup-border-radius: var(--radius-panel);
  --td-popup-transition: all var(--motion-slow) var(--ease-standard);
}

.fb-card {
  width: 100%;
  max-height: 84vh;
  overflow-y: auto;
  padding: 24rpx 22rpx;
  box-sizing: border-box;
  border-radius: var(--radius-panel) var(--radius-panel) 0 0;
  background: var(--glass-bg-strong);
  box-shadow: var(--shadow-sheet);
}

.fb-head { justify-content: space-between; min-height: 52rpx; padding-bottom: 14rpx; border-bottom: 1rpx solid var(--line-soft); }
.fb-title { color: var(--text-primary); font-size: 30rpx; font-weight: 750; }
.fb-close { display: flex; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; border-radius: 50%; color: var(--text-muted); font-size: 32rpx; }
.fb-label { margin-top: 18rpx; margin-bottom: 8rpx; color: var(--text-secondary); font-size: 22rpx; font-weight: 650; }
.type-tabs { display: flex; gap: 8rpx; }
.type-tab { flex: 1; padding: 12rpx 8rpx; border: 1rpx solid var(--line); border-radius: var(--radius-control); color: var(--text-muted); font-size: 22rpx; text-align: center; }
.type-tab.on { border-color: var(--primary-line); color: var(--primary); background: var(--primary-soft); font-weight: 650; }
.fb-textarea { width: 100%; min-height: 210rpx; padding: 14rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: var(--radius-control); background: var(--bg-sunken); color: var(--text-primary); font-size: 24rpx; line-height: 1.55; }
.fb-count { margin-top: 6rpx; color: var(--text-hint); font-family: var(--font-num); font-size: 19rpx; text-align: right; }
.fb-submit { width: 100%; height: 74rpx; margin-top: 18rpx; border-radius: var(--radius-control); line-height: 74rpx; }

.myfb-list,
.link-list,
.sub-list { margin-top: 14rpx; }
.myfb-item { padding: 14rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.myfb-item:last-child { border-bottom: 0; }
.myfb-top { gap: 8rpx; }
.myfb-type { color: var(--text-secondary); font-size: 22rpx; font-weight: 650; }
.myfb-time { margin-left: auto; color: var(--text-hint); font-family: var(--font-num); font-size: 18rpx; }
.myfb-status { margin-left: 6rpx; padding: 3rpx 8rpx; border-radius: var(--radius-pill); color: var(--signal); background: var(--signal-soft); font-size: 18rpx; }
.myfb-status.replied { color: var(--success); background: var(--success-soft); }
.myfb-content,
.myfb-reply-text { margin-top: 8rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.55; word-break: break-all; }
.myfb-reply { margin-top: 10rpx; padding: 10rpx 12rpx; border-radius: var(--radius-control); background: var(--success-soft); }
.myfb-reply-head { display: flex; justify-content: space-between; }
.myfb-reply-tag { color: var(--success); font-size: 20rpx; font-weight: 650; }
.myfb-reply-time { color: var(--text-muted); font-size: 18rpx; }
.myfb-noreply,
.myfb-empty { padding: 24rpx 0; color: var(--text-muted); font-size: 21rpx; text-align: center; }

.link-tip,
.sub-tip { margin-top: 12rpx; color: var(--text-muted); font-size: 21rpx; line-height: 1.5; }
.link-group-title { margin: 18rpx 0 6rpx; color: var(--text-secondary); font-size: 22rpx; font-weight: 700; }
.link-row { display: flex; align-items: center; gap: 10rpx; padding: 13rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.link-main { min-width: 0; flex: 1; }
.link-name,
.link-url { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.link-name { color: var(--text-primary); font-size: 23rpx; }
.link-url { margin-top: 3rpx; color: var(--text-muted); font-family: var(--font-num); font-size: 18rpx; }
.link-act { flex: none; color: var(--primary); font-size: 21rpx; }
.link-empty,
.link-foot { padding: 22rpx 0; color: var(--text-muted); font-size: 21rpx; text-align: center; }
.link-foot { border-top: 1rpx solid var(--line-soft); }

.sub-card .notice-card { margin: 16rpx 0 0; box-shadow: none; }
.appreciate-img { display: block; width: 100%; margin-top: 18rpx; border-radius: var(--radius-card); }
.appreciate-tip { margin-top: 14rpx; color: var(--text-secondary); font-size: 23rpx; text-align: center; }
.appreciate-sub { margin-top: 6rpx; color: var(--text-muted); font-size: 20rpx; text-align: center; }

.analytics-slot-marker { width: 100%; height: 1px; opacity: 0; pointer-events: none; }

@media (max-width: 360px) {
  .announce-card,
  .user-card,
  .profile-metrics,
  .profile-calibration,
  .setting-card,
  .notice-card,
  .menu-card,
  .login-card { margin-right: 14rpx; margin-left: 14rpx; }
}
