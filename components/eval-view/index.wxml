<!-- 教学评价视图组件 — 原 pages/eval 页面改造（方案A 合页 swiper） -->
<view class="container view-root">

  <!-- 滚动内容区(scroll-view 内滚; 刷新走顶部按钮) -->
  <view class="view-scroll">

  <!-- 加载中 -->
  <empty-state wx:if="{{loading && batches.length === 0}}"
               icon="hourglass" title="加载中…" />

  <!-- 空状态 -->
  <empty-state wx:if="{{!loading && batches.length === 0 && !batchCourses.length}}"
               icon="clipboard"
               title="{{errorMsg || '暂无待评价课程'}}"
               desc="{{semester || '当前学期'}} 没有需要评价的课程"
               action-text="获取评教数据"
               bind:action="onRefresh" />

  <!-- ============================================================ -->
  <!-- 评教批次列表 -->
  <!-- ============================================================ -->
  <scroll-view class="batch-scroll" scroll-y wx:if="{{!batchCourses.length && !showForm}}">
    <view class="page-hero" wx:if="{{batches.length > 0}}">
      <view class="ph-main">
        <text class="ph-title">教学评价</text>
        <text class="ph-sub">{{batches.length}} 个批次</text>
      </view>
      <view class="ph-refresh tap {{loading ? 'spin' : ''}}" bindtap="onRefresh">
        <icon name="refresh" size="32" color="#64748B" />
      </view>
    </view>

    <!-- 批次卡片列表 -->
    <block wx:for="{{batches}}" wx:key="index">
      <view class="batch-card card tap {{item.is_done ? 'batch-done' : ''}} {{!item.is_done && item._urgency === 'urgent' ? 'batch-urgent' : ''}} {{!item.is_done && item._urgency === 'warning' ? 'batch-warning' : ''}}"
            bindtap="openBatch" data-index="{{index}}">
        <view class="batch-header">
          <text class="batch-title">{{item.category || '评教批次'}}</text>
          <view class="tag {{item.is_done ? 'tag-done' : (item._urgency === 'urgent' ? 'tag-urgent' : (item._urgency === 'warning' ? 'tag-warning' : 'tag-pending'))}}">
            {{item.is_done ? '已完成' : (item._deadlineText || '待评教')}}
          </view>
        </view>
        <view class="batch-info">
          <text wx:if="{{item.semester}}" class="sem-tag">{{item.semester}}</text>
          <text wx:if="{{item.start_date}}" class="bi-dates">{{item.start_date}} ~ {{item.end_date}}</text>
        </view>
      </view>
    </block>
  </scroll-view>

  <!-- ============================================================ -->
  <!-- 批次课程列表 -->
  <!-- ============================================================ -->
  <view wx:if="{{batchCourses.length > 0 && !showForm}}">
    <view class="summary-bar">
      <view class="sub-link tap" bindtap="backToBatches"><view class="icon-back"><icon name="back" size="26" color="#64748B" /></view><text>返回</text></view>
      <text>{{batchCourses.length}} 门课程</text>
      <text class="batch-btn tap" bindtap="showBatchDialog">一键评教</text>
    </view>

    <scroll-view scroll-y class="course-scroll">
      <view class="course-card card {{item.submitted ? 'course-done' : (item.evaluated ? 'course-saved' : '')}}"
            wx:for="{{batchCourses}}" wx:key="index" wx:for-item="item">
        <view class="course-header">
          <view class="course-main">
            <text class="course-name">{{item.name}}</text>
            <view class="course-meta">
              <text wx:if="{{item.teacher}}">{{item.teacher}}</text>
              <text wx:if="{{item.score && item.score !== '0'}}">{{item.score}}分</text>
            </view>
          </view>
          <view class="course-status {{item.submitted ? 'done' : (item.evaluated ? 'saved' : 'pending')}}">
            {{item.submitted ? '已提交' : (item.evaluated ? '已保存' : '待评价')}}
          </view>
        </view>
        <view class="course-actions">
          <t-button t-class="btn-outline small-btn" theme="primary" variant="outline" size="small"
                    wx:if="{{!item.submitted}}" bind:tap="openEvalForm" data-index="{{index}}">
            {{item.evaluated ? '继续评价' : '开始评价'}}
          </t-button>
          <t-button t-class="btn-outline small-btn view-btn" theme="primary" variant="outline" size="small"
                    wx:if="{{item.submitted}}" bind:tap="viewScores" data-index="{{index}}">
            查看评分
          </t-button>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ============================================================ -->
  <!-- 评价表单 -->
  <!-- ============================================================ -->
  <view wx:if="{{showForm}}">
    <view class="summary-bar">
      <view class="sub-link tap" bindtap="backToCourses"><view class="icon-back"><icon name="back" size="26" color="#64748B" /></view><text>返回课程</text></view>
      <text class="form-course-name">{{formCourseName}}</text>
      <text></text>
    </view>

    <scroll-view scroll-y class="form-scroll">
      <!-- 只读模式提示 -->
      <view class="readonly-banner" wx:if="{{formReadonly}}">
        已提交 — 仅查看评分，总分为 {{liveTotal}} / {{maxTotal}}
      </view>

      <!-- 自动填写工具栏（非只读模式） -->
      <view class="autofill-bar" wx:if="{{!formReadonly}}">
        <text class="autofill-label">期望分数:</text>
        <t-input t-class="autofill-input" type="digit" placeholder="如 85" borderless
                 value="{{autoFillScore}}" bind:change="onAutoFillScoreInput"
                 confirm-type="done" bind:enter="onAutoFill"/>
        <text class="autofill-hint">（满分 {{maxTotal}}）</text>
        <t-button t-class="btn-primary autofill-btn" theme="primary" size="small" bind:tap="onAutoFill">自动填写</t-button>
        <text class="live-score" wx:if="{{liveTotal > 0}}"><text class="live-score-num">{{liveTotal}}</text> 分</text>
      </view>

      <!-- 评价指标 -->
      <view class="indicator-card card" wx:for="{{indicators}}" wx:key="index">
        <view class="indicator-label">{{index + 1}}. {{item.label}}</view>
        <view class="indicator-options">
          <view class="option-item tap {{opt.checked ? 'option-checked' : ''}} {{formReadonly ? 'option-readonly' : ''}}"
                wx:for="{{item.options}}" wx:for-item="opt" wx:key="value"
                bindtap="{{formReadonly ? '' : 'selectOption'}}"
                data-seq="{{item.seq}}" data-value="{{opt.value}}">
            <text>{{opt.label || opt.value}}</text>
            <text class="option-score" wx:if="{{opt.score}}">{{opt.score}}分</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 操作按钮（非只读模式） -->
    <view class="form-actions" wx:if="{{!formReadonly}}">
      <t-button t-class="btn-outline" theme="primary" variant="outline" block bind:tap="onSaveEval">保存</t-button>
      <t-button t-class="btn-primary" theme="primary" block bind:tap="onSubmitEval">提交评价</t-button>
    </view>
    <!-- 操作按钮（只读模式） -->
    <view class="form-actions" wx:else>
      <t-button t-class="btn-outline" theme="primary" variant="outline" block bind:tap="backToCourses">返回课程列表</t-button>
    </view>
  </view>

  </view>

  <!-- ============================================================ -->
  <!-- 一键评教目标分数对话框 -->
  <!-- ============================================================ -->
  <t-dialog t-class="batch-dialog" visible="{{showBatchDialog}}"
            title="一键评教 · 目标分数" close-btn close-on-overlay-click
            bind:close="closeBatchDialog">
    <view slot="content" class="batch-dialog-content">
      <view class="slider-wrapper">
        <text class="slider-value">{{targetScore}}%</text>
        <t-slider min="50" max="100" value="{{targetScore}}" label="${value}%"
                  bind:change="onScoreChange" />
        <view class="slider-labels">
          <text>50%</text>
          <text>100%</text>
        </view>
      </view>
    </view>
    <view slot="actions" class="modal-buttons">
        <t-button t-class="btn-outline" theme="primary" variant="outline" block bind:tap="closeBatchDialog">取消</t-button>
        <t-button t-class="btn-primary" theme="primary" block bind:tap="startBatchEval">开始评教</t-button>
    </view>
  </t-dialog>

  <!-- ============================================================ -->
  <!-- 批量评教进度弹窗(fixed, 放 scroll-view 外) -->
  <!-- ============================================================ -->
  <loading-modal
    visible="{{batchRunning || batchDone}}"
    title="批量评教"
    message="{{batchCurrent}}/{{batchTotal}} {{batchMessage}}"
    showProgress="{{true}}"
    percent="{{batchPercent}}"
    spinning="{{batchRunning}}"
    done="{{batchDone}}"
    doneText="完成"
    bind:close="closeBatchProgress"
  >
    <scroll-view scroll-y class="batch-results" wx:if="{{batchResults.length > 0}}">
      <view class="result-item" wx:for="{{batchResults}}" wx:key="index">
        <view class="result-icon">
          <icon name="{{item.status === 'success' ? 'check' : 'close'}}" size="24"
                color="{{item.status === 'success' ? '#1F9D82' : '#D75C62'}}" />
        </view>
        <text class="result-name">{{item.course}}</text>
        <text class="result-error" wx:if="{{item.error}}">{{item.error}}</text>
      </view>
    </scroll-view>
  </loading-modal>

</view>
