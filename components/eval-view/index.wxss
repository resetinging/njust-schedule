/* 评教页面样式 — 参考桌面端 evaluations 设计 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}

/* 顶部操作栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  background: var(--bg-card);
}

.refresh-btn {
  color: var(--primary);
  font-weight: bold;
}

.summary-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
}

.batch-btn {
  color: var(--primary);
  font-weight: bold;
}

/* ==============================
   批次卡片
   ============================== */

.batch-card {
  margin: 12rpx 24rpx;
}

.batch-card.batch-urgent {
  border-top-width: 8rpx;
  border-top-color: var(--danger);
}

.batch-card.batch-warning {
  border-top-width: 8rpx;
  border-top-color: var(--warning);
}

.batch-card.batch-done {
  opacity: 0.6;
}

.batch-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.batch-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-strong);
}

.batch-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-card);
  font-weight: bold;
}

.tag-done { background: var(--primary-soft); color: var(--text-hint); }
.tag-pending { background: var(--bg-page); color: var(--text-muted); }
.tag-urgent { background: var(--danger-soft); color: var(--danger); }
.tag-warning { background: var(--warning-soft); color: var(--signal); }

/* ==============================
   课程列表卡片
   ============================== */

.course-scroll {
  flex: 1;
  padding: 0 4rpx 24rpx;
}

.course-card {
  margin: 12rpx 24rpx;
}

.course-card.course-done {
  opacity: 0.65;
}

.course-card.course-saved {
  border-top-width: 8rpx;
  border-top-color: var(--warning);
}

.course-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.course-main {
  flex: 1;
}

.course-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-strong);
}

.course-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

.course-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-card);
  font-weight: bold;
  flex-shrink: 0;
}

.course-status.done {
  background: var(--primary-soft);
  color: var(--text-hint);
}

.course-status.saved {
  background: var(--warning-soft);
  color: var(--signal);
}

.course-status.pending {
  background: #EFE9FF;
  color: #6D28D9;
}

.course-actions {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.small-btn {
  padding: 8rpx 28rpx !important;
  font-size: 24rpx !important;
}

.view-btn {
  color: var(--primary) !important;
  border-color: var(--primary) !important;
}

/* ==============================
   评价表单
   ============================== */

.form-course-name {
  font-weight: bold;
  color: var(--primary);
  flex: 1;
  text-align: center;
}

.form-scroll {
  flex: 1;
  padding: 8rpx 0;
}

/* 只读模式提示 */
.readonly-banner {
  margin: 12rpx 24rpx;
  padding: 14rpx 20rpx;
  background: var(--primary-soft);
  border-radius: var(--radius-chip);
  font-size: 24rpx;
  color: var(--primary-dark);
  text-align: center;
}

/* 自动填写工具栏 */
.autofill-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 8rpx 24rpx 4rpx;
  padding: 14rpx 16rpx;
  background: var(--bg-page);
  border-radius: var(--radius-chip);
  flex-wrap: wrap;
}

.autofill-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

.autofill-input {
  width: 100rpx;
  height: 52rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-chip);
  padding: 0 8rpx;
  font-size: 26rpx;
  text-align: center;
  background: var(--bg-card);
}

.autofill-hint {
  font-size: 20rpx;
  color: var(--text-hint);
}

.autofill-btn {
  padding: 8rpx 20rpx !important;
  font-size: 22rpx !important;
  flex-shrink: 0;
}

.live-score {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-left: auto;
}

.live-score-num {
  font-weight: bold;
  color: var(--primary);
  font-size: 28rpx;
}

/* 评价指标 */
.indicator-card {
  margin: 12rpx 24rpx;
}

.indicator-label {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.indicator-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.option-item {
  padding: 10rpx 24rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-chip);
  font-size: 24rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.option-item.option-checked {
  border-color: var(--primary);
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 500;
}

.option-item.option-readonly {
  pointer-events: none;
}

.option-score {
  font-size: 20rpx;
  color: var(--text-hint);
}

.option-checked .option-score {
  color: var(--primary);
  font-weight: bold;
}

/* 表单操作栏 */
.form-actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--bg-card);
  border-top: 1rpx solid var(--border);
  z-index: 10;
}

.form-actions .btn-outline,
.form-actions .btn-primary {
  flex: 1;
  font-size: 28rpx;
}

/* ==============================
   分数滑块弹窗
   ============================== */

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-card {
  background: var(--bg-card);
  border-radius: var(--radius-ctrl);
  padding: 32rpx;
  width: 80vw;
  max-width: 560rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
}

.slider-wrapper {
  padding: 16rpx 0;
}

.slider-value {
  text-align: center;
  font-size: 72rpx;
  font-weight: bold;
  color: var(--primary);
  display: block;
  margin-bottom: 16rpx;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--text-hint);
}

.modal-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.modal-buttons .btn-outline,
.modal-buttons .btn-primary {
  flex: 1;
}

/* ==============================
   批量结果
   ============================== */

.batch-results {
  max-height: 400rpx;
  margin-top: 12rpx;
}

.result-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
  font-size: 24rpx;
}

.result-icon {
  font-size: 28rpx;
}

.result-name {
  flex: 1;
}

.result-error {
  color: var(--danger);
  font-size: 20rpx;
}

/* ==============================
   公共
   ============================== */

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-hint);
}

.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-state .text {
  font-size: 28rpx;
}

.btn-primary {
  display: block;
  padding: 20rpx;
  background: var(--primary);
  color: var(--bg-card);
  border-radius: var(--radius-ctrl);
  box-shadow: var(--shadow-card);
  font-size: 28rpx;
  text-align: center;
  border: none;
}

.btn-outline {
  display: block;
  padding: 20rpx;
  background: var(--bg-card);
  color: var(--primary);
  border: 2rpx solid var(--primary-line);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  text-align: center;
}

/* ============================================================
   V2 视觉升级 — 评教页
   ============================================================ */
.batch-card, .course-card, .indicator-card {
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* 选项胶囊选中渐变 */
.option-item {
  border-radius: var(--radius-card);
  transition: all 0.12s;
}
.option-item.option-checked {
  background: var(--primary);
  color: var(--bg-card);
  border-color: transparent;
  box-shadow: var(--shadow-card);
}
.option-checked .option-score { color: var(--bg-card); }


/* ============================================================
   V3 视觉升级 — 评教页头部 Hero
   ============================================================ */
.top-bar {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary) 60%, var(--primary) 100%);
  color: var(--bg-card);
}
.top-bar .refresh-btn {
  background: var(--bg-card);
  color: var(--primary);
  border-radius: var(--radius-card);
  padding: 8rpx 24rpx;
  box-shadow: var(--shadow-card);
}
.summary-bar {
  background: var(--bg-card);
  border-radius: 0 0 var(--radius-card) var(--radius-card);
  box-shadow: var(--shadow-card);
  z-index: 10;
}
.summary-bar .batch-btn {
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: var(--radius-card);
  padding: 6rpx 20rpx;
}


/* ============================================================
   V4 简约风格 — 评教页
   ============================================================ */
.top-bar {
  background: var(--bg-card);
  color: var(--text-secondary);
  border-bottom: 1rpx solid var(--line);
}
.top-bar .refresh-btn, .summary-bar .batch-btn {
  background: var(--primary-soft);
  color: var(--primary);
  box-shadow: var(--shadow-card);
}
.summary-bar {
  box-shadow: var(--shadow-card);
  border-bottom: 1rpx solid var(--line);
}

.batch-card, .course-card, .indicator-card {
  box-shadow: var(--shadow-card);
}

/* 选中选项: 浅蓝底 + 主色字 */
.option-item.option-checked {
  background: var(--primary-soft);
  color: var(--primary);
  border-color: var(--primary);
  box-shadow: var(--shadow-card);
}
.option-checked .option-score { color: var(--primary); }


/* ============================================================
   V6 桌面端同款 — 评教页
   ============================================================ */
.batch-card, .course-card, .indicator-card {
  background: var(--bg-card);
  border-radius: var(--radius-ctrl);
  box-shadow: var(--shadow-card);
}
/* 选项胶囊 → 桌面 .option-item: 白底描边圆角 */
.option-item {
  background: var(--bg-card);
  border: var(--bw-ctrl) solid var(--line-strong);
  color: var(--text-primary);
  border-radius: var(--radius-card);
}
.option-item.option-checked {
  background: var(--primary);
  border-color: var(--primary);
  color: var(--bg-card);
  box-shadow: var(--shadow-card);
}
.option-checked .option-score { color: var(--bg-card); }

/* ============================================================
   V7 风格统一 — 评教页对齐全局卡片规范(白底细描边)
   ============================================================ */
.batch-card, .course-card, .indicator-card {
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* 批次学期标签 */
.sem-tag {
  display: inline-block;
  font-size: 20rpx;
  color: var(--primary-dark);
  background: var(--primary-soft);
  border-radius: var(--radius-chip);
  padding: 2rpx 12rpx;
  margin-right: 8rpx;
}

/* ============================================================
   风格统一 — 对齐课表(卡片加细边框)
   ============================================================ */
.batch-card, .course-card, .indicator-card {
  border: var(--bw-card) solid var(--line);
}

/* 批次信息: 学期标签 + 日期一行 */
.bi-dates {
  font-size: 23rpx;
  color: var(--text-hint);
}

/* 组件根/滚动区 */
.view-root { height: 100%; box-sizing: border-box; }
.view-scroll { height: 100%; }

/* 宿主节点高度(swiper-item 内撑满, 保证内部 100% 高度链有效) */
:host {
  display: block;
  height: 100%;
}
