/* ==========================================================================
   教学评价（eval-view）
   --------------------------------------------------------------------------
   · 表面材质统一来自 styles/design-system.wxss：
     .card / .batch-card / .course-card / .indicator-card / .modal-buttons
   · 按钮统一由基座 .btn-primary / .btn-outline 提供，页面只覆盖 TDesign 尺寸
   · 本文件只负责布局、层级、状态与间距；颜色 / 圆角 / 阴影 / 动效一律引用令牌
   · 状态：已完成 --success、待处理/已保存 --warning、进行中 --primary；
     无渐变、无装饰圆、普通卡片无投影
   · 按压反馈由基座 .tap 提供；TDesign 弹层只使用组件自身的一套过渡
   ========================================================================== */

.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  background: var(--bg-page);
}

.view-root {
  height: 100%;
  box-sizing: border-box;
}

.view-scroll {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
}

:host {
  display: block;
  height: 100%;
}

/* 三个滚动区共享高度链；长列表连续滚动，不做逐项入场动画 */
.batch-scroll,
.course-scroll,
.form-scroll {
  flex: 1;
  min-height: 0;
  -webkit-overflow-scrolling: touch;
}

.course-scroll {
  padding-bottom: var(--space-lg);
}

.form-scroll {
  padding: var(--space-xs) 0;
}

/* ==========================================================================
   批次列表
   ========================================================================== */

.batch-card {
  margin: var(--space-sm) var(--space-page);
  padding: var(--space-md) var(--space-lg);
}

.batch-card.batch-urgent {
  border-left: 4rpx solid var(--warning);
}

.batch-card.batch-warning {
  border-left: 4rpx solid var(--warning-light);
}

.batch-card.batch-done .batch-title {
  color: var(--text-secondary);
}

.batch-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs);
}

.batch-title {
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: 1.4;
  word-break: break-word;
}

.batch-info {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-xs) var(--space-sm);
  color: var(--text-muted);
  font-size: var(--fs-sub);
  line-height: 1.5;
}

.tag {
  flex: none;
  font-weight: 600;
}

/* 状态徽标：已完成用成功色，待处理用提醒色；文字本身已说明状态 */
.tag.tag-done {
  background: var(--success-soft);
  color: var(--success);
}

.tag.tag-pending {
  background: var(--bg-sunken);
  color: var(--text-muted);
}

.tag.tag-urgent {
  background: var(--warning-soft);
  color: var(--warning);
}

.sem-tag {
  display: inline-block;
  padding: var(--space-xxs) var(--space-sm);
  border-radius: var(--radius-chip);
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: var(--fs-cap);
  line-height: 1.5;
}

.bi-dates {
  color: var(--text-muted);
  font-size: var(--fs-sub);
  line-height: 1.5;
}

/* ==========================================================================
   顶部操作条 / 返回 / 一键评教
   ========================================================================== */

.summary-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  min-height: 96rpx;
  padding: 0 var(--space-page);
  border-bottom: 1rpx solid var(--line);
  background: var(--bg-card);
  color: var(--text-muted);
  font-size: var(--fs-sub);
  border: none;
  border-radius: var(--radius-island);
  box-shadow: var(--shadow-island);
}

.sub-link {
  display: inline-flex;
  flex: none;
  align-items: center;
  gap: var(--space-xs);
  min-height: 88rpx;
  color: var(--primary);
  font-size: var(--fs-sub);
  font-weight: 600;
}

.icon-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
}

.batch-btn {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 var(--space-lg);
  border-radius: var(--radius-control);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--fs-sub);
  font-weight: 600;
}

/* 表单页返回条：课程名与批次列表的课程名同一层级 */
.form-course-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ==========================================================================
   批次课程列表
   ========================================================================== */

.course-card {
  margin: var(--space-sm) var(--space-page);
  padding: var(--space-md) var(--space-lg);
}

.course-card.course-saved {
  border-left: 4rpx solid var(--warning);
}

.course-card.course-done .course-name {
  color: var(--text-secondary);
}

.course-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-md);
}

.course-main {
  flex: 1;
  min-width: 0;
}

.course-name {
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.4;
  word-break: break-word;
}

.course-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs) var(--space-md);
  margin-top: var(--space-xs);
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.4;
}

.course-status {
  flex: none;
  padding: var(--space-xxs) var(--space-sm);
  border-radius: var(--radius-chip);
  background: var(--bg-sunken);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  font-weight: 600;
  line-height: 1.5;
}

.course-status.done {
  background: var(--success-soft);
  color: var(--success);
}

.course-status.saved {
  background: var(--warning-soft);
  color: var(--warning);
}

.course-status.pending {
  background: var(--bg-sunken);
  color: var(--text-secondary);
}

.course-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

/* TDesign 小按钮尺寸覆盖（外部类覆盖组件内部尺寸，沿用 !important） */
.small-btn {
  padding: 0 var(--space-lg) !important;
  font-size: var(--fs-sub) !important;
}

.view-btn {
  color: var(--primary) !important;
  border-color: var(--primary) !important;
}

/* ==========================================================================
   评价表单
   ========================================================================== */

.readonly-banner {
  margin: var(--space-sm) var(--space-page);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-control);
  background: var(--bg-sunken);
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.5;
  text-align: center;
}

.autofill-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-xs);
  margin: var(--space-xs) var(--space-page) var(--space-xxs);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-control);
  background: var(--bg-sunken);
}

.autofill-label {
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  white-space: nowrap;
}

.autofill-input {
  width: 96rpx;
  height: 56rpx;
  padding: 0 var(--space-xs);
  border: var(--bw-ctrl) solid var(--line-strong);
  border-radius: var(--radius-chip);
  background: var(--bg-card);
  color: var(--text-primary);
  font-size: var(--fs-sub);
  text-align: center;
}

.autofill-hint {
  color: var(--text-hint);
  font-size: var(--fs-cap);
}

.autofill-btn {
  padding: 0 var(--space-md) !important;
  font-size: var(--fs-cap) !important;
}

.live-score {
  margin-left: auto;
  color: var(--text-muted);
  font-size: var(--fs-sub);
}

.live-score-num {
  color: var(--primary);
  font-family: var(--font-num);
  font-size: var(--fs-body);
  font-weight: 700;
}

.indicator-card {
  margin: var(--space-sm) var(--space-page);
  padding: var(--space-md) var(--space-lg);
}

.indicator-label {
  margin-bottom: var(--space-sm);
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.4;
}

.indicator-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

/* 选项胶囊：控件圆角 12rpx；按压的缩放/明暗由基座 .tap 统一提供 */
.option-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  min-height: 72rpx;
  padding: var(--space-xs) var(--space-lg);
  border: var(--bw-ctrl) solid var(--line-strong);
  border-radius: var(--radius-control);
  background: var(--bg-card);
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.4;
}

.option-item.option-checked {
  border-color: var(--primary);
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}

.option-item.option-readonly {
  pointer-events: none;
}

.option-score {
  color: var(--text-hint);
  font-size: var(--fs-cap);
  line-height: 1.4;
}

.option-item.option-checked .option-score {
  color: var(--primary);
  font-weight: 600;
}

/* 底部操作栏：保存 / 提交由 TDesign 组件承载，行为不变，只统一尺寸 */
.form-actions {
  display: flex;
  gap: var(--space-md);
  padding: var(--space-md) var(--space-page);
  border-top: 1rpx solid var(--line);
  background: var(--bg-card);
}

.form-actions .btn-primary,
.form-actions .btn-outline {
  flex: 1;
  font-size: 30rpx !important;
}

/* ==========================================================================
   一键评教弹窗（TDesign dialog；过渡只由组件自身负责）
   ========================================================================== */

.batch-dialog {
  --td-dialog-width: calc(100vw - 96rpx);
}

.batch-dialog-content {
  width: 100%;
}

.slider-wrapper {
  padding: var(--space-md) 0;
}

.slider-value {
  display: block;
  margin-bottom: var(--space-md);
  color: var(--primary);
  font-family: var(--font-num);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  color: var(--text-hint);
  font-size: var(--fs-cap);
}

/* 弹窗底部按钮容器由基座 .modal-buttons 提供；这里只让 TDesign 按钮等宽 */
.modal-buttons .btn-primary,
.modal-buttons .btn-outline {
  flex: 1;
  font-size: 30rpx !important;
}

/* ==========================================================================
   批量评教进度结果
   ========================================================================== */

.batch-results {
  max-height: 400rpx;
  margin-top: var(--space-sm);
}

.result-item {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-xs) 0;
  color: var(--text-secondary);
  font-size: var(--fs-sub);
  line-height: 1.4;
}

.result-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
}

.result-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 失败原因：颜色 + 文字同时表达，不只手靠颜色 */
.result-error {
  flex: none;
  max-width: 40%;
  overflow: hidden;
  color: var(--danger);
  font-size: var(--fs-cap);
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 页面内不定义独立动效（按压走 .tap、弹层走 TDesign）；
   保留减少动效兜底，避免将来新增过渡时漏配 */
@media (prefers-reduced-motion: reduce) {
  .batch-card,
  .course-card,
  .indicator-card,
  .option-item,
  .summary-bar {
    animation-duration: .01ms;
    transition-duration: .01ms;
  }
}
