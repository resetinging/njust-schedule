<!-- 学分进度视图 —— 培养方案(应修) × 成绩(已修, 按课程代码匹配) -->
<view class="container view-root">
  <scroll-view class="view-scroll" scroll-y>

    <!-- 没有培养方案数据(未预抓成功/研究生) -->
    <empty-state wx:if="{{!loading && empty}}"
                 icon="📊"
                 title="{{errorMsg || '暂无培养方案数据'}}"
                 desc="登录后自动获取"
                 action-text="{{refreshing ? '获取中…' : '获取培养方案'}}"
                 bind:action="onRefresh" />

    <block wx:if="{{!loading && !empty}}">
      <!-- 总进度 -->
      <view class="credit-hero">
        <view class="credit-hero-top">
          <view class="credit-hero-main">
            <text class="credit-hero-value">{{view.totalEarned}}</text>
            <text class="credit-hero-total">/ {{view.totalRequired}}</text>
            <text class="credit-hero-label">已修学分</text>
          </view>
          <view class="credit-refresh tap {{refreshing ? 'spin' : ''}}" bindtap="onRefresh">
            <icon name="refresh" size="34" color="#2563EB" />
          </view>
        </view>

        <view class="cr-bar"><view class="cr-bar-in" style="width: {{view.totalPercent}}%"></view></view>

        <view class="credit-metrics">
          <view class="credit-metric">
            <text class="credit-metric-value">{{view.totalPercent}}%</text>
            <text class="credit-metric-label">完成</text>
          </view>
          <view class="credit-metric">
            <text class="credit-metric-value">{{view.planCount}}</text>
            <text class="credit-metric-label">计划课程</text>
          </view>
          <view class="credit-metric {{view.failed.count > 0 ? 'is-warn' : ''}}">
            <text class="credit-metric-value">{{view.failed.count}}</text>
            <text class="credit-metric-label">未通过</text>
          </view>
        </view>
      </view>

      <!-- 分类别进度 -->
      <view class="credit-card">
        <view class="credit-section-head">
          <text class="credit-section-title">分类进度</text>
          <text class="credit-section-count">{{view.rows.length}} 类</text>
        </view>
        <view class="cr-row" wx:for="{{view.rows}}" wx:key="name">
          <view class="cr-row-top">
            <text class="cr-name">{{item.name}}</text>
            <view class="cr-value-wrap">
              <text class="cr-val">{{item.earned}} / {{item.required}}</text>
              <text class="cr-unit">学分</text>
            </view>
          </view>
          <view class="cr-bar"><view class="cr-bar-in" style="width: {{item.percent}}%"></view></view>
          <view class="cr-row-foot">
            <text>{{item.done}} / {{item.total}} 门</text>
            <text>{{item.percent}}%</text>
          </view>
        </view>
      </view>

      <!-- 未通过(已开课, 按学期, 可折叠) -->
      <view class="credit-card" wx:if="{{view.failed.count > 0}}">
        <view class="cr-head tap" bindtap="onToggleExpand">
          <view class="cr-head-main">
            <text class="cr-title">未通过</text>
            <text class="cr-count">{{view.failed.count}} 门 · {{view.failed.credits}} 学分</text>
          </view>
          <view class="cr-arrow"><icon name="{{expanded ? 'prev' : 'next'}}" size="24" color="#64748B" /></view>
        </view>
        <block wx:if="{{expanded}}">
          <view class="cr-sem" wx:for="{{view.failed.groups}}" wx:key="semester">
            <text class="cr-sem-name">{{item.semester}} · {{item.count}} 门</text>
            <view class="cr-course" wx:for="{{item.courses}}" wx:for-item="c" wx:key="code">
              <text class="cr-c-name">{{c.name}}</text>
              <text class="cr-c-meta">{{c.credit}} 学分</text>
            </view>
          </view>
        </block>
      </view>

      <!-- 本学期在读(尚未出成绩) -->
      <view class="credit-card" wx:if="{{view.current.count > 0}}">
        <view class="cr-head tap" bindtap="onToggleCurrent">
          <view class="cr-head-main">
            <text class="cr-title">本学期</text>
            <text class="cr-count">{{view.current.count}} 门 · {{view.current.credits}} 学分</text>
          </view>
          <view class="cr-arrow"><icon name="{{expandedCurrent ? 'prev' : 'next'}}" size="24" color="#64748B" /></view>
        </view>
        <block wx:if="{{expandedCurrent}}">
          <view class="cr-sem" wx:for="{{view.current.groups}}" wx:key="semester">
            <text class="cr-sem-name">{{item.semester}} · {{item.count}} 门</text>
            <view class="cr-course" wx:for="{{item.courses}}" wx:for-item="c" wx:key="code">
              <text class="cr-c-name">{{c.name}}</text>
              <text class="cr-c-meta">{{c.credit}} 学分</text>
            </view>
          </view>
        </block>
      </view>

      <!-- 后续学期未开课(计划内, 正常现象) -->
      <view class="credit-card" wx:if="{{view.upcoming.count > 0}}">
        <view class="cr-head tap" bindtap="onToggleUpcoming">
          <view class="cr-head-main">
            <text class="cr-title">后续学期</text>
            <text class="cr-count">{{view.upcoming.count}} 门 · {{view.upcoming.credits}} 学分</text>
          </view>
          <view class="cr-arrow"><icon name="{{expandedUpcoming ? 'prev' : 'next'}}" size="24" color="#64748B" /></view>
        </view>
        <block wx:if="{{expandedUpcoming}}">
          <view class="cr-sem" wx:for="{{view.upcoming.groups}}" wx:key="semester">
            <text class="cr-sem-name">{{item.semester}} · {{item.count}} 门</text>
            <view class="cr-course" wx:for="{{item.courses}}" wx:for-item="c" wx:key="code">
              <text class="cr-c-name">{{c.name}}</text>
              <text class="cr-c-meta">{{c.credit}} 学分</text>
            </view>
          </view>
        </block>
      </view>

      <view class="credit-foot" wx:if="{{view.unplannedCount > 0 || view.alternativesCount > 0}}">
        <text class="credit-chip" wx:if="{{view.unplannedCount > 0}}">计划外 {{view.unplannedCount}} 门</text>
        <text class="credit-chip" wx:if="{{view.alternativesCount > 0}}">同组未选 {{view.alternativesCount}} 门</text>
      </view>
      <text class="credit-updated" wx:if="{{updated}}">{{updated}}</text>
      <view id="slot-credit-bottom" class="analytics-slot-marker"></view>
    </block>

  </scroll-view>
</view>
