<!-- 学分进度视图 —— 培养方案(应修) × 成绩(已修, 按课程代码匹配) -->
<view class="container view-root">
  <scroll-view class="view-scroll" scroll-y>

    <!-- 没有培养方案数据(未预抓成功/研究生) -->
    <empty-state wx:if="{{!loading && empty}}"
                 icon="📊"
                 title="{{errorMsg || '暂无培养方案数据'}}"
                 desc="登录后会自动获取；也可以手动拉取一次"
                 action-text="{{refreshing ? '获取中…' : '获取培养方案'}}"
                 bind:action="onRefresh" />

    <block wx:if="{{!loading && !empty}}">
      <!-- 总进度 -->
      <view class="cr-hero">
        <view class="cr-hero-top">
          <view class="cr-hero-num">
            <text class="cr-hero-value">{{view.totalEarned}}</text>
            <text class="cr-hero-label">已修学分 · 计划 {{view.totalRequired}} 学分 · 完成 {{view.totalPercent}}%</text>
          </view>
          <view class="cr-hero-refresh tap {{refreshing ? 'spin' : ''}}" bindtap="onRefresh">
            <icon name="refresh" size="34" color="#2563EB" />
          </view>
        </view>
        <view class="cr-bar"><view class="cr-bar-in" style="width: {{view.totalPercent}}%"></view></view>
        <text class="cr-hero-sub">共 {{view.planCount}} 门计划课程 · 未通过 {{view.failed.count}} 门 · 本学期 {{view.current.count}} 门 · 后续未开课 {{view.upcoming.count}} 门</text>
      </view>

      <!-- 分类别进度 -->
      <view class="card">
        <view class="cr-row" wx:for="{{view.rows}}" wx:key="name">
          <view class="cr-row-top">
            <text class="cr-name">{{item.name}}</text>
            <text class="cr-val">{{item.earned}} / {{item.required}} 学分 · {{item.done}}/{{item.total}} 门</text>
          </view>
          <view class="cr-bar"><view class="cr-bar-in" style="width: {{item.percent}}%"></view></view>
        </view>
      </view>

      <!-- 未通过(已开课, 按学期, 可折叠) -->
      <view class="card" wx:if="{{view.failed.count > 0}}">
        <view class="cr-head tap" bindtap="onToggleExpand">
          <text class="cr-title">未通过（{{view.failed.count}} 门 / {{view.failed.credits}} 学分）</text>
          <text class="cr-toggle">{{expanded ? '收起' : '展开'}}</text>
        </view>
        <block wx:if="{{expanded}}">
          <view class="cr-sem" wx:for="{{view.failed.groups}}" wx:key="semester">
            <text class="cr-sem-name">{{item.semester}} · {{item.count}} 门 / {{item.credits}} 学分</text>
            <view class="cr-course" wx:for="{{item.courses}}" wx:for-item="c" wx:key="code">
              <text class="cr-c-name">{{c.name}}</text>
              <text class="cr-c-meta">{{c.code}} · {{c.credit}} 学分</text>
            </view>
          </view>
        </block>
      </view>

      <!-- 本学期在读(尚未出成绩) -->
      <view class="card" wx:if="{{view.current.count > 0}}">
        <view class="cr-head tap" bindtap="onToggleCurrent">
          <text class="cr-title">本学期课程（{{view.current.count}} 门 / {{view.current.credits}} 学分）</text>
          <text class="cr-toggle">{{expandedCurrent ? '收起' : '展开'}}</text>
        </view>
        <block wx:if="{{expandedCurrent}}">
          <view class="cr-sem" wx:for="{{view.current.groups}}" wx:key="semester">
            <text class="cr-sem-name">{{item.semester}} · {{item.count}} 门 / {{item.credits}} 学分</text>
            <view class="cr-course" wx:for="{{item.courses}}" wx:for-item="c" wx:key="code">
              <text class="cr-c-name">{{c.name}}</text>
              <text class="cr-c-meta">{{c.code}} · {{c.credit}} 学分</text>
            </view>
          </view>
        </block>
      </view>

      <!-- 后续学期未开课(计划内, 正常现象) -->
      <view class="card" wx:if="{{view.upcoming.count > 0}}">
        <view class="cr-head tap" bindtap="onToggleUpcoming">
          <text class="cr-title">后续学期未开课（{{view.upcoming.count}} 门 / {{view.upcoming.credits}} 学分）</text>
          <text class="cr-toggle">{{expandedUpcoming ? '收起' : '展开'}}</text>
        </view>
        <block wx:if="{{expandedUpcoming}}">
          <view class="cr-sem" wx:for="{{view.upcoming.groups}}" wx:key="semester">
            <text class="cr-sem-name">{{item.semester}} · {{item.count}} 门 / {{item.credits}} 学分</text>
            <view class="cr-course" wx:for="{{item.courses}}" wx:for-item="c" wx:key="code">
              <text class="cr-c-name">{{c.name}}</text>
              <text class="cr-c-meta">{{c.code}} · {{c.credit}} 学分</text>
            </view>
          </view>
        </block>
      </view>

      <view class="cr-note" wx:if="{{view.unplannedCount > 0}}">
        另有计划外已修 {{view.unplannedCount}} 门 / {{view.unplannedCredits}} 学分（不计入进度，如多修选修）
      </view>
      <view class="cr-note" wx:if="{{view.alternativesCount > 0}}">
        同组选修另有 {{view.alternativesCount}} 门未选（{{view.alternativesCredits}} 学分，如"专用英语-XXX"系列），不计入未通过
      </view>
      <view class="cr-note">
        数据来源：教务专业培养方案 × 已修成绩（按课程代码匹配，以教务为准）{{updated ? ' · 更新于 ' + updated : ''}}
      </view>
    </block>

  </scroll-view>
</view>
