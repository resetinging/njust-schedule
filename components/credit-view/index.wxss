/* ==========================================================================
   学分进度视图（培养方案应修 × 成绩已修）
   --------------------------------------------------------------------------
   · 颜色 / 圆角 / 间距 / 阴影 / 动效全部取 styles/design-system.wxss 的令牌
   · 进度摘要与分类进度共用白底细边的分组表面；未通过 / 在读 / 后续学期
     是次级明细，用留白 + 分隔线组织，不做卡片套卡片，也不逐分区浮动卡片
   · 进度条统一语义色：已完成进度用 --success，未通过计数用 --danger
   · 按压反馈交给基座 .tap；本地无整卡入场动画，无装饰圆、无投影
   ========================================================================== */

/* ==========================================================================
   1. 结构与高度链（宿主 → scroll-view，保证 swiper-item 内可滚动）
   ========================================================================== */

:host {
  display: block;
  height: 100%;
}

.view-root {
  height: 100%;
  box-sizing: border-box;
}

.view-scroll {
  height: 100%;
  min-height: 0;
  -webkit-overflow-scrolling: touch;
}

.container {
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
}

/* ==========================================================================
   2. 总进度摘要：整页唯一的大数字焦点
   ========================================================================== */

.credit-hero {
  margin: var(--space-md) var(--space-page) var(--space-lg);
  padding: var(--space-lg);
  background: var(--bg-card);
  border: none;
  border-radius: var(--radius-island);
  box-shadow: var(--shadow-island);
}

.credit-hero-top {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
}

.credit-hero-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.credit-hero-value {
  color: var(--text-primary);
  font-family: var(--font-num);
  font-size: 72rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.05;
}

.credit-hero-total {
  margin-left: var(--space-xs);
  color: var(--text-secondary);
  font-family: var(--font-num);
  font-size: 32rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.credit-hero-label {
  width: 100%;
  margin-top: var(--space-xxs);
  color: var(--text-muted);
  font-size: var(--fs-sub);
}

/* 刷新：非圆形图标按钮，热区 88rpx（约 44 物理像素） */


/* 进度条：纯色语义，轨道用中性边线色；宽度变化不做位移动画 */
.cr-bar {
  height: 8rpx;
  margin-top: var(--space-md);
  overflow: hidden;
  border-radius: var(--radius-pill);
  background: var(--line);
}

.cr-bar-in {
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--success);
}

/* 摘要指标：分组表面内部用分隔线分列，不再逐格套小卡片 */
.credit-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: var(--space-md);
  overflow: hidden;
}

.credit-metric {
  min-width: 0;
  padding: var(--space-sm) var(--space-xs);
  text-align: center;
  border: none;
  border-radius: 0;
  background: transparent;
}

.credit-metric + .credit-metric {
  border-left: 1rpx solid var(--line-soft);
}

.credit-metric-value {
  display: block;
  overflow: hidden;
  color: var(--text-primary);
  font-family: var(--font-num);
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.credit-metric-label {
  display: block;
  margin-top: var(--space-xxs);
  color: var(--text-muted);
  font-size: var(--fs-cap);
}

/* 完成度与进度条共用成功色，未通过计数用危险色（不只靠颜色，另有文字标签） */
.credit-metrics .credit-metric:first-child .credit-metric-value {
  color: var(--success);
}

.credit-metric.is-warn .credit-metric-value {
  color: var(--danger);
}

/* ==========================================================================
   3. 分类进度：与摘要同级的白底分组表面，行间用分隔线
   ========================================================================== */

.credit-card {
  margin: 0 var(--space-page) var(--space-lg);
  padding: var(--space-sm) var(--space-lg) var(--space-xs);
  background: var(--bg-card);
  border: none;
  border-radius: var(--radius-island);
  box-shadow: var(--shadow-island);
}

/* 未通过 / 本学期 / 后续学期：次级明细不做卡片，用留白 + 顶部分隔线 */
.credit-card + .credit-card {
  margin-top: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-top: 1rpx solid var(--line);
  border-radius: 0;
}

.credit-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  min-height: 72rpx;
  padding: var(--space-xs) 0 var(--space-sm);
  border-bottom: 1rpx solid var(--line-soft);
}

.credit-section-title,
.cr-title {
  color: var(--text-primary);
  font-size: var(--fs-section);
  font-weight: 700;
  line-height: 1.4;
}

.credit-section-count,
.cr-count {
  color: var(--text-muted);
  font-size: var(--fs-cap);
  font-variant-numeric: tabular-nums;
}

.cr-count {
  display: block;
  margin-top: var(--space-xxs);
}

/* 分类行：名称可换行，数值列等宽右对齐 */
.cr-row {
  padding: var(--space-md) 0;
  border-top: 1rpx solid var(--line-soft);
}

.credit-section-head + .cr-row {
  border-top: 0;
}

.cr-row .cr-bar {
  margin-top: var(--space-xs);
}

.cr-row-top,
.cr-row-foot {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-md);
}

.cr-name {
  flex: 1;
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.cr-value-wrap {
  display: flex;
  align-items: baseline;
  flex: none;
}

.cr-val {
  color: var(--text-primary);
  font-family: var(--font-num);
  font-size: var(--fs-body);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.cr-unit {
  margin-left: var(--space-xxs);
  color: var(--text-muted);
  font-size: var(--fs-cap);
}

.cr-row-foot {
  align-items: center;
  margin-top: var(--space-xs);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  font-variant-numeric: tabular-nums;
}

/* ==========================================================================
   4. 折叠明细分区：整行可点，热区 ≥88rpx
   ========================================================================== */

.cr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  min-height: 88rpx;
  padding: var(--space-xs) 0;
  border-bottom: 1rpx solid var(--line);
}

.cr-head-main {
  flex: 1;
  min-width: 0;
}

/* 展开/收起指示：随整行点击，不单独计热区 */
.cr-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex: none;
}

/* 按学期分组的小标题 + 课程明细行 */
.cr-sem {
  margin-top: var(--space-sm);
  padding-top: var(--space-xs);
}

.cr-sem + .cr-sem {
  margin-top: var(--space-sm);
  border-top: 1rpx solid var(--line-soft);
}

.cr-sem-name {
  display: block;
  padding-bottom: var(--space-xxs);
  color: var(--text-muted);
  font-size: var(--fs-cap);
}

.cr-course {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-md);
  padding: var(--space-xs) 0;
}

.cr-course + .cr-course {
  border-top: 1rpx solid var(--line-soft);
}

.cr-c-name {
  flex: 1;
  min-width: 0;
  color: var(--text-primary);
  font-size: var(--fs-sub);
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.cr-c-meta {
  flex: none;
  color: var(--text-muted);
  font-size: var(--fs-cap);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* ==========================================================================
   5. 页脚提示：计划外 / 同组未选标签与更新时间
   ========================================================================== */

.credit-foot {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin: var(--space-md) var(--space-page) 0;
}

.credit-chip {
  padding: var(--space-xxs) var(--space-sm);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-chip);
  background: var(--bg-card);
  color: var(--text-muted);
  font-size: var(--fs-cap);
  font-variant-numeric: tabular-nums;
}

.credit-updated {
  display: block;
  margin: var(--space-sm) var(--space-page) 0;
  color: var(--text-muted);
  font-size: var(--fs-cap);
  text-align: right;
}

/* 本组件无本地入场动画与过渡：按压反馈由基座 .tap 统一处理。
   减少动态效果时停止刷新图标的旋转（其余状态切换均为瞬时）。 */
@media (prefers-reduced-motion: reduce) {
  .spin {
    animation: none !important;
  }
}
