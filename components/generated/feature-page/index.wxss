:host {
  --primary: #3157D5;
  --primary-light: #5D79E0;
  --primary-strong: #2544B5;
  --primary-soft: #EEF2FF;
  --primary-line: #D8E0FA;
  --bg-page: #F2F4F7;
  --bg-card: #FFFFFF;
  --bg-sunken: #EDF0F4;
  --bg-hover: #EEF1F5;
  --line: #E4E7EB;
  --line-soft: #EEF0F3;
  --text-primary: #20262D;
  --text-secondary: #59636F;
  --text-muted: #6B7684;
  --text-hint: #9AA4B0;
  --signal: #A66A0B;
  --signal-soft: #FDF4E6;
  --success: #247B68;
  --success-soft: #E9F4F1;
  --danger: #B84750;
  --danger-soft: #FBEEEF;
  --radius-chip: 8rpx;
  --radius-control: 16rpx;
  --radius-island: 32rpx;
  --radius-group: 24rpx;
  --radius-card: 32rpx;
  --radius-panel: 24rpx;
  --radius-sheet: 36rpx;
  --shadow-island: 0 6rpx 20rpx rgba(20,28,36,.035);
  --shadow-nav: 0 8rpx 28rpx rgba(20,28,36,.08);
  --space-page: 24rpx;
  --space-section: 24rpx;
  --space-island: 24rpx;
  --motion-fast: 120ms;
  --motion-base: 200ms;
  --motion-slow: 260ms;
  --ease-standard: cubic-bezier(.2,.7,.3,1);
  --ease-bounce: cubic-bezier(.22,1.2,.36,1);
  --shadow-pop: 0 12rpx 40rpx rgba(20,28,36,.16);
  display: block;
  min-height: 100vh;
  background: var(--bg-page);
  color: var(--text-primary);
}
.ui-page { display: flex; flex-direction: column; min-height: 100vh; padding: 24rpx 24rpx 140rpx; }
.ui-surface-page { background: var(--bg-page); }
.ui-hero-summary { display: grid; grid-template-columns: 64rpx 1fr auto; gap: var(--space-md); align-items: center; margin-bottom: var(--space-lg); padding: 20rpx; border: var(--bw-card) solid var(--line); border-radius: var(--radius-card); background: var(--bg-card); }
.ui-hero-badge { display: grid; place-items: center; width: 64rpx; height: 64rpx; border-radius: var(--radius-control); color: var(--primary); background: var(--primary-soft); font-size: 22rpx; font-weight: 700; }
.ui-hero-label { font-size: 28rpx; font-weight: 650; }
.ui-hero-meta { margin-top: 5rpx; color: var(--text-muted); font-size: 22rpx; }
.ui-hero-time { color: var(--signal); font-family: var(--font-num); font-size: 24rpx; font-weight: 650; }
.ui-section { margin: 0 0 20rpx; }
.ui-section-title { margin: 0 0 12rpx 4rpx; color: var(--text-muted); font-size: 22rpx; font-weight: 600; }
.ui-grid { display: grid; gap: var(--space-md); }
.ui-grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.ui-grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.ui-action-card { min-height: 144rpx; padding: 20rpx; border: var(--bw-card) solid var(--line); border-radius: var(--radius-card); background: var(--bg-card); }
.ui-action-card-icon { display: grid; place-items: center; width: 64rpx; height: 64rpx; margin-bottom: var(--space-sm); border-radius: var(--radius-control); background: var(--primary-soft); }
.ui-action-card-title { font-size: 27rpx; font-weight: 600; }
.ui-tone-violet .ui-action-card-icon { background: var(--violet-soft); }
.ui-tone-signal .ui-action-card-icon { background: var(--signal-soft); }
.ui-tone-success .ui-action-card-icon { background: var(--success-soft); }
.ui-tabbar { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; margin-top: auto; padding: 12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom)); border: var(--bw-card) solid var(--line); border-radius: var(--radius-sheet); background: var(--nav-bg); -webkit-backdrop-filter: blur(20rpx) saturate(140%); backdrop-filter: blur(20rpx) saturate(140%); }
.ui-tab { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; min-height: 88rpx; color: var(--text-muted); font-size: 19rpx; }
.ui-tab.is-on { color: var(--primary); font-weight: 650; }
